// TrueLine Finishes: static-assets-only Cloudflare Worker (no Worker script, no D1, no email:
// the quote form is the Formlane direct embed, which posts straight to api.formlane.uk).
// Preview URL first: site-truelinefinishes.small-bird-3273.workers.dev (noindexed by public/_headers).
// The real domain (www.truelinefinishes.com, apex 301 -> www) is attached at launch when GoDaddy DNS
// is handed over; Custom Domains are attached in Cloudflare, not declared here, so a deploy never
// touches DNS. Always deploy through `npm run deploy` (scripts/deploy-guard.mjs).
{
  "name": "site-truelinefinishes",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": true
}
