{
  "name": "site-truelinefinishes",
  "type": "module",
  "version": "1.1.0",
  "private": true,
  "description": "TrueLine Finishes (truelinefinishes.com): client site on the Buildings for Life v4 template structure, TrueLine's own brand. Static Astro build served by a Cloudflare Worker (static assets only); quote form via Formlane direct embed.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "images": "node scripts/images.mjs /root/work/tl-media",
    "brand": "node scripts/brand.mjs",
    "articles:import": "node scripts/import-articles.mjs",
    "audit": "node scripts/audit.mjs",
    "check": "node scripts/check.mjs",
    "gate": "node scripts/token-gate.mjs",
    "deploy:dry": "node scripts/deploy-guard.mjs && wrangler deploy --dry-run",
    "deploy": "node scripts/deploy-guard.mjs && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.3",
    "cheerio": "^1.2.0"
  },
  "devDependencies": {
    "sharp": "^0.34.5",
    "wrangler": "^3.114.17"
  }
}
