---
/**
 * Root layout. Head (noindex interlock, canonical, OG, favicons), the
 * LocalBusiness + WebSite + WebPage @graph plus page-level schema, header,
 * footer, the one root Lightbox, the mobile sticky bar, the TrustIndex corner
 * widget, motion, and the Quick Quote anchor law.
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import StickyCtaBar from '../components/StickyCtaBar.astro';
import { business, towns, services, seo, facts, slots } from '../data/site';
import { INDEXABLE } from '../data/launch';
import { markdownPath } from '../lib/md-path.js';

interface Props {
  title?: string;
  description?: string;
  page?: string;
  utility?: boolean; // thank-you / 404: no sticky bar, always noindex
  schema?: Record<string, unknown>[];
  ogImage?: string;
}
const { title = seo.title, description = seo.description, page = 'page', utility = false, schema = [], ogImage = '/brand/og-image.png' } = Astro.props;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
const robots = INDEXABLE && !utility ? 'index, follow' : 'noindex, nofollow';
// The page's markdown twin (written post-build by the ai-files integration).
const markdownUrl = new URL(markdownPath(Astro.url.pathname), Astro.site).href;

const graph: Record<string, unknown>[] = [
  {
    '@type': ['LocalBusiness', 'HomeAndConstructionBusiness', 'GeneralContractor'],
    '@id': `${business.url}/#business`,
    name: business.name,
    description: seo.description,
    url: `${business.url}/`,
    telephone: '+447853945013',
    email: business.email,
    image: new URL('/brand/logo-full.png', business.url).href,
    logo: new URL('/brand/logo-full.png', business.url).href,
    founder: { '@type': 'Person', name: business.owner },
    address: { '@type': 'PostalAddress', addressLocality: business.baseTown, addressRegion: business.region, postalCode: business.postcodeArea, addressCountry: 'GB' },
    geo: { '@type': 'GeoCoordinates', latitude: business.geo.lat, longitude: business.geo.lng },
    openingHours: 'Mo-Fr 08:00-17:00',
    areaServed: towns.map((t) => ({ '@type': 'Place', name: `${t.name}, Hampshire` })),
    knowsAbout: [...services.map((s) => s.name), 'Natural stone'],
    slogan: facts.guarantee,
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Building services',
      itemListElement: services.map((s) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s.name, url: `${business.url}/${s.slug}/` } })),
    },
  },
  { '@type': 'WebSite', '@id': `${business.url}/#website`, url: `${business.url}/`, name: business.name, inLanguage: 'en-GB', publisher: { '@id': `${business.url}/#business` } },
  { '@type': 'WebPage', '@id': `${pageUrl}#webpage`, url: pageUrl, name: title, description, inLanguage: 'en-GB', isPartOf: { '@id': `${business.url}/#website` }, about: { '@id': `${business.url}/#business` } },
  ...schema,
];
const jsonld = { '@context': 'https://schema.org', '@graph': graph };
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={pageUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {!utility && <link rel="alternate" type="text/markdown" href={markdownUrl} />}
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon/32-colour.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/brand/favicon/16-colour.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/brand/favicon/180-colour.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
  </head>
  <body data-page={page}>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer formless={utility} />
    {!utility && <StickyCtaBar />}
    <Lightbox formless={utility} />
    {/* TrustIndex floating left-corner reviews: every page (pass 2), hidden below 1024px in global.css. */}
    {!utility && slots.trustindexCorner && <script is:inline defer async src={slots.trustindexCorner}></script>}

    <script>
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const reveals = document.querySelectorAll<HTMLElement>('[data-motion="reveal"]');
      if (reduce) reveals.forEach((el) => el.classList.add('is-in'));
      else {
        // 12% of the element in view, or (for columns taller than the screen, which
        // can never reach 12%) a quarter of the viewport covered.
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.intersectionRatio >= 0.12 || e.intersectionRect.height >= window.innerHeight * 0.25) { (e.target as HTMLElement).classList.add('is-in'); io.unobserve(e.target); }
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: [0, 0.03, 0.06, 0.12] });
        reveals.forEach((el) => io.observe(el));
      }

      const header = document.querySelector<HTMLElement>('[data-header]');
      if (header) {
        const sync = () => header.toggleAttribute('data-stuck', window.scrollY > 24);
        window.addEventListener('scroll', sync, { passive: true });
        sync();
      }

      // CTA ANCHOR LAW (operator, 23 Oct): every Quick Quote link targets the form itself (#contact);
      // a page with no form (thank-you, 404) sends it to /contact/#contact.
      // Mobile lands the form fields in view; desktop scrolls the whole quote section.
      document.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href="#contact"], a[href$="#contact"]');
        if (!a) return;
        const form = document.getElementById('contact');
        if (!form) { e.preventDefault(); location.href = '/contact/#contact'; return; }
        const samePage = a.getAttribute('href') === '#contact' || a.pathname === location.pathname;
        if (!samePage) return;
        e.preventDefault();
        const mobile = window.innerWidth < 1024;
        const target = mobile ? form : (form.closest('section') ?? form);
        target.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
        history.replaceState(null, '', '#contact');
        // The form carries no visible service step (REV3 item 7): the page's service
        // rides along in the hidden input instead.
        const svc = a.dataset.service;
        const hidden = form.querySelector<HTMLInputElement>('input[type="hidden"][name="service"]');
        if (svc && hidden) hidden.value = svc;
        setTimeout(() => form.querySelector<HTMLInputElement>('input[name="name"]')?.focus({ preventScroll: true }), 650);
      });
    </script>
  </body>
</html>
