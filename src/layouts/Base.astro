---
/**
 * Root layout. Head (robots, canonical, OG, favicons), the HousePainter + WebSite + WebPage
 * @graph plus page-level schema, header, footer, the one root Lightbox, the mobile sticky bar,
 * the mobile WhatsApp button, motion, and the Quick Quote anchor law.
 * SCHEMA (plan, Contact): HousePainter with the name, phone, URL, the five services, areaServed
 * = the plan's towns, openingHoursSpecification (Mo-Fr 07:00-19:00, Sa-Su 08:00-18:00),
 * sameAs the YouTube channel, hasMap the Google listing. NO address (addressDisplay "no").
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import StickyCtaBar from '../components/StickyCtaBar.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { business, towns, services, seo, hoursSchema } from '../data/site';
import { INDEXABLE } from '../data/launch';
import { markdownPath } from '../lib/md-path.js';

interface Props {
  title?: string;
  description?: string;
  page?: string;
  utility?: boolean; // thank-you / 404: no sticky bar, always noindex
  schema?: Record<string, unknown>[];
  ogImage?: string;
  noindex?: boolean; // articles awaiting Brandon's review
}
const { title = seo.title, description = seo.description, page = 'page', utility = false, schema = [], ogImage = '/brand/og-image.png', noindex = false } = Astro.props;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
const robots = INDEXABLE && !utility && !noindex ? 'index, follow' : 'noindex, nofollow';
// The page's markdown twin (written post-build by the ai-files integration).
const markdownUrl = new URL(markdownPath(Astro.url.pathname), Astro.site).href;

const graph: Record<string, unknown>[] = [
  {
    '@type': 'HousePainter',
    '@id': `${business.url}/#business`,
    name: business.name,
    description: seo.description,
    url: `${business.url}/`,
    telephone: business.phoneE164,
    email: business.email,
    image: new URL('/brand/og-image.png', business.url).href,
    logo: new URL('/brand/logo.png', business.url).href,
    founder: { '@type': 'Person', name: business.owner },
    openingHoursSpecification: hoursSchema,
    areaServed: towns.map((t) => ({ '@type': 'Place', name: t.name })),
    hasMap: business.gbp.cidUrl,
    sameAs: [business.youtube, business.gbp.cidUrl],
    knowsAbout: services.map((s) => s.name),
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Painting and decorating services',
      itemListElement: services.map((s) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s.name, serviceType: s.name, url: `${business.url}/${s.slug}/` } })),
    },
  },
  { '@type': 'WebSite', '@id': `${business.url}/#website`, url: `${business.url}/`, name: business.name, inLanguage: 'en-GB', publisher: { '@id': `${business.url}/#business` } },
  { '@type': 'WebPage', '@id': `${pageUrl}#webpage`, url: pageUrl, name: title, description, inLanguage: 'en-GB', isPartOf: { '@id': `${business.url}/#website` }, about: { '@id': `${business.url}/#business` } },
  ...schema,
];
const jsonld = { '@context': 'https://schema.org', '@graph': graph };
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={pageUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {!utility && !noindex && <link rel="alternate" type="text/markdown" href={markdownUrl} />}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/icon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/brand/icon-16.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/brand/icon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/brand/icon-180.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#000000" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
  </head>
  <body data-page={page}>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header formless={utility} />
    <main id="main">
      <slot />
    </main>
    <Footer formless={utility} />
    {!utility && <StickyCtaBar />}
    <WhatsAppButton />
    <Lightbox formless={utility} />

    <script>
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const reveals = document.querySelectorAll<HTMLElement>('[data-motion="reveal"]');
      if (reduce) reveals.forEach((el) => el.classList.add('is-in'));
      else {
        // 12% of the element in view, or (for columns taller than the screen, which
        // can never reach 12%) a quarter of the viewport covered.
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.intersectionRatio >= 0.12 || e.intersectionRect.height >= window.innerHeight * 0.25) { (e.target as HTMLElement).classList.add('is-in'); io.unobserve(e.target); }
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: [0, 0.03, 0.06, 0.12] });
        reveals.forEach((el) => io.observe(el));
      }

      // CTA ANCHOR LAW (operator, 23 Oct): every Quick Quote link targets the form itself (#contact);
      // a page with no form (thank-you, 404) sends it to /contact/#contact.
      // Mobile lands the form fields in view; desktop scrolls the whole quote section.
      document.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href="#contact"], a[href$="#contact"]');
        if (!a) return;
        const form = document.getElementById('contact');
        if (!form) { e.preventDefault(); location.href = '/contact/#contact'; return; }
        const samePage = a.getAttribute('href') === '#contact' || a.pathname === location.pathname;
        if (!samePage) return;
        e.preventDefault();
        const mobile = window.innerWidth < 1024;
        const target = mobile ? form : (form.closest('[data-quote-card]')?.parentElement ?? form);
        target.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
        history.replaceState(null, '', '#contact');
      });
    </script>
  </body>
</html>
