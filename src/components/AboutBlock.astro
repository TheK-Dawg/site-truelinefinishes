---
/**
 * ABOUT BLOCK (Buildings for Life about block). Left: Brandon's photograph over a numbered
 * fact list (affirmed facts only, nap.json usps). Right: H2, copy, two circle-icon features,
 * button + the "Looking for more information? Contact Brandon" line. No eyebrow label.
 */
import Icon from './Icon.astro';
interface Props {
  heading: string; body: string[];
  image: { src: string; alt: string; width: number; height: number };
  rows: { n: string; title: string; text: string }[];
  features: { icon: string; title: string; text: string }[];
  button?: { href: string; label: string } | null;
  contactLine?: boolean;
}
const { heading, body, image, rows, features, button = null, contactLine = true } = Astro.props;
---
<section class="ab section section-about" data-section="about">
  <div class="ab__inner container">
    <div class="ab__left">
      <button type="button" class="ab__img" data-lightbox aria-label={`Open larger: ${image.alt}`} data-motion="reveal"><img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" /></button>
      <ol class="ab__rows">
        {rows.map((r, i) => (
          <li class="ab__row" data-motion="reveal" style={`--reveal-delay: ${i * 60}ms`}>
            <span class="ab__n">{r.n}</span>
            <div><h3>{r.title}</h3><p>{r.text}</p></div>
          </li>
        ))}
      </ol>
    </div>
    <div class="ab__right" data-motion="reveal" style="--reveal-delay: 80ms">
      <h2 class="ab__h2">{heading}</h2>
      {body.map((p) => <p class="ab__p" set:html={p} />)}
      <ul class="ab__features">
        {features.map((f, i) => (
          <li><span class:list={['ab__ic', i === 0 ? 'ab__ic--dark' : 'ab__ic--sand']}><Icon name={f.icon} /></span><h3>{f.title}</h3><p>{f.text}</p></li>
        ))}
      </ul>
      {(button || contactLine) && (
        <div class="ab__foot">
          {button && <a href={button.href} class="btn btn-primary" data-cta="about-more">{button.label}</a>}
          {contactLine && <p class="ab__more">Looking for more information? <a href="/contact/" class="text-link" data-cta="about-contact">Contact Brandon</a></p>}
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .ab__inner { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-16) var(--space-24); align-items: start; }
  .ab__img { display: block; width: 100%; padding: 0; border: 0; cursor: zoom-in; background: var(--bg-panel); }
  .ab__img img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }
  .ab__rows { list-style: none; padding: 0; margin-top: var(--space-6); }
  .ab__row { display: grid; grid-template-columns: var(--space-30) 1fr; gap: var(--space-6); padding: var(--space-6) 0; border-bottom: 1px solid var(--border-default); }
  .ab__n { font-family: var(--font-heading); font-size: var(--fs-4xl); font-weight: var(--fw-semibold); color: var(--text-heading); line-height: 1; }
  .ab__row h3 { font-size: var(--fs-lg); margin-bottom: var(--space-1); }
  .ab__row p { color: var(--text-muted); font-size: var(--fs-md); }
  .ab__right { position: sticky; top: calc(var(--header-h) + var(--space-6)); }
  .ab__h2 { font-size: var(--fs-5xl); margin-bottom: var(--space-5); }
  .ab__p { color: var(--text-muted); margin-bottom: var(--space-4); }
  .ab__features { list-style: none; padding: var(--space-6) 0 var(--space-8); display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-8); border-bottom: 1px solid var(--border-default); }
  .ab__features h3 { font-size: var(--fs-xl); margin: var(--space-4) 0 var(--space-2); }
  .ab__features p { color: var(--text-muted); font-size: var(--fs-md); }
  .ab__ic { display: grid; place-items: center; width: var(--icon-circle); height: var(--icon-circle); border-radius: var(--badge-radius); }
  .ab__ic--dark { background: var(--bg-inverse); color: var(--text-inverse); }
  .ab__ic--sand { background: var(--brand-primary); color: var(--brand-fg); }
  .ab__foot { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-6); margin-top: var(--space-8); }
  .ab__more { font-size: var(--fs-md); color: var(--text-muted); }
  @media (max-width: 900px) {
    .ab__inner { grid-template-columns: 1fr; gap: var(--space-10); }
    .ab__right { position: static; order: -1; }
    .ab__h2 { font-size: var(--fs-3xl); }
  }
  @media (max-width: 520px) { .ab__features { grid-template-columns: 1fr; gap: var(--space-6); } .ab__row { grid-template-columns: var(--space-20) 1fr; gap: var(--space-4); } .ab__n { font-size: var(--fs-3xl); } }
</style>
