---
/**
 * GOOGLE MAP EMBED of TrueLine Finishes' Business Profile, keyed on its CID (plan flag 4).
 * Auto-loads (no click-to-load facade, no image placeholder). Zoomed out to the area served:
 * the site never prints the address (standing prohibition 10).
 */
import { business } from '../data/site';
const src = `https://maps.google.com/maps?cid=${business.gbp.cid}&z=11&output=embed`;
---
<div class="map" data-map="gbp" data-gbp-cid={business.gbp.cid}>
  <iframe src={src} title={`${business.name} on Google Maps`} loading="eager" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
</div>
<style>
  .map { position: relative; width: 100%; height: 100%; min-height: calc(var(--space-30) * 2); background: var(--bg-panel); }
  .map iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
</style>
