---
/**
 * Google Maps embed, lazy iframe, no overlay.
 * gbp (default): Pete's Business Profile listing (walkthrough 25 Sep, E2):
 * slots.gbpEmbedSrc when the operator supplies the exact embed, otherwise the
 * listing looked up by its business name + locality.
 * query: a plain locality map (area, not premises).
 */
import { business, slots, gbpQuery } from '../data/site';
interface Props { query?: string; zoom?: number }
const { query, zoom = 13 } = Astro.props;
const gbp = !query;
const src = gbp
  ? slots.gbpEmbedSrc || `https://maps.google.com/maps?q=${encodeURIComponent(gbpQuery)}&z=${zoom}&output=embed`
  : `https://maps.google.com/maps?q=${encodeURIComponent(query)}&z=${zoom}&output=embed`;
const title = gbp ? `${business.name} on Google Maps` : `Map of ${query}`;
---
<div class="map" data-map={gbp ? 'gbp' : 'area'} data-gbp-slot={gbp ? slots.gbpEmbedSrc : undefined}>
  <iframe src={src} title={title} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
</div>
<style>
  .map { position: relative; width: 100%; height: 100%; min-height: calc(var(--space-30) * 2); background: var(--bg-panel); }
  .map iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
</style>
