---
/**
 * GOOGLE MAP EMBED. Auto-loads (no click-to-load facade, no image placeholder).
 * Default: TrueLine Finishes' Business Profile keyed on its CID (plan flag 4), used on /contact/.
 * `area`: a plain area map centred on the named place, NO business pin (home Areas section). The
 * CID embed's Google listing card prints the street address, and the site never shows the address
 * (standing prohibition 10), so the home page uses the area map (operator overhaul, 5 Nov 2026).
 */
import { business } from '../data/site';
interface Props { area?: string }
const { area } = Astro.props;
const src = area
  ? `https://maps.google.com/maps?q=${encodeURIComponent(area)}&z=11&output=embed`
  : `https://maps.google.com/maps?cid=${business.gbp.cid}&z=11&output=embed`;
---
<div class="map" data-map={area ? 'area' : 'gbp'} data-gbp-cid={area ? undefined : business.gbp.cid}>
  <iframe src={src} title={area ? `Map of ${area} and the towns around it` : `${business.name} on Google Maps`} loading="eager" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
</div>
<style>
  .map { position: relative; width: 100%; height: 100%; min-height: calc(var(--space-30) * 2); background: var(--bg-panel); }
  .map iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
</style>
