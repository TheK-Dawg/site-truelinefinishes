---
/**
 * SERVICE BODY (landing page, not an article: no ToC, no sidebar).
 * ROUND 3 (operator live review 3, 6 Nov 2026): the intro was a lone, unheaded text block with
 * nothing beside it, and the section cards had no heading over them. Now:
 *  - the intro has its own H2 and one of Brandon's photos beside it (photo first on mobile);
 *  - the card grid has its own H2; each card (its real pool photo, H3, short lead, points) sits
 *    under it;
 *  - with an odd number of cards the seed's `sectors:` line becomes the last card (a photo over
 *    the black box), so the two-column grid never ends on an empty cell; with an even number it
 *    stays the full-width black line under the grid.
 */
import { image as poolImage } from '../data/site';
import Icon from './Icon.astro';
interface Props {
  slug: string;
  introH2: string;
  introImage: string;
  intro: string[];
  sectionsH2: string;
  sections: { h2: string; lead: string; points: string[]; image: string }[];
  sectorsLine: string;
  sectorsImage?: string;
}
const { slug, introH2, introImage, intro, sectionsH2, sections, sectorsLine, sectorsImage } = Astro.props;
const cards = sections.map((s) => ({ ...s, photo: poolImage(s.image) }));
const introPhoto = poolImage(introImage);
const odd = cards.length % 2 === 1;
if (odd && !sectorsImage) throw new Error(`${slug}: an odd number of section cards needs sectorsImage (no empty grid cell)`);
const sectorsPhoto = odd && sectorsImage ? poolImage(sectorsImage) : null;
---
<section class="sb3 section section-service-intro" id="details" data-section="service-intro">
  <div class="container sb3__intro">
    <div class="sb3__copy" data-motion="reveal">
      <h2 class="sb3__ih2">{introH2}</h2>
      {intro.map((p, i) => <p class:list={[i === 0 && 'sb3__first']} set:html={p} />)}
    </div>
    <figure class="sb3__ifig" data-motion="reveal">
      <img src={introPhoto.src} alt={introPhoto.alt} width={introPhoto.width} height={introPhoto.height} loading="lazy" decoding="async" />
    </figure>
  </div>
</section>
<section class="sb3__grid-wrap section section--panel" data-section="service-sections">
  <div class="container">
    <h2 class="sb3__gh2" data-motion="reveal">{sectionsH2}</h2>
    <div class="sb3__grid" data-gallery>
      {cards.map((s, i) => (
        <article class="sb3__card" aria-labelledby={`s-${i + 1}`} data-motion="reveal" style={`--reveal-delay: ${(i % 2) * 60}ms`}>
          <button type="button" class="sb3__shot" data-lightbox aria-label={`Open larger: ${s.photo.alt}`}>
            <img src={s.photo.sm} alt={s.photo.alt} width={s.photo.width} height={s.photo.height} loading="lazy" decoding="async" data-full={s.photo.src} />
          </button>
          <div class="sb3__text">
            <h3 id={`s-${i + 1}`} class="sb3__h3">{s.h2}</h3>
            <p class="sb3__lead" set:html={s.lead} />
            <ul class="sb3__points">
              {s.points.map((p) => <li><Icon name="check" size={18} /><span set:html={p} /></li>)}
            </ul>
          </div>
        </article>
      ))}
      {sectorsPhoto && (
        <article class="sb3__card sb3__card--sectors" aria-labelledby="s-sectors" data-motion="reveal" data-sectors-card style="--reveal-delay: 60ms">
          <button type="button" class="sb3__shot" data-lightbox aria-label={`Open larger: ${sectorsPhoto.alt}`}>
            <img src={sectorsPhoto.sm} alt={sectorsPhoto.alt} width={sectorsPhoto.width} height={sectorsPhoto.height} loading="lazy" decoding="async" data-full={sectorsPhoto.src} />
          </button>
          <div class="sb3__text sb3__text--dark on-dark">
            <h3 id="s-sectors" class="sb3__h3"><Icon name="office" size={22} /> Who the Work Is For</h3>
            <p class="sb3__lead">{sectorsLine}</p>
          </div>
        </article>
      )}
    </div>
    {!sectorsPhoto && <p class="sb3__sectors"><Icon name="office" size={20} /> {sectorsLine}</p>}
  </div>
</section>

<style>
  .sb3 { padding-top: var(--space-4); padding-bottom: var(--section-pad-sm); }
  .sb3__intro { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--space-12); align-items: center; }
  .sb3__ih2 { font-size: var(--fs-4xl); margin-bottom: var(--space-5); }
  .sb3__copy p { color: var(--text-secondary); font-size: var(--fs-base); line-height: var(--lh-relaxed); }
  .sb3__copy p + p { margin-top: 1em; }
  .sb3__copy :global(a), .sb3__lead :global(a) { color: var(--brand-text); font-weight: var(--fw-semibold); }
  .sb3__copy .sb3__first { font-size: var(--fs-xl); line-height: var(--lh-normal); }
  .sb3__ifig { margin: 0; overflow: hidden; box-shadow: var(--shadow-card); }
  .sb3__ifig img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .sb3__gh2 { font-size: var(--fs-4xl); margin-bottom: var(--space-10); }
  .sb3__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-8); }
  .sb3__card { display: flex; flex-direction: column; background: var(--bg-card); border: 1px solid var(--border-default); box-shadow: var(--shadow-card); }
  .sb3__shot { display: block; width: 100%; padding: 0; border: 0; cursor: zoom-in; background: var(--bg-panel); overflow: hidden; }
  .sb3__shot img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; transition: transform 0.5s var(--ease); }
  .sb3__shot:hover img { transform: scale(1.03); }
  .sb3__text { padding: var(--space-6) var(--card-pad) var(--card-pad); }
  .sb3__text--dark { flex: 1; display: flex; flex-direction: column; justify-content: center; background: var(--bg-inverse); color: var(--text-inverse-muted); }
  .sb3__text--dark .sb3__h3 { display: flex; gap: var(--space-3); align-items: center; color: var(--text-inverse); }
  .sb3__text--dark .sb3__h3 :global(.icon) { color: var(--accent-on-dark); flex-shrink: 0; }
  .sb3__text--dark .sb3__lead { color: var(--text-inverse); font-weight: var(--fw-semibold); }
  .sb3__card--sectors { border-color: var(--border-inverse); }
  /* The card titles keep the look they had as H2s (capitals), now H3s under the grid's H2. */
  .sb3__h3 { font-size: var(--fs-2xl); text-transform: uppercase; font-variant-caps: normal; letter-spacing: var(--ls-heading); }
  .sb3__lead { margin-top: var(--space-3); color: var(--text-secondary); }
  .sb3__points { list-style: none; padding: 0; margin-top: var(--space-4); display: grid; gap: var(--space-2); }
  .sb3__points li { display: grid; grid-template-columns: auto 1fr; gap: var(--space-3); align-items: start; color: var(--text-primary); font-size: var(--fs-md); line-height: var(--lh-normal); }
  .sb3__points :global(.icon) { color: var(--brand-primary); margin-top: 2px; }
  .sb3__sectors { display: flex; gap: var(--space-3); align-items: center; margin-top: var(--space-10); padding: var(--space-5) var(--space-6); background: var(--bg-inverse); color: var(--text-inverse); font-weight: var(--fw-semibold); }
  .sb3__sectors :global(.icon) { color: var(--accent-on-dark); flex-shrink: 0; }
  @media (max-width: 900px) {
    .sb3__intro { grid-template-columns: 1fr; gap: var(--space-6); }
    .sb3__ifig { order: -1; }
    .sb3__ih2, .sb3__gh2 { font-size: var(--fs-3xl); }
    .sb3__gh2 { margin-bottom: var(--space-6); }
    .sb3__grid { grid-template-columns: 1fr; gap: var(--space-5); }
    .sb3__copy .sb3__first { font-size: var(--fs-lg); }
  }
</style>
