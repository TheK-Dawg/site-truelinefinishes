---
/**
 * LEGAL PAGE SHELL (privacy, terms, cookie policy): the template's spine. Inner hero, reviews,
 * then two columns: a sticky contents list built from the page's H2s, and the prose beside a
 * sticky quote card. The quote form closes the page (form law: every page).
 */
import Base from '../layouts/Base.astro';
import PageHero from './PageHero.astro';
import Reviews from './Reviews.astro';
import QuoteForm from './QuoteForm.astro';
import CallButton from './CallButton.astro';
interface Props { title: string; description: string; h1: string; page: string; lead: string }
const { title, description, h1, page, lead } = Astro.props;
const slug = (s: string) => s.toLowerCase().replace(/&[a-z]+;/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const toc: { id: string; label: string }[] = [];
const html = (await Astro.slots.render('default')).replace(/<h2([^>]*)>([\s\S]*?)<\/h2>/g, (_m, attrs: string, inner: string) => {
  // "contact" is the quote form's id (CTA anchor law), so a "Contact" heading takes "contact-us".
  const id = slug(inner.replace(/<[^>]+>/g, '')).replace(/^contact$/, 'contact-us');
  toc.push({ id, label: inner.replace(/<[^>]+>/g, '') });
  return `<h2${attrs} id="${id}">${inner}</h2>`;
});
---
<Base title={title} description={description} page={page}>
  <PageHero h1={h1} lead={lead} />
  <Reviews />
  <section class="lg section section-legal" data-section="legal">
    <div class="container lg__grid">
      <nav class="lg__toc" aria-label="On this page">
        <p class="lg__toc-h">Contents</p>
        <ol>{toc.map((t) => <li><a href={`#${t.id}`}>{t.label}</a></li>)}</ol>
      </nav>
      <div class="lg__main">
        <div class="prose lg__body" set:html={html} />
        <aside class="lg__card on-dark" aria-label="Quick Quote">
          <p class="lg__card-h">Need a quote?</p>
          <p class="lg__card-p">Get a free quotation: call Brandon on 07949 484274 or use the quote form.</p>
          <a href="#contact" class="btn btn-primary" data-cta="legal-quote">Quick Quote Online</a>
          <CallButton cta="legal-call" />
        </aside>
      </div>
    </div>
  </section>
  <QuoteForm />
</Base>

<style>
  .lg__grid { display: grid; grid-template-columns: var(--legal-toc-w) minmax(0, 1fr); gap: var(--space-12); align-items: start; }
  .lg__toc { position: sticky; top: calc(var(--header-h) + var(--space-6)); background: var(--bg-panel); padding: var(--space-6); }
  .lg__toc-h { font-size: var(--fs-sm); letter-spacing: var(--ls-eyebrow); text-transform: uppercase; font-weight: var(--fw-semibold); color: var(--text-heading); margin-bottom: var(--space-3); }
  .lg__toc ol { list-style: none; padding: 0; display: flex; flex-direction: column; font-size: var(--fs-md); }
  .lg__toc li { padding: var(--space-2) 0; border-bottom: 1px solid var(--border-strong); }
  .lg__toc li:last-child { border-bottom: 0; }
  .lg__toc a { color: var(--brand-text); }
  .lg__toc a:hover { color: var(--text-heading); }
  .lg__main { display: grid; grid-template-columns: minmax(0, 1fr) var(--legal-card-w); gap: var(--space-12); align-items: start; }
  .lg__body { max-width: 72ch; }
  .lg__body > :global(:first-child) { margin-top: 0; }
  .lg__body :global(h2) { scroll-margin-top: calc(var(--header-h) + var(--space-6)); }
  .lg__card { position: sticky; top: calc(var(--header-h) + var(--space-6)); display: grid; gap: var(--space-4); padding: var(--card-pad); background: var(--bg-inverse); border-top: 3px solid var(--accent-on-dark); color: var(--text-inverse-muted); }
  .lg__card-h { font-family: var(--font-heading); text-transform: uppercase; font-size: var(--fs-2xl); font-weight: var(--fw-semibold); line-height: var(--lh-tight); color: var(--text-inverse); }
  .lg__card-p { font-size: var(--fs-md); }
  .lg__card :global(.btn) { width: 100%; padding-inline: var(--space-4); }
  @media (max-width: 1180px) { .lg__main { grid-template-columns: 1fr; } .lg__card { position: static; max-width: var(--form-w); } }
  @media (max-width: 1023px) {
    .lg__grid { grid-template-columns: 1fr; gap: var(--space-8); }
    .lg__toc { position: static; }
    .lg__card { max-width: none; }
  }
</style>
