---
/**
 * STICKY CTA BAR. MOBILE ONLY (<1024px). Hidden while the hero is on screen (the hero has its
 * own CTAs), shown once it scrolls out, hidden again over the quote form and the footer.
 * The site's own black styling: Quick Quote Online on white, the call button in chrome blue
 * (black text) showing the number. A call is a direct line to Brandon.
 */
import Icon from './Icon.astro';
import { business } from '../data/site';
---
<div class="sb on-dark" data-sticky-cta hidden>
  <a class="sb__quote" href="#contact" data-cta="sticky-quote"><span class="btn__t">Quick Quote</span></a>
  <a class="sb__call" href={business.phoneHref} data-cta="sticky-call"><Icon name="phone" size={18} /><span class="btn__t">{business.phone}</span></a>
</div>

<style>
  .sb { position: fixed; inset: auto 0 0 0; z-index: 85; grid-template-columns: 1fr 1fr; gap: var(--space-3); padding: var(--space-2) var(--space-3) calc(var(--space-2) + env(safe-area-inset-bottom)); background: var(--bg-inverse); border-top: 1px solid var(--border-inverse); }
  .sb:not([hidden]) { display: grid; }
  .sb a { display: flex; align-items: center; justify-content: center; gap: var(--space-2); min-height: var(--btn-h-md); padding: var(--space-3) var(--space-2); font-size: var(--fs-md); font-weight: var(--fw-semibold); letter-spacing: 1px; text-transform: uppercase; text-align: center; white-space: nowrap; }
  .sb__quote { background: var(--bg-card); color: var(--text-heading); }
  .sb__call { background: var(--accent-on-dark); color: var(--accent-on-dark-fg); }
  @media (max-width: 400px) { .sb a { font-size: var(--fs-sm); letter-spacing: 0; } }
  @media (min-width: 1024px) { .sb, .sb:not([hidden]) { display: none; } }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-sticky-cta]');
  const hero = document.querySelector<HTMLElement>('main > section:first-child');
  const watch = [...document.querySelectorAll<HTMLElement>('[data-quote-card], footer')];
  if (bar && hero) {
    let heroVisible = true;
    const vis = new Map<Element, boolean>();
    const sync = () => { bar.hidden = heroVisible || [...vis.values()].some(Boolean); document.documentElement.toggleAttribute('data-sticky', !bar.hidden); };
    new IntersectionObserver((en) => { heroVisible = en[0]?.isIntersecting ?? false; sync(); }, { threshold: 0.05 }).observe(hero);
    const io = new IntersectionObserver((en) => { en.forEach((e) => vis.set(e.target, e.isIntersecting)); sync(); }, { threshold: 0.05 });
    watch.forEach((el) => io.observe(el));
  }
</script>
