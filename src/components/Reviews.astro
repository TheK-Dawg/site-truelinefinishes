---
/**
 * REVIEWS (Buildings for Life position and layout: head above, the TrustIndex widget full width
 * under it). The one review component on the site, directly under the hero on every page,
 * byte-identical everywhere (takes only a `full` flag for the /reviews/ page).
 * SOURCE: Brandon's Google Business Profile, CID 8023434379390696838 (plan flag 4), through the
 * operator's standard Trustindex review-section widget (slots.trustindexReviews).
 * TODO(operator): the TrueLine Trustindex widget id has not been supplied. No id is invented and
 * no other client's widget is reused. Until it is set this section shows its heading, its lead and
 * the marked empty slot: NO reviews, no count, no rating (standing prohibitions 2 and 24, site
 * rule 8), and no "read our reviews on Google" line (operator round 2, fix 1). /reviews/ (`full`)
 * keeps one button to the live Google listing so that page is not empty.
 * Never the Rated People reviews: those are another business called TrueLine, in Eastbourne.
 */
import { business, slots } from '../data/site';
interface Props { full?: boolean }
const { full = false } = Astro.props;
const ti = slots.trustindexReviews;
---
<section class:list={['rv section section-reviews', full && 'rv--full']} id="reviews" data-section="reviews" data-ai-skip>
  <div class="container rv__inner">
    <div class="rv__head" data-motion="reveal">
      <h2 class="rv__h2">What customers say about us</h2>
      <p class="rv__lead">Reviews come straight from TrueLine Finishes' Google Business Profile, in the customers' own words.</p>
    </div>
    <Fragment set:html={`<!-- TODO-TrustIndex-ID: Trustindex review widget for Google CID ${business.gbp.cid}. Set slots.trustindexReviews in src/data/site.ts and the widget renders here. -->`} />
    <div class:list={['rv__widget', ti && 'rv__widget--ti']} data-trustindex-todo={ti ? undefined : 'TODO-TrustIndex-ID'} data-trustindex-slot="reviews" data-trustindex-cid={business.gbp.cid} data-trustindex-state={ti ? 'live' : 'pending-widget-id'}>
      {ti ? <script is:inline defer async src={ti}></script> : full && (
        <p class="rv__pending"><a href={business.gbp.mapsUrl} class="btn btn-primary" target="_blank" rel="noopener" data-cta="reviews-google"><span class="btn__t">Read Our Google Reviews</span></a></p>
      )}
    </div>
  </div>
</section>

<style>
  .rv { background: var(--bg-card); }
  .rv__inner { display: grid; grid-template-columns: 1fr; gap: var(--space-8); }
  .rv__head { margin-bottom: 0; }
  .rv__widget:empty { display: none; }
  /* TrustIndex renders on first user input: reserve its height so nothing below jumps. */
  .rv__widget--ti { min-height: calc(var(--space-30) * 3); }
  .rv__h2 { font-size: var(--fs-4xl); margin-bottom: var(--space-4); }
  .rv__lead { color: var(--text-muted); max-width: 52ch; }
  @media (max-width: 900px) { .rv__h2 { font-size: var(--fs-3xl); } }
</style>
