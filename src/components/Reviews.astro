---
/**
 * REVIEWS (Electrix "Testimonials"). THE one review component on the site
 * (REV3 item 6c): it takes no props, so the section renders byte-identical on
 * every page type and no page can invent its own review wording. It sits
 * directly under the hero everywhere.
 * REV3 item 6b: the "Average rating X / 5 on Google" line is gone. The widget
 * below already shows the rating and the review count, once.
 *
 * LOADER HOST (REV3 flag 7, measured 5 Oct): TrustIndex only renders a widget whose
 * box is laid out in the FIRST SCREEN at load, and never renders it afterwards, not
 * even when you scroll to it. On the home page at 360px the hero is tall enough to
 * push this section out of the first screen, so the widget never appeared at all. The
 * loader therefore runs from .rv__host, a box pinned to the top of the viewport and
 * clipped to nothing, and the rendered widget is MOVED into the section below (moved,
 * not cloned, so the slider keeps the handlers TrustIndex bound to it).
 * TRUSTINDEX SLOT (walkthrough 25 Sep, B1/B3): when slots.trustindexReviews
 * holds the operator's TrustIndex loader src (LARGE widget, set 28 Sep), the
 * widget renders here and the custom cards below are not output at all. Without it: REAL Google reviews
 * only (inputs/reviews/reviews.json), real text, real star ratings, the
 * reviewer's public name, attributed "Google review", on the light site
 * styling (the dark green band is gone, B3).
 */
import Stars from './Stars.astro';
import Icon from './Icon.astro';
import { reviews, slots } from '../data/site';
const heading = 'What customers said after the job';
const lead = 'Every review here is a real Google review, word for word.';
const eyebrow = 'Reviews';
const trustindex = slots.trustindexReviews;
const initials = (n: string) => n.split(/\s+/).map((w) => w.match(/[A-Za-z]/)?.[0] ?? '').join('').slice(0, 2).toUpperCase() || 'G';
---
<section class="rv section section-reviews" id="reviews" data-section="reviews" data-ai-skip>
  <div class="container">
    <div class="rv__head" data-motion="reveal">
      <div>
        <p class="eyebrow">{eyebrow}</p>
        <h2 class="sec-head__h2">{heading}</h2>
        <p class="rv__lead">{lead}</p>
      </div>
    </div>
    <div class:list={['rv__widget', trustindex && 'rv__widget--ti']} data-trustindex-slot="reviews" data-trustindex-src={trustindex}>
      {trustindex ? (
        <div class="rv__host" aria-hidden="true"><div class="rv__host-box" data-reviews-host><script is:inline defer async src={trustindex}></script></div></div>
      ) : (
        <div class="rv__slab" data-motion="reveal">
          <ul class="rv__track" data-rv-track tabindex="0" aria-label="Google reviews">
            {reviews.map((r) => (
              <li class="rv__card">
                <Stars rating={r.rating} />
                <blockquote class="rv__text"><p>{r.text}</p></blockquote>
                <div class="rv__who">
                  <span class="rv__avatar" aria-hidden="true">{initials(r.name)}</span>
                  <span><strong>{r.name}</strong><span class="rv__src">Google review</span></span>
                </div>
              </li>
            ))}
          </ul>
          <div class="rv__controls">
            <button type="button" class="rv__btn" data-rv-prev aria-label="Previous reviews"><Icon name="chevronLeft" size={20} /></button>
            <div class="rv__dots" data-rv-dots>{reviews.map((_, i) => <span class:list={['rv__dot', i === 0 && 'is-on']} />)}</div>
            <button type="button" class="rv__btn" data-rv-next aria-label="Next reviews"><Icon name="chevronRight" size={20} /></button>
          </div>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .rv__head { display: flex; justify-content: space-between; align-items: flex-end; gap: var(--space-8); margin-bottom: var(--space-10); flex-wrap: wrap; }
  .rv__lead { color: var(--text-muted); margin-top: var(--space-3); }
  /* TrustIndex renders on first user input: reserve its measured height (356 / 439 on phones) so nothing below jumps. */
  .rv__widget--ti { min-height: calc(var(--space-30) * 3); }
  /* LOADER HOST (see the note at the top): pinned to the top of the viewport, clipped to
     nothing. TrustIndex renders the widget here, the script below moves it into the
     section, and the host is then empty. It is never visible and takes no space. */
  .rv__host { position: fixed; top: 0; left: 0; z-index: -1; width: 100%; height: 0; overflow: hidden; pointer-events: none; }
  .rv__host-box { width: 100%; }
  .rv__track { list-style: none; padding: 0; display: grid; align-items: stretch; grid-auto-flow: column; grid-auto-columns: calc((100% - var(--space-6)) / 2); gap: var(--space-6); overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .rv__track::-webkit-scrollbar { display: none; }
  .rv__card { scroll-snap-align: start; display: flex; flex-direction: column; gap: var(--space-5); padding: var(--card-pad); background: var(--bg-panel); border-top: 2px solid var(--brand-primary); }
  .rv__text { margin: 0; flex: 1; }
  .rv__text p { color: var(--text-primary); font-size: var(--fs-base); line-height: var(--lh-relaxed); font-weight: var(--fw-regular); }
  .rv__who { display: flex; align-items: center; gap: var(--space-4); }
  .rv__who strong { display: block; color: var(--text-heading); font-weight: var(--fw-semibold); }
  .rv__src { font-size: var(--fs-md); color: var(--text-muted); }
  .rv__avatar { display: grid; place-items: center; width: var(--space-12); height: var(--space-12); border-radius: var(--badge-radius); background: var(--bg-inverse); color: var(--accent-on-dark); font-weight: var(--fw-semibold); }
  .rv__controls { display: flex; justify-content: center; align-items: center; gap: var(--space-5); margin-top: var(--space-8); }
  .rv__btn { display: grid; place-items: center; width: var(--tap); height: var(--tap); border-radius: var(--badge-radius); border: 1px solid var(--border-strong); background: var(--bg-card); color: var(--text-heading); cursor: pointer; }
  .rv__btn:hover { background: var(--brand-primary); border-color: var(--brand-primary); color: var(--brand-fg); }
  .rv__dots { display: flex; gap: var(--space-2); }
  .rv__dot { width: var(--space-3); height: var(--space-3); border-radius: var(--badge-radius); background: var(--border-strong); }
  .rv__dot.is-on { background: var(--brand-primary); }
  @media (max-width: 520px) { .rv__widget--ti { min-height: calc(var(--space-30) * 3 + var(--space-20)); } }
  @media (max-width: 900px) {
    .rv__track { grid-auto-columns: 100%; gap: var(--space-4); }
    .rv__card { padding: var(--space-6); }
  }
</style>

<script>
  // Move the rendered widget out of its loader host and into the section.
  const reviewsSlot = document.querySelector<HTMLElement>('[data-trustindex-slot="reviews"]');
  const reviewsHost = reviewsSlot?.querySelector<HTMLElement>('[data-reviews-host]');
  if (reviewsSlot && reviewsHost) {
    const place = () => {
      const widget = reviewsHost.querySelector<HTMLElement>('.ti-widget');
      if (!widget) return false;
      reviewsSlot.appendChild(widget); // moved, not copied: the slider keeps its handlers
      return true;
    };
    if (!place()) {
      const observer = new MutationObserver(() => { if (place()) observer.disconnect(); });
      observer.observe(reviewsHost, { childList: true, subtree: true });
      // TrustIndex renders on first user input; stop watching after a minute either way.
      setTimeout(() => observer.disconnect(), 60000);
    }
  }

  document.querySelectorAll<HTMLElement>('.rv__slab').forEach((slab) => {
    const track = slab.querySelector<HTMLElement>('[data-rv-track]')!;
    const dots = Array.from(slab.querySelectorAll<HTMLElement>('.rv__dot'));
    const cards = Array.from(track.children) as HTMLElement[];
    const step = () => (cards[0]?.getBoundingClientRect().width ?? 0) + parseFloat(getComputedStyle(track).columnGap || '0');
    slab.querySelector('[data-rv-prev]')?.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    slab.querySelector('[data-rv-next]')?.addEventListener('click', () => {
      const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
      atEnd ? track.scrollTo({ left: 0, behavior: 'smooth' }) : track.scrollBy({ left: step(), behavior: 'smooth' });
    });
    track.addEventListener('scroll', () => {
      const i = Math.round(track.scrollLeft / Math.max(1, step()));
      dots.forEach((d, n) => d.classList.toggle('is-on', n === i));
    }, { passive: true });
  });
</script>
