---
/**
 * REVIEWS (Buildings for Life position and layout: head above, the Trustindex widget full width
 * under it). The one review component on the site, directly under the hero on every page,
 * byte-identical everywhere except /reviews/ (`full`).
 * SOURCE: Brandon's Google Business Profile, CID 8023434379390696838 (plan flag 4), through the
 * TrueLine Trustindex widgets Vince supplied (6 Nov 2026, src/data/site.ts `trustindex`):
 *  - every page: the MAIN widget (slider);
 *  - /reviews/ (`full`): the REVIEW PAGE widget (grid) INSTEAD of main, never both.
 * The widget shows Google's own live reviews, rating and count; the site writes none of them
 * (standing prohibitions 2 and 24, site rule 8).
 * Never the Rated People reviews: those are another business called TrueLine, in Eastbourne.
 */
import TrustindexSlot from './TrustindexSlot.astro';
interface Props { full?: boolean; tight?: boolean }
// tight: articles (round 3), the breadcrumbs and the article follow straight on, so the bottom padding is small.
const { full = false, tight = false } = Astro.props;
---
<section class:list={['rv section section-reviews', full && 'rv--full', tight && 'rv--tight']} id="reviews" data-section="reviews" data-ai-skip>
  <div class="container rv__inner">
    <div class="rv__head" data-motion="reveal">
      <h2 class="rv__h2">What customers say about us</h2>
      <p class="rv__lead">Reviews come straight from TrueLine Finishes' Google Business Profile, in the customers' own words.</p>
    </div>
    <TrustindexSlot role={full ? 'reviewPage' : 'main'} place="reviews" class="rv__widget" />
  </div>
</section>

<style>
  .rv { background: var(--bg-card); }
  .rv--tight { padding-bottom: var(--space-8); }
  .rv__inner { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-8); }
  .rv__head { margin-bottom: 0; }
  .rv__h2 { font-size: var(--fs-4xl); margin-bottom: var(--space-4); }
  .rv__lead { color: var(--text-muted); max-width: 52ch; }
  @media (max-width: 900px) { .rv__h2 { font-size: var(--fs-3xl); } }
</style>
