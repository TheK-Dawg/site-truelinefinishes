---
/**
 * INNER PAGE HERO (Electrix inner banner). Photograph under the green overlay,
 * then a boxed glass panel on the bottom edge: the H1 left; lead, breadcrumbs,
 * Quick Quote Online + call right; the slim white TrustIndex widget directly
 * under the CTA on every page (pass 2: it replaced the Google review link line).
 */
import TiSlim from './TiSlim.astro';
import CallButton from './CallButton.astro';
interface Props { eyebrow?: string; h1: string; lead: string; image: { src: string; alt: string }; crumbs: { label: string; href?: string }[]; service?: string; showCta?: boolean }
const { eyebrow, h1, lead, image, crumbs, service = '', showCta = true } = Astro.props;
---
<section class="ph on-dark section-hero" data-section="hero">
  <img class="ph__bg" src={image.src} alt="" width="1600" height="1000" fetchpriority="high" decoding="async" />
  <div class="container">
    <div class="ph__panel">
      <div class="ph__left">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1 class="ph__h1">{h1}</h1>
      </div>
      <div class="ph__right">
        <p class="ph__lead">{lead}</p>
        <nav class="ph__crumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            {crumbs.map((c) => <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>)}
          </ol>
        </nav>
        {showCta && (
          <div class="btn-row ph__cta">
            <a href="#contact" class="btn btn-primary" data-cta="hero-quote" data-service={service || undefined}>Quick Quote Online</a>
            <CallButton cta="hero-call" />
          </div>
        )}
        <div class="ph__strip"><TiSlim where="hero" /></div>
      </div>
    </div>
  </div>
</section>

<style>
  .ph { position: relative; isolation: isolate; overflow: hidden; background: var(--bg-inverse-deep); color: var(--text-inverse-muted); padding-top: calc(var(--header-h) + var(--space-20)); }
  .ph__bg { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; }
  .ph::before { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--overlay-hero); }
  .ph__panel { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: var(--space-8) var(--space-16); padding: var(--space-12) var(--space-12) var(--space-10); background: var(--glass); border-top: 1px solid var(--border-inverse); backdrop-filter: blur(2px); }
  .ph__h1 { color: var(--text-inverse); font-size: var(--fs-5xl); line-height: 1.12; }
  .ph__lead { font-size: var(--fs-lg); margin-bottom: var(--space-5); }
  .ph__crumbs ol { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); font-size: var(--fs-sm); font-weight: var(--fw-semibold); letter-spacing: var(--ls-eyebrow); text-transform: uppercase; color: var(--text-inverse); }
  .ph__crumbs a:hover { color: var(--accent-on-dark); }
  .ph__crumbs [aria-current] { color: var(--accent-on-dark); }
  .ph__cta { margin-top: var(--space-6); }
  /* REV3 follow-up: desktop only, same as the home hero. */
  .ph__strip { margin-top: var(--space-5); }
  /* Mobile: collapsed to nothing and clipped, NOT display:none. TrustIndex only ever
     renders this widget if its box is laid out in the first screen, and this slot is
     the loader host that TiSlim copies into the form and footer strips. */
  @media (max-width: 1023px) { .ph__strip { height: 0; margin: 0; overflow: hidden; } }
  @media (max-width: 900px) {
    .ph { padding-top: calc(var(--header-h) + var(--space-8)); }
    .ph__panel { grid-template-columns: 1fr; padding: var(--space-8) var(--space-5); }
    .ph__h1 { font-size: var(--fs-4xl); }
  }
  @media (max-width: 640px) {
    .ph__h1 { font-size: var(--fs-3xl); }
    .ph__lead { font-size: var(--fs-base); }
    .ph__cta :global(.btn) { width: 100%; }
  }
</style>
