---
/**
 * INNER PAGE HERO (operator round 2, 5 Nov 2026): the HOME hero pattern on every page, through
 * Hero.astro in `compact` mode: the page's photo as the full-bleed background under the same
 * overlay, the same container and headline placement, H1, lead, Quick Quote Online + Call, the
 * slim Trustindex slot. Smaller than the home hero and without the info cards. No side image
 * (the hub pages' right-hand photo became the background). Pages with no photo of their own
 * (legal, site map, company pages) take Brandon's dust-sheeted room. No breadcrumbs in heroes.
 */
import Hero from './Hero.astro';
import { image as poolImage } from '../data/site';
interface Props { h1: string; lead: string; image?: { src: string; alt: string; width: number; height: number }; showCta?: boolean; formless?: boolean }
const { h1, lead, image, showCta = true, formless = false } = Astro.props;
---
<Hero compact h1={h1} lead={lead} image={image ?? poolImage('room-dust-sheets-0086')} showCta={showCta} formless={formless} />
