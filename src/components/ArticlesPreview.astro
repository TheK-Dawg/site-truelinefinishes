---
/**
 * ARTICLES PREVIEW, in Home 3's resources row (the Dom reference's "Recent Articles"): a row head
 * (heading left, All resources right), photo cards with the service label over the title. The title is the card's
 * ONLY link. Published articles only (src/data/articles.ts status gate). Never "blog", never
 * "guides": the section is Resources. `always` (home page, BFL order): when nothing is published
 * yet the section still renders, with an honest line and the Resources link, never a draft link.
 */
import { articles, articleUrl } from '../data/articles';
import { image, services } from '../data/site';
interface Props { heading?: string; lead?: string; exclude?: string; limit?: number; hub?: string; town?: string; always?: boolean }
const { heading = 'Latest resources', lead = 'Painting and decorating, explained place by place.', exclude = '', limit = 3, hub = '', town = '', always = false } = Astro.props;
const showAll = Astro.url.pathname !== '/resources/';
const list = articles.filter((a) => a.slug !== exclude && (!hub || a.hub === hub) && (!town || a.town === town)).slice(0, limit);
const hubName = (slug: string) => services.find((s) => s.slug === slug)?.name ?? '';
---
{(list.length > 0 || always) && (
<section class="ap section section-articles" id="resources" data-section="articles">
  <div class="container">
    <div class="dm-head dm-head--row" data-motion="reveal">
      <div>
        <h2 class="dm-h2">{heading}</h2>
        {lead && <p class="dm-lead">{lead}</p>}
      </div>
      {showAll && <a href="/resources/" class="dm-link" data-cta="articles-all">All resources</a>}
    </div>
    {list.length === 0 && <p class="ap__empty">The first TrueLine Finishes resources on painting and decorating, room by room and town by town, are being written. They will appear here as they are published.</p>}
    <ul class="ap__grid">
      {list.map((a, i) => {
        const img = image(a.hero);
        return (
          <li class="ap__card" data-motion="reveal" style={`--reveal-delay: ${i * 70}ms`}>
            <div class="ap__img"><img src={img.sm} alt={img.alt} width={img.width} height={img.height} loading="lazy" decoding="async" /></div>
            <span class="ap__cat">{hubName(a.hub)}</span>
            <h3 class="ap__title"><a href={articleUrl(a)} data-link="card">{a.title}</a></h3>
            <p class="ap__body">{a.summary}</p>
          </li>
        );
      })}
    </ul>
  </div>
</section>
)}

<style>
  .ap__grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-6); }
  .ap__card { display: flex; flex-direction: column; gap: var(--space-2); }
  .ap__img { aspect-ratio: 4 / 3; overflow: hidden; margin-bottom: var(--space-3); background: var(--bg-panel); }
  .ap__img img { width: 100%; height: 100%; object-fit: cover; }
  .ap__cat { font-size: var(--fs-xs); font-weight: var(--fw-bold); letter-spacing: var(--ls-eyebrow); text-transform: uppercase; color: var(--text-muted); }
  .ap__title { font-size: var(--fs-xl); line-height: 1.25; }
  .ap__title a { color: var(--text-heading); transition: color 0.2s var(--ease); }
  .ap__title a:hover { color: var(--brand-primary); }
  .ap__body { font-size: var(--fs-card); color: var(--text-muted); }
  .ap__empty { padding: var(--card-pad); background: var(--bg-panel); color: var(--text-primary); }
  .ap__grid:empty { display: none; }
  @media (max-width: 1023px) { .ap__grid { grid-template-columns: 1fr; gap: var(--space-10); } }
</style>
