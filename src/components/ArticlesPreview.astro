---
/**
 * ARTICLES PREVIEW (Electrix "Blog & Articles"). Head left, lead + button
 * right; image cards with a topic chip. CARD LAW: the article title is the
 * card's ONLY link (never "Read more"), once per page via the ledger. No dates.
 * REV3 item 5: the section is RESOURCES everywhere; "guides" is a banned word,
 * so the button anchor is the keyword "Resources", never "All guides".
 * Articles come from the SEO engine (src/data/articles.ts).
 */
import { articles } from '../data/articles';
import { AnchorLedger, articleCardLink } from '../lib/anchors';
interface Props { heading?: string; lead?: string; exclude?: string; limit?: number; related?: string }
const { heading = 'Resources from the building site', lead = 'Written to answer the questions people ask before a build starts: planning, structure, materials and what happens on site.', exclude = '', limit = 3, related = '' } = Astro.props;
const showAll = Astro.url.pathname !== '/resources/';
const list = articles.filter((a) => a.slug !== exclude && (!related || a.related === related)).slice(0, limit);
const ledger = new AnchorLedger();
---
{list.length > 0 && (
<section class="ap section section-articles" id="resources" data-section="articles">
  <div class="container">
    <div class="sec-head" data-motion="reveal">
      <div>
        <p class="eyebrow">Resources</p>
        <h2 class="sec-head__h2">{heading}</h2>
      </div>
      <div class="sec-head__side">
        <p class="sec-head__lead">{lead}</p>
        {showAll && <a href="/resources/" class="btn btn-primary" data-cta="articles-all">Resources</a>}
      </div>
    </div>
    <ul class="ap__grid">
      {list.map((a, i) => {
        const link = articleCardLink(a, ledger);
        return (
          <li class="ap__card" data-motion="reveal" style={`--reveal-delay: ${i * 70}ms`}>
            <div class="ap__img"><img src={a.hero} alt={a.heroAlt} width="1200" height="800" loading="lazy" decoding="async" /><span class="ap__chip">{a.topic}</span></div>
            <h3 class="ap__title">{link ? <a href={link.href} data-link="card">{link.anchor}</a> : <span>{a.title}</span>}</h3>
            <p class="ap__body">{a.summary}</p>
          </li>
        );
      })}
    </ul>
  </div>
</section>
)}

<style>
  .ap__grid { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-8); }
  .ap__card { display: flex; flex-direction: column; gap: var(--space-3); }
  .ap__img { position: relative; aspect-ratio: 3 / 2; overflow: hidden; background: var(--bg-panel); margin-bottom: var(--space-2); }
  .ap__img img { width: 100%; height: 100%; object-fit: cover; }
  .ap__chip { position: absolute; left: 0; bottom: 0; background: var(--bg-card); color: var(--text-heading); font-size: var(--fs-xs); font-weight: var(--fw-semibold); letter-spacing: var(--ls-eyebrow); text-transform: uppercase; padding: var(--space-2) var(--space-3); }
  .ap__title { font-size: var(--fs-xl); font-weight: var(--fw-medium); }
  .ap__title a:hover { color: var(--brand-text); }
  .ap__body { font-size: var(--fs-md); color: var(--text-muted); }
  @media (max-width: 900px) { .ap__grid { grid-template-columns: 1fr; gap: var(--space-10); } }
</style>
