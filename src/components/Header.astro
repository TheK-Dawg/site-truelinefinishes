---
/**
 * HEADER (Buildings for Life template structure). Brandon's logo left on solid black (the
 * logo's own ground, so it sits seamlessly); the nav panel on the right with letter-spaced
 * links and a Services dropdown of the five hubs, then the phone number (call-first: a call
 * is a direct line to Brandon). The header is black at all times and never changes on scroll.
 * Mobile: logo, a call button and the burger; the menu carries the links and the call button.
 * The dropdown panel is anchored under its own nav item and sized to fit the viewport.
 */
import { business, nav, services } from '../data/site';
import Icon from './Icon.astro';
import CallButton from './CallButton.astro';
const path = Astro.url.pathname;
const onService = services.some((s) => path.startsWith(`/${s.slug}/`));
const isCurrent = (href: string, drop = false) => (href === '/' ? path === '/' : drop ? onService : path.startsWith(href));
const serviceLinks = services.map((s) => ({ label: s.name, href: `/${s.slug}/` }));
---
<header class="hd on-dark" data-header>
  <div class="hd__row">
    <a href="/" class="hd__brand" aria-label={`${business.name}, home`}>
      <img src="/brand/logo.webp" alt={business.name} width="960" height="252" loading="eager" />
    </a>
    <div class="hd__panel">
      <nav class="hd__nav" aria-label="Main">
        {nav.map((item) => item.drop ? (
          <div class="hd__item" data-drop>
            <a href={item.href} class="hd__link" aria-current={isCurrent(item.href, true) ? 'page' : undefined}>{item.label}</a>
            <button type="button" class="hd__caret" data-drop-btn aria-expanded="false" aria-controls="hd-drop" aria-label="Show services"><Icon name="chevronDown" size={16} /></button>
            <ul class="hd__drop" id="hd-drop">
              {serviceLinks.map((s, i) => <li><a href={s.href} class="hd__drop-link" aria-current={path === s.href ? 'page' : undefined}>{s.label}</a></li>)}
            </ul>
          </div>
        ) : <a href={item.href} class="hd__link" aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
      </nav>
      <a href={business.phoneHref} class="hd__phone" data-cta="header-call"><span class="hd__phone-ic"><Icon name="phone" size={18} /></span><span>{business.phone}</span></a>
    </div>
    <a href={business.phoneHref} class="hd__mcall" data-cta="header-call-mobile" aria-label={`Call ${business.phone}`}><Icon name="phone" size={20} /></a>
    <button class="hd__burger" type="button" data-burger aria-label="Open menu" aria-expanded="false" aria-controls="hd-menu">
      <span></span><span></span><span></span>
    </button>
  </div>
  <div class="hd__menu" id="hd-menu" data-menu hidden>
    <nav class="hd__menu-nav" aria-label="Mobile">
      {nav.map((item) => item.drop ? (
        <div class="hd__acc" data-acc>
          <div class="hd__acc-row">
            <a href={item.href} class="hd__menu-link">{item.label}</a>
            <button type="button" class="hd__acc-btn" data-acc-btn aria-expanded="false" aria-controls="hd-acc" aria-label="Show services"><Icon name="chevronDown" size={20} /></button>
          </div>
          <ul class="hd__acc-list" id="hd-acc" hidden>
            {serviceLinks.map((s) => <li><a href={s.href} class="hd__acc-link">{s.label}</a></li>)}
          </ul>
        </div>
      ) : <a href={item.href} class="hd__menu-link">{item.label}</a>)}
    </nav>
    <div class="hd__menu-actions">
      <a href="#contact" class="btn btn-primary" data-cta="menu-quote">Quick Quote Online</a>
      <CallButton cta="menu-call" />
    </div>
  </div>
</header>

<style>
  .hd { position: fixed; inset: 0 0 auto 0; z-index: 90; color: var(--text-inverse); background: var(--bg-inverse); border-bottom: 1px solid var(--border-inverse); }
  .hd__row { display: flex; align-items: stretch; justify-content: space-between; height: var(--header-row-h); padding-left: max(var(--gutter), calc((100vw - var(--container)) / 2)); }
  .hd__brand { display: flex; align-items: center; flex-shrink: 0; }
  .hd__brand img { width: var(--logo-w); height: auto; }
  .hd__panel { display: flex; align-items: center; gap: var(--space-6); background: var(--bg-inverse); padding: 0 max(var(--gutter), calc((100vw - var(--container)) / 2)) 0 var(--space-10); }
  .hd__nav { display: flex; align-self: stretch; align-items: center; gap: var(--space-6); }
  .hd__item { position: relative; display: flex; align-items: center; align-self: stretch; gap: var(--space-1); }
  .hd__caret { display: inline-flex; align-items: center; justify-content: center; width: var(--space-6); height: var(--space-6); padding: 0; background: none; border: 0; color: var(--text-inverse-muted); cursor: pointer; transition: color 0.2s var(--ease); }
  .hd__caret :global(.icon) { transition: transform 0.2s var(--ease); }
  .hd__caret:hover, .hd__item[data-open] .hd__caret { color: var(--accent-on-dark); }
  .hd__item[data-open] .hd__caret :global(.icon) { transform: rotate(180deg); }
  .hd__drop { position: absolute; top: 100%; left: calc(-1 * var(--space-6)); z-index: 1; width: max-content; max-width: calc(100vw - 2 * var(--gutter)); margin: 0; padding: var(--space-3) 0; list-style: none; background: var(--bg-inverse); border-top: 2px solid var(--accent-on-dark); box-shadow: var(--shadow-overlay); opacity: 0; visibility: hidden; transform: translateY(var(--space-2)); transition: opacity 0.18s var(--ease), transform 0.18s var(--ease), visibility 0s linear 0.18s; }
  .hd__item[data-open] .hd__drop { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }
  @media (hover: hover) {
    .hd__item:hover .hd__drop { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }
    .hd__item:hover .hd__caret :global(.icon) { transform: rotate(180deg); }
  }
  .hd__drop-link { display: block; padding: var(--space-2) var(--space-6); font-size: var(--fs-md); color: var(--text-inverse-muted); white-space: nowrap; transition: color 0.15s var(--ease), background-color 0.15s var(--ease); }
  .hd__drop-link:hover, .hd__drop-link:focus-visible, .hd__drop-link[aria-current='page'] { color: var(--text-inverse); background: var(--bg-inverse-2); }
  .hd__link { font-size: var(--fs-sm); font-weight: var(--fw-semibold); letter-spacing: var(--ls-eyebrow); text-transform: uppercase; color: var(--text-inverse-muted); padding: var(--space-2) 0; transition: color 0.2s var(--ease); }
  .hd__link:hover, .hd__link[aria-current='page'] { color: var(--accent-on-dark); }
  /* Call-first header (pass 2): the phone number sits where the Quick Quote button was. */
  .hd__phone { display: inline-flex; align-items: center; gap: var(--space-3); font-weight: var(--fw-bold); font-size: var(--fs-lg); color: var(--text-inverse); white-space: nowrap; transition: color 0.2s var(--ease); }
  .hd__phone-ic { display: grid; place-items: center; width: var(--space-10); height: var(--space-10); border-radius: var(--badge-radius); background: var(--accent-on-dark); color: var(--accent-on-dark-fg); }
  .hd__phone:hover { color: var(--accent-on-dark); }
  .hd__mcall { display: none; align-self: center; place-items: center; width: var(--tap); height: var(--tap); margin-left: auto; margin-right: var(--space-2); border-radius: var(--badge-radius); background: var(--accent-on-dark); color: var(--accent-on-dark-fg); }
  .hd__burger { display: none; align-self: center; margin-right: var(--gutter); width: var(--tap); height: var(--tap); padding: 0; background: none; border: 0; cursor: pointer; flex-direction: column; justify-content: center; align-items: center; gap: 6px; }
  .hd__burger span { display: block; width: 24px; height: 2px; background: var(--text-inverse); transition: transform 0.25s var(--ease), opacity 0.2s; }
  .hd__burger[aria-expanded='true'] span:nth-child(1) { transform: translateY(8px) rotate(45deg); }
  .hd__burger[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .hd__burger[aria-expanded='true'] span:nth-child(3) { transform: translateY(-8px) rotate(-45deg); }
  .hd__menu { position: fixed; inset: var(--header-h) 0 0 0; z-index: 89; background: var(--bg-inverse); padding: var(--space-2) var(--gutter) calc(var(--space-8) + env(safe-area-inset-bottom)); overflow-y: auto; display: none; flex-direction: column; justify-content: space-between; gap: var(--space-8); }
  .hd__menu-nav { display: flex; flex-direction: column; }
  .hd__menu-link { font-size: var(--fs-xl); font-weight: var(--fw-semibold); padding: var(--space-4) 0; border-bottom: 1px solid var(--border-inverse); }
  .hd__acc { border-bottom: 1px solid var(--border-inverse); }
  .hd__acc-row { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); }
  .hd__acc .hd__menu-link { flex: 1; border-bottom: 0; }
  .hd__acc-btn { display: inline-flex; align-items: center; justify-content: center; width: var(--tap); height: var(--tap); padding: 0; background: none; border: 0; color: var(--text-inverse); cursor: pointer; }
  .hd__acc-btn :global(.icon) { transition: transform 0.2s var(--ease); }
  .hd__acc-btn[aria-expanded='true'] :global(.icon) { transform: rotate(180deg); color: var(--accent-on-dark); }
  .hd__acc-list { margin: 0; padding: 0 0 var(--space-4) var(--space-4); list-style: none; border-left: 2px solid var(--accent-on-dark); }
  .hd__acc-link { display: block; padding: var(--space-3) 0; font-size: var(--fs-lg); color: var(--text-inverse-muted); }
  .hd__acc-link:hover { color: var(--text-inverse); }
  .hd__menu-actions { display: flex; flex-direction: column; gap: var(--space-3); }
  .hd__menu-actions :global(.btn) { width: 100%; }
  /* Burger header up to 1180px: the full nav plus the number needs ~1300px (measured). */
  @media (max-width: 1180px) {
    .hd__panel { display: none; }
    .hd__mcall { display: grid; }
    .hd__burger { display: flex; }
    .hd__menu:not([hidden]) { display: flex; }
    .hd__brand img { width: var(--logo-w-sm); }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const burger = header?.querySelector<HTMLButtonElement>('[data-burger]');
  const menu = header?.querySelector<HTMLElement>('[data-menu]');
  if (header && burger && menu) {
    const set = (open: boolean) => {
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      menu.hidden = !open;
      header.toggleAttribute('data-open', open);
      document.documentElement.style.overflow = open ? 'hidden' : '';
    };
    burger.addEventListener('click', () => set(burger.getAttribute('aria-expanded') !== 'true'));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
    window.addEventListener('resize', () => { if (window.innerWidth > 1180) set(false); });
  }

  // Desktop services dropdown: hover is CSS; the chevron toggles it for keyboard and touch.
  const drop = header?.querySelector<HTMLElement>('[data-drop]');
  const dropBtn = drop?.querySelector<HTMLButtonElement>('[data-drop-btn]');
  if (drop && dropBtn) {
    const setDrop = (open: boolean) => {
      drop.toggleAttribute('data-open', open);
      dropBtn.setAttribute('aria-expanded', String(open));
      dropBtn.setAttribute('aria-label', open ? 'Hide services' : 'Show services');
    };
    dropBtn.addEventListener('click', () => setDrop(!drop.hasAttribute('data-open')));
    drop.addEventListener('focusout', (e) => { if (!drop.contains(e.relatedTarget as Node | null)) setDrop(false); });
    document.addEventListener('click', (e) => { if (!drop.contains(e.target as Node)) setDrop(false); });
    drop.addEventListener('keydown', (e) => { if (e.key === 'Escape' && drop.hasAttribute('data-open')) { setDrop(false); dropBtn.focus(); } });
  }

  // Mobile menu: services as an accordion row.
  const accBtn = header?.querySelector<HTMLButtonElement>('[data-acc-btn]');
  const accList = header?.querySelector<HTMLElement>('#hd-acc');
  if (accBtn && accList) {
    accBtn.addEventListener('click', () => {
      const open = accBtn.getAttribute('aria-expanded') !== 'true';
      accBtn.setAttribute('aria-expanded', String(open));
      accBtn.setAttribute('aria-label', open ? 'Hide services' : 'Show services');
      accList.hidden = !open;
    });
  }
</script>
