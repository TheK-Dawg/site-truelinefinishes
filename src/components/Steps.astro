---
/**
 * HOW IT WORKS (Electrix). Pale panel on the left with the centred head and
 * three blocks (white / sand / dark, the capture's sequence), the "Looking for
 * more information?" line, and a full-height photograph on the right.
 */
import Icon from './Icon.astro';
import { image } from '../data/site';
interface Props { eyebrow?: string; heading: string; lead: string; steps: { icon: string; title: string; text: string }[]; photo?: string }
const { eyebrow = 'How It Works', heading, lead, steps, photo = 'new-build-brickwork' } = Astro.props;
const img = image(photo);
---
<section class="hw section-process" data-section="process">
  <div class="hw__grid">
    <div class="hw__panel">
      <div class="hw__inner">
        <div class="sec-head sec-head--center" data-motion="reveal">
          <p class="eyebrow">{eyebrow}</p>
          <h2 class="sec-head__h2">{heading}</h2>
          <p class="sec-head__lead">{lead}</p>
        </div>
        <ol class="hw__steps">
          {steps.map((s, i) => (
            <li class:list={['hw__step', `hw__step--${i % 3}`]} data-motion="reveal" style={`--reveal-delay: ${i * 80}ms`}>
              <span class="hw__ic"><Icon name={s.icon} size={26} /></span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))}
        </ol>
        <p class="more-line">Ready when you are. <a href="#contact" class="text-link" data-cta="steps-quote">Quick Quote Online</a></p>
      </div>
    </div>
    <div class="hw__photo"><img src={img.src} alt={img.alt} width={img.width} height={img.height} loading="lazy" decoding="async" /></div>
  </div>
</section>

<style>
  .hw__grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 3fr); gap: var(--space-5); }
  .hw__panel { background: var(--bg-panel); padding: var(--section-pad) var(--gutter); display: flex; justify-content: flex-end; }
  .hw__inner { width: 100%; max-width: calc(var(--container) * 0.64); }
  .hw__steps { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-5); }
  .hw__step { padding: var(--space-8) var(--space-6); text-align: center; display: flex; flex-direction: column; align-items: center; gap: var(--space-3); }
  .hw__step h3 { font-size: var(--fs-xl); font-weight: var(--fw-medium); }
  .hw__step p { font-size: var(--fs-md); }
  .hw__step--0 { background: var(--bg-card); color: var(--text-muted); }
  .hw__step--1 { background: var(--brand-primary); color: var(--forest-800); }
  .hw__step--2 { background: var(--bg-inverse); color: var(--text-inverse-muted); }
  .hw__step--2 h3 { color: var(--text-inverse); }
  .hw__ic { display: grid; place-items: center; width: var(--icon-circle); height: var(--icon-circle); border-radius: var(--badge-radius); margin-bottom: var(--space-2); }
  .hw__step--0 .hw__ic { background: var(--n-500); color: var(--text-inverse); }
  .hw__step--1 .hw__ic { background: var(--bg-inverse-deep); color: var(--accent-on-dark); }
  .hw__step--2 .hw__ic { background: var(--brand-primary); color: var(--brand-fg); }
  .hw__photo { position: relative; min-height: var(--space-30); }
  .hw__photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 1023px) {
    .hw__grid { grid-template-columns: 1fr; gap: 0; }
    .hw__inner { max-width: none; }
    .hw__photo { display: none; }
  }
  @media (max-width: 760px) { .hw__steps { grid-template-columns: 1fr; } }
</style>
