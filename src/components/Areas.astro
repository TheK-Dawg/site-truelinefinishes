---
/**
 * WHERE TO FIND US (home areas section; operator round 2, 5 Nov 2026). Plain text on the page:
 * no box, no border, no card background, the places as a plain sentence-style list. The map is
 * Brandon's REAL Google listing, embedded by CID (MapEmbed default, the same embed as /contact/),
 * full width and auto-loading. The plan wants NO Areas page and no town pages, so nothing here
 * links to one.
 */
import MapEmbed from './MapEmbed.astro';
import { mainPlaces } from '../data/site';
interface Props { heading: string; body: string }
const { heading, body } = Astro.props;
---
<section class="ar section section-areas" data-section="areas">
  <div class="ar__inner container">
    <div class="ar__copy" data-motion="reveal">
      <h2 class="ar__h2">{heading}</h2>
      <p class="ar__body">{body}</p>
      <ul class="ar__list" aria-label="Main places served">{mainPlaces.map((t) => <li>{t}</li>)}</ul>
    </div>
    <div class="ar__map" data-motion="reveal" style="--reveal-delay: 80ms"><MapEmbed /></div>
  </div>
</section>

<style>
  .ar__inner { display: grid; grid-template-columns: 1fr; gap: var(--space-8); }
  .ar__h2 { font-size: var(--fs-4xl); margin-bottom: var(--space-4); }
  .ar__body { color: var(--text-muted); max-width: 80ch; }
  .ar__map { width: 100%; height: calc(var(--space-30) * 3.5); }
  .ar__list { list-style: none; padding: 0; margin-top: var(--space-5); display: flex; flex-wrap: wrap; gap: var(--space-1) 0; font-weight: var(--fw-semibold); color: var(--text-primary); }
  .ar__list li:not(:last-child)::after { content: '·'; margin: 0 var(--space-3); color: var(--text-muted); }
  @media (max-width: 900px) { .ar__h2 { font-size: var(--fs-3xl); } .ar__map { height: calc(var(--space-30) * 2.5); } }
</style>
