---
/**
 * QUOTE FORM (the closing form band: copy left, the white form card right; Home 3 design).
 *
 * FORMLANE DIRECT EMBED (Formlane law, client site): the card is the Formlane slot for
 * "TrueLine Finishes — Quick Quote Online" (form ref truelinefinishes-quick-quote-online-form,
 * public id f_5ELbk5JcKfFh2EEaclT6, Live, allowed on truelinefinishes.com, www and the
 * workers.dev preview). form.js from api.formlane.uk renders the fields; the token is public
 * and cannot read leads. New site, so no old-form fallback.
 * FIELDS: the DEFAULT quick-quote form (operator round 2, 5 Nov 2026, overriding Brandon's 28 Oct
 * list; DECISIONS R2-10): name, email, phone (below email), postcode, short description of the
 * job. No "Type of work" or "Home owner or tenant" dropdowns. Set in Formlane (form version 3). Labels are visually
 * hidden (placeholders show), the house pattern. Leads go to the agency inbox only for now.
 * After sending, Formlane redirects to /thank-you/ with the first name.
 * The slot carries id="contact", so every #contact link lands on the form itself.
 * HOME 3 DESIGN (operator, 19 Nov 2026: Home 3 is the site's design): Home 3's form band, the Dom
 * reference's subscribe band. Pale mist band; heading, lead, the three selling points, the slimline,
 * HEADING (operator review 4, 19 Nov 2026): "You say 'Tell us about the job' and then say a call is
 * a direct line to Brandon. That's fine. You can keep that there." The service pages keep their own
 * headings, which the operator reviewed and approved in the same pass.
 * the Call pill and the hours on the left (dark text); the white form card with pill fields and the
 * royal pill submit on the right. No WhatsApp button in the form section (operator round 3 on Home 3;
 * the floating button and the footer keep WhatsApp). DECISIONS H3-*.
 * SLIMLINE Trustindex widget (operator, 6 Nov 2026; moved round 3): in the LEFT column, under the
 * selling points and above the Call button, its own dark text on the pale band. Never inside the
 * white form card ("you don't put it where the form itself is").
 */
import Icon from './Icon.astro';
import CallButton from './CallButton.astro';
import TrustindexSlot from './TrustindexSlot.astro';
import { business } from '../data/site';
import Hours from './Hours.astro';
interface Props { heading?: string; lead?: string }
const {
  heading = 'Tell Us About the Job',
  lead = 'Leave your name, email, phone number and postcode, with a line or two about the job. TrueLine Finishes will talk it through with you and give you a free quotation.',
} = Astro.props;
const FORMLANE_FORM = 'f_5ELbk5JcKfFh2EEaclT6';
const FORMLANE_TOKEN = 'npGnYEsjXAHrYRp13No3gA';
---
<section class="qf section-quote-form" id="quote-section" data-section="quote-form" data-ai-skip>
  <div class="qf__inner container">
    <div class="qf__copy" data-motion="reveal">
      <h2 class="qf__h2">{heading}</h2>
      <p class="qf__p">{lead}</p>
      <ul class="qf__list">
        <li><Icon name="check" size={16} /> Free quotations</li>
        <li><Icon name="check" size={16} /> Sanding, filling and caulking on every job</li>
        <li><Icon name="check" size={16} /> Fully insured, over eight years' experience</li>
      </ul>
      <TrustindexSlot role="slimline" place="slim-form" class="qf__ti" />
      <div class="qf__call">
        <CallButton cta="form-call" tone="light" />
      </div>
      <div class="qf__hours"><p class="qf__hours-h"><Icon name="clock" size={16} /> Opening hours</p><Hours class="qf__hrs" /></div>
    </div>
    <div class="qf__card">
      <h3 class="qf__form-h">Quick Quote Online</h3>
      <div class="qf__form" id="contact" data-quote-card data-lead-form={FORMLANE_FORM} data-lf-token={FORMLANE_TOKEN}>
        <noscript><p class="qf__nojs">The quote form needs JavaScript. Call <a href={business.phoneHref}>{business.phone}</a> instead.</p></noscript>
      </div>
      <p class="qf__secure"><Icon name="lock" size={15} /> Any submission through this form is secure. We do not sell your details to third parties.</p>
    </div>
    <script is:inline src="https://api.formlane.uk/edge/form.js" defer></script>
  </div>
</section>

<style>
  .qf { background: var(--bg-band); color: var(--text-secondary); padding: var(--section-pad) 0; }
  .qf__inner { display: grid; grid-template-columns: minmax(0, 1fr) var(--form-w); gap: var(--space-12) var(--space-16); align-items: start; }
  .qf__h2 { font-size: var(--fs-5xl); line-height: 1.12; margin-bottom: var(--space-5); }
  .qf__p { color: var(--text-secondary); margin-bottom: var(--space-6); max-width: 54ch; }
  .qf__list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--space-3); }
  .qf__list li { display: flex; align-items: center; gap: var(--space-3); color: var(--text-primary); }
  .qf__list :global(.icon) { color: var(--brand-primary); flex-shrink: 0; }
  .qf__copy :global(.qf__ti) { margin-top: var(--space-6); }
  .qf__call { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-6); }
  .qf__hours { margin-top: var(--space-5); }
  .qf__hours-h { display: flex; align-items: center; gap: var(--space-2); margin-bottom: var(--space-2); color: var(--text-primary); font-weight: var(--fw-semibold); }
  .qf__hours-h :global(.icon) { color: var(--brand-primary); flex-shrink: 0; }
  .qf__hours :global(.qf__hrs) { padding-left: calc(16px + var(--space-2)); max-width: 22em; color: var(--text-muted); }
  .qf__hours :global(.qf__hrs dd) { color: var(--text-primary); }
  .qf__card { padding: var(--space-8); background: var(--bg-card); color: var(--text-primary); box-shadow: var(--shadow-raised); }
  .qf__form-h { font-size: var(--fs-2xl); margin-bottom: var(--space-3); }
  .qf__form { scroll-margin-top: calc(var(--header-h) + var(--space-4)); min-height: calc(var(--space-30) * 3); }
  .qf__nojs { color: var(--text-primary); }
  .qf__nojs a { color: var(--brand-text); font-weight: var(--fw-semibold); }
  .qf__secure { display: flex; gap: var(--space-2); align-items: flex-start; margin-top: var(--space-4); font-size: var(--fs-sm); line-height: var(--lh-normal); color: var(--text-muted); }
  .qf__secure :global(.icon) { color: var(--brand-primary); flex-shrink: 0; margin-top: 1px; }
  /* The Formlane form (form.js) in Home 3's pill fields. Every field full width and stacked (house form law). */
  .qf__form :global(.lf-f) { gap: var(--space-3); }
  .qf__form :global(.lf-f > .lf-w) { grid-column: 1 / -1; }
  /* Formlane's own privacy line is replaced by the brief's security line under the card. */
  .qf__form :global(.lf-k) { display: none; }
  .qf__form :global(.lf-i) { min-height: var(--input-h); padding: var(--space-3) var(--space-6); font: inherit; font-size: var(--fs-base); color: var(--text-primary); background: var(--bg-subtle); border: 1px solid var(--border-default); border-radius: var(--input-radius); }
  .qf__form :global(textarea.lf-i) { min-height: calc(var(--space-30) - var(--space-4)); border-radius: var(--v-radius-card); resize: vertical; }
  .qf__form :global(.lf-i::placeholder) { color: var(--text-muted); opacity: 1; }
  .qf__form :global(.lf-i:focus) { outline: 2px solid var(--brand-primary); outline-offset: 1px; border-color: var(--brand-primary); }
  /* form.js ships the button with uneven padding (twice as much below as above), which pushed the label
     about 5 pixels high (measured live, round 2). Even padding + the cap trim centre it (a <button> centres its own content; flex would disable the trim). */
  .qf__form :global(.lf-b) { display: block; padding: 0 var(--space-6); width: 100%; min-height: var(--btn-h-lg); border: 0; border-radius: var(--btn-radius); background: var(--brand-primary); color: var(--brand-fg); font: inherit; font-family: var(--font-heading); font-size: var(--fs-md); font-weight: var(--fw-medium); line-height: var(--lh-tight); text-box: trim-both cap alphabetic; cursor: pointer; }
  .qf__form :global(.lf-b:hover) { background: var(--brand-hover); }
  .qf__form :global(.lf-x), .qf__form :global(.lf-e) { color: var(--status-negative); }
  @media (max-width: 1023px) { .qf__inner { grid-template-columns: 1fr; } }
  @media (max-width: 760px) { .qf__h2 { font-size: var(--fs-3xl); } .qf__card { padding: var(--space-6) var(--space-4); } .qf__call :global(.btn) { width: 100%; } }
</style>
