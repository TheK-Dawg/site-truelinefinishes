---
/**
 * "<HUB> IN PICTURES" (plan, Layout). TrueLine Finishes' own photos for the hub, each opening in the
 * root Lightbox. Captions describe the photo only.
 * OPERATOR REVIEW 4 (19 Nov 2026): "If you're going to do the gallery, do the gallery on these pages
 * the same as you've done on the gallery page itself. Images should be square and they should have
 * spaces between them. They shouldn't all be next to each other." So this is the gallery page's own
 * treatment: square tiles with gaps, four across on a desktop, three on a tablet, two on a phone.
 */
import { image, stockImages } from '../data/site';
interface Props { heading: string; lead: string; images: string[] }
const { heading, lead, images } = Astro.props;
const list = images.map(image);
// STOCK (fencing, 26 Nov 2026): a band that shows credited stock photographs carries their
// attribution directly under the grid (title, author, licence, source), plus the full list on
// /image-credits/. Brandon's own photographs need no credit line, so other hubs are unchanged.
const credits = images.map((k) => stockImages.find((s) => s.key === k)).filter((s) => s !== undefined);
---
<section class="pg section section-pictures" data-section="pictures">
  <div class="container">
    <div class="dm-head" data-motion="reveal"><h2 class="dm-h2">{heading}</h2><p class="dm-lead">{lead}</p></div>
    <ul class:list={['pg__grid', list.length === 1 && 'pg__grid--one']} data-gallery>
      {list.map((im) => (
        <li><button type="button" class="pg__shot" data-lightbox aria-label={`Open larger: ${im.alt}`}><img src={im.sm} data-full={im.src} alt={im.alt} width={im.width} height={im.height} loading="lazy" decoding="async" /></button></li>
      ))}
    </ul>
    {credits.length > 0 && (
      <p class="pg__credit" data-stock-credits>
        Photographs:{' '}
        {credits.map((c, i) => (
          <span><a href={c.sourcePage} target="_blank" rel="noopener nofollow">{c.title}</a> by {c.author}, <a href={c.licenceUrl} target="_blank" rel="noopener nofollow license">{c.licence}</a>{i < credits.length - 1 ? '; ' : '. '}</span>
        ))}
        Resized from the originals. Full details on the <a href="/image-credits/">image credits page</a>.
      </p>
    )}
  </div>
</section>
<style>
  .pg__grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-3); }
  .pg__grid--one { grid-template-columns: minmax(0, calc(var(--narrow) / 2)); justify-content: center; }
  .pg__shot { display: block; width: 100%; padding: 0; border: 0; cursor: zoom-in; overflow: hidden; background: var(--bg-panel); aspect-ratio: 1; }
  .pg__shot img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease), opacity 0.3s var(--ease); }
  .pg__shot:hover img { transform: scale(1.04); opacity: 0.9; }
  .pg__credit { margin-top: var(--space-5); font-size: var(--fs-sm); line-height: var(--lh-relaxed); color: var(--text-secondary); }
  .pg__credit a { color: var(--brand-text); }
  @media (max-width: 900px) { .pg__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .pg__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-2); } }
</style>
