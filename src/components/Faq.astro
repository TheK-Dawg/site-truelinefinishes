---
/**
 * FAQ (template accordion). Native <details>, first open, every item can stay open.
 * Answers are plain text / light HTML. The page emits the FAQPage schema.
 */
interface Props { items: { q: string; a: string }[]; heading: string; lead?: string; id?: string }
const { items, heading, lead = '', id = 'faq' } = Astro.props;
---
<section class="fq section section-faq" id={id} data-section="faq">
  <div class="fq__inner container">
    <div class="fq__head" data-motion="reveal">
      <h2 class="fq__h2">{heading}</h2>
      {lead && <p class="fq__lead">{lead}</p>}
      <p class="fq__more">Question not here? Call Brandon on <a href="tel:+447949484274" class="text-link" data-cta="faq-call">07949 484274</a>.</p>
    </div>
    <div class="fq__list">
      {items.map((f, i) => (
        <details class="fq__item" open={i === 0} data-motion="reveal" style={`--reveal-delay: ${Math.min(i, 5) * 50}ms`}>
          <summary><span>{f.q}</span><span class="fq__plus" aria-hidden="true"></span></summary>
          <div class="fq__a" set:html={f.a} />
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .fq__inner { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: var(--space-16); align-items: start; }
  .fq__head { position: sticky; top: calc(var(--header-h) + var(--space-6)); }
  .fq__h2 { font-size: var(--fs-4xl); margin-bottom: var(--space-4); }
  .fq__lead { color: var(--text-muted); margin-bottom: var(--space-4); }
  .fq__more { font-size: var(--fs-md); color: var(--text-muted); }
  .fq__all { margin-top: var(--space-2); }
  .fq__list { border-top: 1px solid var(--border-default); }
  .fq__item { border-bottom: 1px solid var(--border-default); }
  .fq__item summary { list-style: none; display: flex; justify-content: space-between; gap: var(--space-6); align-items: center; padding: var(--space-6) 0; cursor: pointer; font-size: var(--fs-lg); font-weight: var(--fw-semibold); color: var(--text-heading); }
  .fq__item summary::-webkit-details-marker { display: none; }
  .fq__plus { position: relative; flex-shrink: 0; width: var(--space-8); height: var(--space-8); background: var(--bg-panel); border-radius: var(--badge-radius); }
  .fq__plus::before, .fq__plus::after { content: ''; position: absolute; left: 50%; top: 50%; width: var(--space-3); height: 2px; background: var(--text-heading); transform: translate(-50%, -50%); transition: transform 0.2s var(--ease); }
  .fq__plus::after { transform: translate(-50%, -50%) rotate(90deg); }
  .fq__item[open] .fq__plus { background: var(--brand-primary); }
  .fq__item[open] .fq__plus::before, .fq__item[open] .fq__plus::after { background: var(--brand-fg); }
  .fq__item[open] .fq__plus::after { transform: translate(-50%, -50%) rotate(0deg); }
  .fq__a { padding: 0 var(--space-12) var(--space-6) 0; color: var(--text-primary); }
  @media (max-width: 900px) { .fq__inner { grid-template-columns: 1fr; gap: var(--space-8); } .fq__head { position: static; } .fq__h2 { font-size: var(--fs-3xl); } .fq__a { padding-right: 0; } .fq__item summary { font-size: var(--fs-base); } }
</style>
