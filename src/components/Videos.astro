---
/**
 * BRANDON'S VIDEOS (operator, 19 Nov 2026: "include the two Brandon YouTube links as normal
 * responsive video embeds on the site; the full video was suggested for the homepage, and the short
 * should sit appropriately with it"). This supersedes R2-13 ("no YouTube embed anywhere") for these
 * two videos only, on the home page only. The links are exactly the two Brandon sent (plan, Video);
 * no other video is embedded.
 *  - the full video (16:9): "Full house panting and decorating #harrogate" on YouTube, captioned with
 *    the typing slip corrected (plan, Video: "Captions use painting");
 *  - the Short (9:16, portrait) beside it, the same height on desktop, under it on mobile:
 *    "Full kitchen renovation". Introduced by its YouTube title alone, never as a kitchen-fitting
 *    service (plan, standing prohibition 9).
 * PRIVACY: youtube-nocookie.com (YouTube's privacy-enhanced mode: no YouTube cookies until a visitor
 * plays a video), loading="lazy", no autoplay. The Cookie Policy and Privacy Policy say so.
 * Both ids were checked public and embeddable through YouTube's oEmbed endpoint on 19 Nov 2026.
 */
import { business, videos } from '../data/site';
const list = [
  { ...videos.house, wide: true },
  { ...videos.kitchen, wide: false },
];
---
<section class="vd section section-videos" id="videos" data-section="videos">
  <div class="container">
    <div class="dm-head dm-head--c" data-motion="reveal">
      <h2 class="dm-h2">Watch Brandon at Work</h2>
      <p class="dm-lead">Two of Brandon’s own videos from his YouTube channel: a full house painted and decorated, and a kitchen from start to finish.</p>
    </div>
    <div class="vd__grid">
      {list.map((v) => (
        <figure class:list={['vd__item', v.wide ? 'vd__item--wide' : 'vd__item--short']} data-video={v.id}>
          <div class="vd__frame">
            <iframe src={`https://www.youtube-nocookie.com/embed/${v.id}?rel=0`} title={`${v.caption} (TrueLine Finishes on YouTube)`} loading="lazy" allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
          </div>
          <figcaption class="vd__cap">{v.caption}</figcaption>
        </figure>
      ))}
    </div>
    <p class="vd__more"><a href={business.youtube} class="dm-link" target="_blank" rel="noopener" data-cta="videos-channel">TrueLine Finishes on YouTube</a></p>
  </div>
</section>

<style>
  .vd { background: var(--bg-panel); }
  /* Columns in proportion to the two aspect ratios (16:9 and 9:16), so both frames are the same height. */
  .vd__grid { display: grid; grid-template-columns: minmax(0, 16fr) minmax(0, 5.0625fr); gap: var(--space-6); align-items: start; }
  .vd__item { margin: 0; }
  .vd__frame { position: relative; overflow: hidden; background: var(--bg-inverse); }
  .vd__item--wide .vd__frame { aspect-ratio: 16 / 9; }
  .vd__item--short .vd__frame { aspect-ratio: 9 / 16; }
  .vd__frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .vd__cap { margin-top: var(--space-3); font-family: var(--font-heading); font-size: var(--fs-md); color: var(--text-primary); }
  .vd__more { margin-top: var(--space-8); text-align: center; }
  @media (max-width: 900px) {
    .vd__grid { grid-template-columns: 1fr; gap: var(--space-8); }
    .vd__item--short { width: 100%; max-width: calc(var(--space-30) * 3); justify-self: center; }
  }
</style>
