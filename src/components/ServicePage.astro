---
/**
 * SERVICE HUB PAGE (plan, Layout, Hub pages), in this order: the home-style hero with the hub's
 * picture as its background (operator round 2, fix 12: no right-hand image); the
 * reviews section (template: directly under the hero on every page); intro; what the job covers
 * (the seed's sections, each photo above its H2) and the `sectors:` line; how a job runs (no
 * before-and-after slider anywhere: operator, 5 Nov 2026, "I never do before and after"); "<hub> in pictures";
 * the other hubs as related links (NO YouTube embed: operator round 2, fix 13); FAQ; the quote form; further reading (the
 * hub's town articles). Landing page, never article-styled.
 */
import Base from '../layouts/Base.astro';
import PageHero from './PageHero.astro';
import Reviews from './Reviews.astro';
import ServiceBody from './ServiceBody.astro';
import Steps from './Steps.astro';
import PicturesGrid from './PicturesGrid.astro';
import RelatedServices from './RelatedServices.astro';
import Faq from './Faq.astro';
import QuoteForm from './QuoteForm.astro';
import FurtherReading from './FurtherReading.astro';
import { services, business, towns, image } from '../data/site';
import { stripTags } from '../lib/links';

interface Props { content: import('../data/services/types').ServiceContent }
const { content } = Astro.props;
const svc = services.find((s) => s.slug === content.slug)!;
const hero = image(content.heroImage);
const pageUrl = `${business.url}/${content.slug}/`;
const icons = ['chat', 'clipboard', 'roller'];
const steps = content.process.steps.map((s, i) => ({ icon: icons[i], title: s.title, text: s.body }));
const schema = [
  { '@type': 'Service', '@id': `${pageUrl}#service`, name: svc.name, serviceType: svc.name, description: content.description, url: pageUrl, image: new URL(hero.src, business.url).href, provider: { '@id': `${business.url}/#business` }, areaServed: towns.map((t) => ({ '@type': 'Place', name: t.name })) },
  { '@type': 'FAQPage', '@id': `${pageUrl}#faq`, mainEntity: content.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: stripTags(f.a) } })) },
  { '@type': 'BreadcrumbList', '@id': `${pageUrl}#crumbs`, itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${business.url}/` },
    { '@type': 'ListItem', position: 2, name: svc.name, item: pageUrl },
  ] },
];
---
<Base title={content.metaTitle} description={content.description} page={`service-${content.slug}`} schema={schema} ogImage={hero.src}>
  <PageHero h1={content.h1} lead={content.lead} image={hero} />
  <Reviews />
  <ServiceBody intro={content.intro} sections={content.sections} sectorsLine={content.sectorsLine} />
  <Steps heading={content.process.heading} lead={content.process.lead} steps={steps} photo={content.sections[0].image} />
  <PicturesGrid heading={content.pictures.heading} lead={content.pictures.lead} images={content.pictures.images} />
  <RelatedServices picks={content.related} heading="Other services from TrueLine Finishes" />
  <Faq items={content.faqs} heading={`${svc.name}: questions people ask`} />
  <QuoteForm heading={content.quote.heading} lead={content.quote.lead} />
  <FurtherReading hub={content.slug} hubName={svc.name} />
</Base>
