---
/**
 * HOME HERO (Electrix). Full-bleed photograph under a deep green overlay,
 * sand eyebrow, H1, Quick Quote Online + the Call button (CallButton, same
 * box as Quick Quote, glass fill), the slim white TrustIndex widget directly
 * under them (pass 2: it replaced the Google review link line), then three glass info
 * cards on the bottom edge (the middle one highlighted, as in the capture).
 * SLOTS: data-hero-video marks where the background video goes (A2, not
 * built); the BBC card links out once slots.bbcVideoUrl is set (A3).
 */
import Icon from './Icon.astro';
import TiSlim from './TiSlim.astro';
import CallButton from './CallButton.astro';
import { facts, slots } from '../data/site';
interface Props { eyebrow: string; h1: string; lead: string; image: { src: string; alt: string } }
const { eyebrow, h1, lead, image } = Astro.props;
const bbc = slots.bbcVideoUrl;
const bbcExternal = /^https?:/.test(bbc);
---
<section class="hero on-dark section-hero" data-section="hero">
  <img class="hero__bg" src={image.src} alt="" width="1600" height="1000" fetchpriority="high" decoding="async" data-hero-video={slots.heroVideo} />
  <div class="hero__inner container">
    <div class="hero__copy">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="hero__h1">{h1}</h1>
      <p class="hero__lead">{lead}</p>
      <div class="hero__actions">
        <a href="#contact" class="btn btn-primary hero__btn" data-cta="hero-quote">Quick Quote Online</a>
        <CallButton cta="hero-call" class="hero__btn" />
      </div>
      <div class="hero__strip"><TiSlim where="hero" /></div>
    </div>
    <ul class="hero__cards">
      <li class="hero__card"><span class="hero__ic"><Icon name="bricks" /></span><div><h2>40+ Years</h2><p>{facts.yearsLine}.</p></div></li>
      <li class="hero__card hero__card--on"><span class="hero__ic"><Icon name="shield" /></span><div><h2>10-Year Warranty</h2><p>On new builds.</p></div></li>
      <li class="hero__card" data-bbc-link={bbc}>
        <span class="hero__ic"><Icon name="tv" /></span>
        <div>
          <h2>{bbc ? <a href={bbc} class="hero__bbc" data-cta="hero-bbc" target={bbcExternal ? '_blank' : undefined} rel={bbcExternal ? 'noopener' : undefined}>As Seen on BBC</a> : 'As Seen on BBC'}</h2>
          <p>Featured on BBC Building Dream Homes.</p>
        </div>
      </li>
    </ul>
  </div>
</section>

<style>
  .hero { position: relative; isolation: isolate; overflow: hidden; background: var(--bg-inverse-deep); color: var(--text-inverse-muted); padding-top: calc(var(--header-h) + var(--space-24)); }
  .hero__bg { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; filter: saturate(0.85); }
  .hero::before { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--overlay-hero); }
  .hero__copy { max-width: var(--copy-max); }
  .hero__h1 { color: var(--text-inverse); font-size: var(--fs-6xl); font-weight: var(--fw-medium); line-height: 1.12; margin-bottom: var(--space-6); }
  .hero__lead { font-size: var(--fs-lg); max-width: 56ch; margin-bottom: var(--space-10); }
  .hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4); }
  .hero__actions :global(.hero__btn) { min-height: var(--btn-h-lg); }
  .hero__bbc { text-decoration: underline; text-decoration-color: var(--border-inverse); text-underline-offset: 4px; }
  .hero__bbc:hover { color: var(--accent-on-dark); }
  /* REV3 follow-up: desktop only. On mobile the review line lives in the white
     strip under the header (HeaderReviews), so the first screen shows it once. */
  .hero__strip { margin-top: var(--space-6); }
  /* Mobile: collapsed to nothing and clipped, NOT display:none. TrustIndex only ever
     renders this widget if its box is laid out in the first screen, and this slot is
     the loader host that TiSlim copies into the form and footer strips. */
  @media (max-width: 1023px) { .hero__strip { height: 0; margin: 0; overflow: hidden; } }
  .hero__cards { list-style: none; padding: 0; margin-top: var(--space-24); display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-8); }
  .hero__card { display: flex; gap: var(--space-5); align-items: flex-start; padding: var(--space-8) var(--space-6); background: var(--glass); border-top: 2px solid var(--border-inverse); }
  .hero__card--on { border-top-color: var(--brand-primary); }
  .hero__card h2 { font-size: var(--fs-xl); font-weight: var(--fw-medium); margin-bottom: var(--space-1); }
  .hero__card p { font-size: var(--fs-md); }
  .hero__ic { display: grid; place-items: center; width: var(--icon-circle); height: var(--icon-circle); flex-shrink: 0; border-radius: var(--badge-radius); background: var(--glass-strong); color: var(--text-inverse); }
  .hero__card--on .hero__ic { background: var(--brand-primary); color: var(--brand-fg); }
  @media (max-width: 1023px) { .hero__h1 { font-size: var(--fs-5xl); } .hero__cards { grid-template-columns: 1fr; gap: var(--space-3); margin-top: var(--space-16); } }
  @media (max-width: 640px) {
    .hero { padding-top: calc(var(--header-h) + var(--space-10)); }
    .hero__h1 { font-size: var(--fs-4xl); }
    .hero__lead { font-size: var(--fs-base); margin-bottom: var(--space-6); }
    .hero__actions :global(.hero__btn) { width: 100%; }
    .hero__card { padding: var(--space-5) var(--space-4); }
    .hero__ic { width: var(--space-12); height: var(--space-12); }
  }
</style>
