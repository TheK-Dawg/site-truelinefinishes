---
/**
 * HOME HERO. Black band (plan, Layout), Brandon's own asks (23 Oct: "call to action and quote
 * form and phone number with the video at the top"): the headline about painting and decorating
 * for homes and businesses, the call to action, the phone number, his kitchen Short beside it
 * (portrait, Brandon's pick, home page only, captioned with its title) and the quote form.
 * Desktop: copy | video | form. Mobile: copy, then the video, then the form.
 * The form here is the home page's one form (id="contact"); every #contact link lands on it.
 */
import Icon from './Icon.astro';
import CallButton from './CallButton.astro';
import VideoEmbed from './VideoEmbed.astro';
import { business, ctaLine } from '../data/site';
interface Props { h1: string; lead: string }
const { h1, lead } = Astro.props;
const FORMLANE_FORM = 'f_5ELbk5JcKfFh2EEaclT6';
const FORMLANE_TOKEN = 'npGnYEsjXAHrYRp13No3gA';
---
<section class="hero on-dark section-hero" data-section="hero">
  <div class="hero__inner container">
    <div class="hero__copy">
      <img class="hero__logo" src="/brand/logo.webp" alt="" width="960" height="252" />
      <h1 class="hero__h1">{h1}</h1>
      <p class="hero__lead">{lead}</p>
      <p class="hero__ctaline">{ctaLine}</p>
      <div class="hero__actions">
        <a href="#contact" class="btn btn-primary hero__btn" data-cta="hero-quote">Quick Quote Online</a>
        <CallButton cta="hero-call" class="hero__btn" />
      </div>
      <ul class="hero__usps">
        <li><Icon name="check" size={18} /> Over eight years' experience</li>
        <li><Icon name="check" size={18} /> Fully insured</li>
        <li><Icon name="check" size={18} /> Brandon on every job</li>
      </ul>
      <p class="hero__reviews"><a href="#reviews" data-cta="hero-reviews"><Icon name="star" size={16} /> Read what customers say on Google</a></p>
    </div>
    <div class="hero__video"><VideoEmbed which="kitchen" eager /></div>
    <div class="hero__card">
      <h2 class="hero__form-h">Quick Quote Online</h2>
      <div class="hero__form" id="contact" data-quote-card data-lead-form={FORMLANE_FORM} data-lf-token={FORMLANE_TOKEN}>
        <noscript><p>The quote form needs JavaScript. Call Brandon on <a href={business.phoneHref}>{business.phone}</a> instead.</p></noscript>
      </div>
      <p class="hero__secure"><Icon name="lock" size={15} /> Any submission through this form is secure. We do not sell your details to third parties.</p>
      <script is:inline src="https://api.formlane.uk/edge/form.js" defer></script>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; background: var(--bg-inverse); color: var(--text-inverse-muted); padding: calc(var(--header-h) + var(--space-12)) 0 var(--space-16); }
  .hero__inner { display: grid; grid-template-columns: minmax(0, 1fr) var(--hero-video-w) var(--hero-form-w); gap: var(--space-8); align-items: start; }
  .hero__logo { width: var(--logo-hero-w); margin-bottom: var(--space-6); }
  .hero__h1 { color: var(--text-inverse); font-size: var(--fs-5xl); line-height: 1.1; margin-bottom: var(--space-5); }
  .hero__lead { font-size: var(--fs-lg); max-width: 52ch; margin-bottom: var(--space-4); }
  .hero__ctaline { color: var(--text-inverse); font-weight: var(--fw-semibold); margin-bottom: var(--space-6); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .hero__actions :global(.hero__btn) { min-height: var(--btn-h-lg); }
  .hero__usps { list-style: none; padding: 0; margin-top: var(--space-6); display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); color: var(--text-inverse); font-size: var(--fs-md); }
  .hero__usps li { display: flex; gap: var(--space-2); align-items: center; }
  .hero__usps :global(.icon) { color: var(--accent-on-dark); }
  .hero__reviews { margin-top: var(--space-5); font-size: var(--fs-md); }
  .hero__reviews a { display: inline-flex; gap: var(--space-2); align-items: center; color: var(--text-inverse); text-decoration: underline; text-decoration-color: var(--accent-on-dark); text-underline-offset: 4px; }
  .hero__reviews :global(.icon) { color: var(--accent-on-dark); }
  .hero__card { background: var(--bg-card); color: var(--text-primary); padding: var(--space-6); border-top: 3px solid var(--accent-on-dark); }
  .hero__form-h { font-size: var(--fs-xl); color: var(--text-heading); margin-bottom: var(--space-4); }
  .hero__form { min-height: calc(var(--space-30) * 3); scroll-margin-top: calc(var(--header-h) + var(--space-3)); }
  .hero__form noscript a { color: var(--brand-text); font-weight: var(--fw-semibold); }
  .hero__secure { display: flex; gap: var(--space-2); align-items: flex-start; margin-top: var(--space-3); font-size: var(--fs-sm); color: var(--text-muted); line-height: var(--lh-normal); }
  .hero__secure :global(.icon) { color: var(--brand-text); flex-shrink: 0; margin-top: 1px; }
  .hero__form :global(.lf-f) { gap: var(--space-3); }
  .hero__form :global(.lf-i) { min-height: var(--input-h); padding: var(--space-3) var(--space-4); font: inherit; font-size: var(--fs-base); color: var(--text-primary); background: var(--bg-card); border: 1px solid var(--border-strong); border-radius: var(--input-radius); }
  .hero__form :global(textarea.lf-i) { min-height: calc(var(--space-20) + var(--space-4)); resize: vertical; }
  .hero__form :global(.lf-i::placeholder) { color: var(--text-muted); opacity: 1; }
  .hero__form :global(.lf-i:focus) { outline: 2px solid var(--brand-primary); outline-offset: 1px; border-color: var(--brand-primary); }
  .hero__form :global(.lf-b) { width: 100%; min-height: var(--btn-h-lg); border: 0; border-radius: var(--btn-radius); background: var(--brand-primary); color: var(--brand-fg); font: inherit; font-size: var(--fs-md); font-weight: var(--fw-semibold); letter-spacing: var(--ls-eyebrow); text-transform: uppercase; cursor: pointer; }
  .hero__form :global(.lf-b:hover) { background: var(--brand-hover); }
  .hero__form :global(.lf-x), .hero__form :global(.lf-e) { color: var(--status-negative); }
  @media (max-width: 1180px) { .hero__inner { grid-template-columns: minmax(0, 1fr) var(--hero-video-w-md) var(--hero-form-w-md); gap: var(--space-6); } .hero__h1 { font-size: var(--fs-4xl); } }
  @media (max-width: 1023px) {
    .hero__inner { grid-template-columns: minmax(0, 1fr) var(--hero-video-w); }
    .hero__card { grid-column: 1 / -1; }
  }
  @media (max-width: 760px) {
    .hero { padding-top: calc(var(--header-h) + var(--space-8)); }
    .hero__inner { grid-template-columns: 1fr; }
    .hero__logo { width: var(--logo-hero-w-sm); }
    .hero__h1 { font-size: var(--fs-3xl); }
    .hero__lead { font-size: var(--fs-base); }
    .hero__actions :global(.hero__btn) { width: 100%; }
    .hero__video { max-width: var(--video-portrait-w); width: 100%; margin-inline: auto; }
    .hero__card { padding: var(--space-5) var(--space-4); }
  }
</style>
