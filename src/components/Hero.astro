---
/**
 * HERO, ONE PATTERN ON EVERY PAGE, in the HOME 3 design (operator, 19 Nov 2026: Home 3 is the
 * selected design for the whole site). Home 3's hero is the Dom reference's: a full-bleed photo of
 * Brandon's own work under the navy overlay, the headline, lead, slimline and the two pill buttons
 * CENTRED over it. The slim Trustindex slot sits between the lead and the buttons (operator round 3,
 * 6 Nov 2026: "above the buttons, right under the paragraph").
 * Home (`slides`): the photo carousel. OPERATOR REVIEW 4 (19 Nov 2026: "just let the images be a
 * carousel. It just moves for you on its own ... Customers don't need to be able to swap back and
 * forth between them. It's actually bad for usability"): the photos cross-fade behind the fixed
 * headline on their own and loop for ever, and there are NO customer-facing controls at all (the
 * arrows and dots are gone, so there is no control left to be unreachable). It still pauses
 * off-screen, and prefers-reduced-motion holds the first photo with no movement.
 * HEIGHTS. THE SITE OWNER'S OWN CORRECTION (25 Nov 2026, superseding review 5's fixed 780/640/540
 * and review 6's taller home figure): "the hero should fill the entire visible vertical viewport
 * automatically, and the EXACT SAME hero size policy on ALL my pages, not just the home page".
 * Fixed pixel heights are what produced the complaint he opened with - an 840px hero in a 900px
 * window left a white strip of the next section under it, and a 720px hero in an 844px phone window
 * left a bigger one. So --hero-h is now ONE viewport-relative value shared by every hero on the
 * site, home and inner alike: 100svh, the SMALL viewport height, so a phone's address bar can never
 * crop the hero and nothing reflows when that bar collapses (100vh is the fallback for engines
 * without svh). It is a MIN-height, so a long headline still GROWS the hero rather than clipping it,
 * and the hero's own padding clears the fixed header, which sits over it. `compact` sets no height
 * of its own, ever; it is a slider/no-slider distinction only now. Sub-pages come through
 * PageHero.astro and get exactly the same policy. Proved route by route at four widths by
 * scripts/hero-heights.mjs.
 * Buttons: Quick Quote Online = the chrome pill (scrolls to the quote form at the end of the page),
 * Call = the glass pill. REVIEWS: only the SLIMLINE widget (Google's own live rating and count);
 * the site writes no rating or count of its own.
 * OPERATOR OVERRIDES (DECISIONS O1-O3): no logo, no video and no form in any hero.
 */
import CallButton from './CallButton.astro';
import TrustindexSlot from './TrustindexSlot.astro';
type Img = { src: string; alt: string; width: number; height: number };
interface Props { h1: string; lead: string; image: Img; slides?: Img[]; compact?: boolean; formless?: boolean; showCta?: boolean }
const { h1, lead, image, slides = [], compact = false, formless = false, showCta = true } = Astro.props;
const photos = slides.length ? slides : [image];
const slider = photos.length > 1;
---
<section class:list={['hero on-dark section-hero', compact && 'hero--compact']} data-section="hero" data-hero={compact ? 'page' : 'home'} data-hero-style="home-3" data-slider={slider ? '' : undefined}>
  {photos.map((p, i) => <img class:list={['hero__bg', i === 0 && 'is-on']} src={p.src} alt="" width={p.width} height={p.height} fetchpriority={i === 0 ? 'high' : undefined} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />)}
  <div class="hero__inner container">
    <div class="hero__copy">
      <h1 class="hero__h1">{h1}</h1>
      <p class="hero__lead">{lead}</p>
      <TrustindexSlot role="slimline" place="slim-hero" ground="dark" align="center" class="hero__ti" />
      {showCta && (
        <div class="hero__actions">
          <a href={formless ? '/contact/#contact' : '#contact'} class="btn btn-primary hero__btn" data-cta="hero-quote"><span class="btn__t">Quick Quote Online</span></a>
          <CallButton cta="hero-call" class="hero__btn" />
        </div>
      )}
    </div>
  </div>
</section>

<script>
  // Home carousel (operator review 4, 19 Nov 2026): the photos advance on their own and loop for
  // ever. No arrows, no dots, nothing for a visitor to operate. It stops while the hero is off
  // screen, and prefers-reduced-motion means it never moves at all (the first photo stays).
  const root = document.querySelector<HTMLElement>('[data-section="hero"][data-slider]');
  if (root) {
    const imgs = [...root.querySelectorAll<HTMLImageElement>('.hero__bg')];
    let at = 0; let timer = 0; let visible = true;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const go = (n: number) => {
      at = (n + imgs.length) % imgs.length;
      imgs.forEach((im, i) => { im.classList.toggle('is-on', i === at); if (i === at) im.loading = 'eager'; });
    };
    const stop = () => { window.clearInterval(timer); timer = 0; };
    const start = () => { if (reduce || timer || !visible || imgs.length < 2) return; timer = window.setInterval(() => go(at + 1), 6000); };
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; visible ? start() : stop(); }).observe(root);
    start();
  }
</script>

<style>
  /* ONE HEIGHT POLICY FOR EVERY HERO ON THE SITE (the site owner, 25 Nov 2026): the whole visible
     viewport, home page and inner pages alike. --hero-h is 100svh (the small viewport height, so the
     mobile address bar cannot crop it and its collapse cannot reflow the page); 100vh is the
     fallback where svh is not supported. min-height, never height: a long headline grows the hero. */
  .hero, .hero--compact { --hero-h: 100vh; }
  @supports (height: 100svh) { .hero, .hero--compact { --hero-h: 100svh; } }
  .hero { position: relative; isolation: isolate; overflow: hidden; display: flex; flex-direction: column; justify-content: center; min-height: var(--hero-h); padding: calc(var(--header-h) + var(--space-16)) 0 var(--space-20); background: var(--bg-hero); color: var(--text-inverse-muted); text-align: center; }
  /* `compact` carries no geometry of its own at all now: same height, same padding, same type.
     It only tells the hero there is no photo carousel on this page. */
  .hero__bg { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; }
  .hero[data-slider] .hero__bg { opacity: 0; transition: opacity 1.1s var(--ease); }
  .hero[data-slider] .hero__bg.is-on { opacity: 1; }
  .hero::before { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--overlay-hero); }
  .hero__copy { display: flex; flex-direction: column; align-items: center; }
  /* The headline takes --fs-8xl on a desktop (the site owner, 25 Nov 2026: the old inner-page size
     "is too small"), and it is now the SAME size on every page - inner heroes used to step it down.
     Only the measure differs, because an inner-page headline is the longer one. */
  .hero__h1 { color: var(--text-inverse); font-size: var(--fs-8xl); line-height: 1.06; max-width: 18ch; margin-bottom: var(--space-6); }
  .hero--compact .hero__h1 { max-width: 20ch; }
  .hero__lead { color: var(--v-mist-100); font-size: var(--fs-lg); max-width: 58ch; margin-bottom: var(--space-4); }
  /* The slimline directly under the paragraph, ABOVE the buttons (operator round 3): 16px above, 24px below. */
  .hero__copy :global(.hero__ti) { width: 100%; margin-bottom: var(--space-6); }
  .hero__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-3); }
  .hero__actions :global(.hero__btn) { min-height: var(--btn-h-lg); }
  /* Tablet: the height policy is the viewport at every width, so only the type scale steps down. */
  @media (max-width: 1023px) { .hero__h1, .hero--compact .hero__h1 { font-size: var(--fs-5xl); } }
  /* Phone: still the visible viewport (100svh), with the padding trimmed so the headline, the
     slimline and both full-width buttons fit inside a 320x640 window without the hero having to
     grow past it. */
  @media (max-width: 760px) {
    .hero { padding: calc(var(--header-h) + var(--space-8)) 0 var(--space-10); }
    .hero__h1, .hero--compact .hero__h1 { font-size: var(--fs-4xl); }
    .hero__lead { font-size: var(--fs-base); }
    .hero__actions { width: 100%; flex-direction: column; }
    .hero__actions :global(.hero__btn) { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) { .hero[data-slider] .hero__bg { transition: none; } }
</style>
