---
/**
 * VIDEO. Brandon's own YouTube videos, embedded from YouTube (the operator, 23 Oct call: an
 * embedded video helps the page). youtube-nocookie.com, so YouTube sets no cookies until play
 * (Cookie Policy). One-line caption, the video's own title only (plan, Video): nothing about the
 * job, the house or the customer. Portrait for the kitchen Short, 16:9 for the house video.
 */
import { videos } from '../data/site';
interface Props { which: 'kitchen' | 'house'; eager?: boolean; class?: string }
const { which, eager = false, class: cls } = Astro.props;
const v = videos[which];
---
<figure class:list={['vid', v.portrait ? 'vid--portrait' : 'vid--wide', cls]} data-video={which}>
  <div class="vid__frame">
    <iframe src={`https://www.youtube-nocookie.com/embed/${v.id}?rel=0&modestbranding=1&playsinline=1`} title={`Brandon's video: ${v.caption}`} loading={eager ? 'eager' : 'lazy'} allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
  </div>
  <figcaption class="vid__cap">{v.caption}</figcaption>
</figure>

<style>
  .vid { margin: 0; }
  .vid__frame { position: relative; width: 100%; background: var(--bg-inverse); }
  .vid--wide .vid__frame { aspect-ratio: 16 / 9; }
  .vid--portrait .vid__frame { aspect-ratio: 9 / 16; }
  .vid__frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .vid__cap { margin-top: var(--space-2); font-size: var(--fs-md); color: var(--text-muted); }
  :global(.on-dark) .vid__cap { color: var(--text-inverse-muted); }
</style>
