---
/**
 * SERVICES (Buildings for Life ServicesGrid, operator overhaul 5 Nov 2026): the five hubs as
 * cards in one row, photo on top, the circle icon overlapping it, the first card black. CARD LAW:
 * the hub name on the title is the card's ONLY link (exact name, canonical href); images and icons
 * never link. Links are NEVER underlined: heading colour, hover colour.
 */
import { services } from '../data/site';
import Icon from './Icon.astro';
import CallButton from './CallButton.astro';
interface Props { heading?: string; lead?: string; showCall?: boolean; moreLine?: boolean; formless?: boolean }
const { heading = 'Painting and decorating, inside and out', lead = 'Five services, one standard of preparation and finish, for homes and businesses.', showCall = true, moreLine = true, formless = false } = Astro.props;
---
<section class="sv section section--panel section-services" id="services" data-section="services">
  <div class="container">
    <div class="sec-head" data-motion="reveal">
      <h2 class="sec-head__h2">{heading}</h2>
      <div class="sec-head__side">
        <p class="sec-head__lead">{lead}</p>
        {showCall && <CallButton cta="services-call" tone="light" />}
      </div>
    </div>
    <ul class="sv__grid">
      {services.map((s, i) => (
        <li class:list={['sv__card', i === 0 && 'sv__card--on on-dark']} data-motion="reveal" style={`--reveal-delay: ${(i % 5) * 60}ms`}>
          <div class="sv__img"><img src={s.image.sm} alt={s.image.alt} width={s.image.width} height={s.image.height} loading="lazy" decoding="async" /></div>
          <span class="sv__ic"><Icon name={s.icon} size={26} /></span>
          <h3 class="sv__title"><a href={`/${s.slug}/`} data-link="card">{s.name}</a></h3>
          <p class="sv__body">{s.short}</p>
        </li>
      ))}
    </ul>
    {moreLine && <p class="more-line">Not sure which of these your job falls under? <a href={formless ? '/contact/#contact' : '#contact'} class="text-link" data-cta="services-quote">Quick Quote Online</a></p>}
  </div>
</section>

<style>
  .sv__grid { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: var(--space-5); }
  .sv__card { position: relative; display: flex; flex-direction: column; background: var(--bg-card); border: 1px solid var(--border-default); box-shadow: var(--shadow-card); padding-bottom: var(--space-6); transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease); }
  .sv__card:hover { border-color: var(--brand-primary); box-shadow: var(--shadow-raised); }
  .sv__card--on { background: var(--bg-inverse); border-color: var(--bg-inverse); }
  .sv__card--on:hover { border-color: var(--accent-on-dark); }
  .sv__img { aspect-ratio: 4 / 3; overflow: hidden; background: var(--bg-panel); }
  .sv__img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s var(--ease); }
  .sv__card:hover .sv__img img { transform: scale(1.04); }
  .sv__ic { display: grid; place-items: center; width: var(--icon-circle); height: var(--icon-circle); margin: calc(-1 * var(--space-8)) 0 0 var(--space-5); position: relative; border-radius: var(--badge-radius); background: var(--brand-primary); color: var(--brand-fg); border: 4px solid var(--bg-card); }
  .sv__card--on .sv__ic { background: var(--accent-on-dark); color: var(--accent-on-dark-fg); border-color: var(--bg-inverse); }
  .sv__title { font-size: var(--fs-lg); padding: var(--space-4) var(--space-5) var(--space-2); }
  .sv__title a { color: var(--text-heading); transition: color 0.2s var(--ease); }
  .sv__card--on .sv__title a { color: var(--text-inverse); }
  .sv__title a:hover { color: var(--brand-primary); }
  .sv__card--on .sv__title a:hover { color: var(--accent-on-dark); }
  .sv__body { padding: 0 var(--space-5); font-size: var(--fs-md); color: var(--text-muted); }
  .sv__card--on .sv__body { color: var(--text-inverse-muted); }
  @media (max-width: 1100px) { .sv__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .sv__grid { grid-template-columns: 1fr; } }
</style>
