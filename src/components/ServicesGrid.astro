---
/**
 * SERVICES, in Home 3's tiles (the Dom reference's "We Provide All Types"): a centred head with the
 * chevron, then the five hubs as photo tiles with the hub name and its short line on the photo.
 * OPERATOR REVIEW 4 (19 Nov 2026): this is the site's ONE services-links section (the homepage's
 * second "For homes and business premises" card set is gone, its copy folded into this head), the
 * five tiles sit THREE across with the last TWO centred underneath at the same size, and the line
 * under each name is 16px, never 12px ("that's too small ... remember this is going to be on a
 * mobile"). On a phone the tiles go one per row so the name and its line stay readable.
 * CARD LAW: the hub name on the title is the tile's ONLY link (exact name, canonical href); photos
 * never link. Links are NEVER underlined: white on the photo, chrome on hover.
 */
import { services } from '../data/site';
import Icon from './Icon.astro';
import CallButton from './CallButton.astro';
interface Props { heading?: string; lead?: string; showCall?: boolean; moreLine?: boolean; formless?: boolean; panel?: boolean; allLink?: boolean }
const { heading = 'Painting and Decorating, Inside and Out', lead = 'Five services, one standard of preparation and finish, for homes and businesses.', showCall = true, moreLine = true, formless = false, panel = false, allLink = false } = Astro.props;
---
<section class:list={['sv section section-services', panel && 'section--panel']} id="services" data-section="services">
  <div class="container">
    <div class="dm-head dm-head--c" data-motion="reveal">
      <h2 class="dm-h2">{heading}</h2>
      <p class="dm-lead">{lead}</p>
      <span class="dm-head__chev" aria-hidden="true"><Icon name="chevronDown" size={18} /></span>
    </div>
    <ul class="sv__grid">
      {services.map((s, i) => (
        <li class="sv__tile" data-motion="reveal" style={`--reveal-delay: ${i * 60}ms`}>
          <img src={s.image.sm} alt={s.image.alt} width={s.image.width} height={s.image.height} loading="lazy" decoding="async" />
          <div class="sv__cap on-dark">
            <h3 class="sv__title"><a href={`/${s.slug}/`} data-link="card">{s.name}</a></h3>
            <p class="sv__body">{s.short}</p>
          </div>
        </li>
      ))}
    </ul>
    {(moreLine || showCall || allLink) && (
      <div class="sv__foot">
        {moreLine && <p class="sv__more">Not sure which of these your job falls under? <a href={formless ? '/contact/#contact' : '#contact'} class="dm-link" data-cta="services-quote">Quick Quote Online</a></p>}
        {allLink && <a href="/services/" class="btn btn-primary" data-cta="services-all"><span class="btn__t">View All Services</span></a>}
        {showCall && <CallButton cta="services-call" tone="light" />}
      </div>
    )}
  </div>
</section>

<style>
  /* THREE across, then the last TWO centred underneath at the same size (operator review 4).
     Six columns: every tile spans two, and the fourth and fifth start one column in. */
  .sv__grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: var(--space-6); }
  .sv__tile { position: relative; isolation: isolate; overflow: hidden; grid-column: span 2; aspect-ratio: 5 / 6; background: var(--bg-inverse); }
  .sv__tile:nth-child(4) { grid-column: 2 / span 2; }
  .sv__tile:nth-child(5) { grid-column: 4 / span 2; }
  .sv__tile img { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease); }
  .sv__tile::before { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--overlay-tile); }
  .sv__tile:hover img { transform: scale(1.05); }
  .sv__cap { position: absolute; left: 0; right: 0; bottom: 0; padding: var(--space-6) var(--space-5); }
  .sv__title { font-size: var(--fs-2xl); line-height: 1.2; margin-bottom: var(--space-2); }
  .sv__title a { color: var(--text-inverse); transition: color 0.2s var(--ease); }
  .sv__title a:hover { color: var(--accent-on-dark); }
  .sv__body { font-size: var(--fs-card); line-height: var(--lh-normal); color: var(--v-mist-100); }
  .sv__foot { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: var(--space-4) var(--space-8); margin-top: var(--space-10); }
  .sv__more { font-size: var(--fs-card); color: var(--text-muted); text-align: center; }
  /* Tablet: two across, the fifth centred underneath, so the row never ends on an empty cell. */
  @media (max-width: 1023px) {
    .sv__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .sv__tile, .sv__tile:nth-child(4) { grid-column: span 2; aspect-ratio: 4 / 3; }
    .sv__tile:nth-child(5) { grid-column: 2 / span 2; }
  }
  /* Phone: one tile per row, so the hub name and the line under it stay readable (operator review 4). */
  @media (max-width: 760px) {
    .sv__grid { grid-template-columns: 1fr; gap: var(--space-4); }
    .sv__tile, .sv__tile:nth-child(4), .sv__tile:nth-child(5) { grid-column: 1 / -1; aspect-ratio: 4 / 3; }
    .sv__cap { padding: var(--space-5) var(--space-4); }
    .sv__title { font-size: var(--fs-xl); }
    .sv__foot :global(.btn) { width: 100%; }
  }
</style>
