---
/**
 * THE WORK GRID: TrueLine Finishes' own photographs from finished jobs, each opening in the root
 * Lightbox. Replaces the tabbed "Our Work" block site-wide (Home 3 design, 19 Nov 2026).
 *
 * TWO MODES.
 *  - default (About, Reviews, Services hub): the six best photos in the pool, picked by measured
 *    sharpness (Laplacian contrast on the served 1600px files, finished work only, no prep or
 *    dust-sheet shots) and then by eye, in Home 3's edge-to-edge 4:3 grid. The operator reviewed
 *    this block on /reviews/ in round 4 and asked for no change there.
 *  - `full` (the HOME page only, operator review 4, 19 Nov 2026: "I want half of this gallery on the
 *    home page, half of it instead of the one we have, because this gallery is great"): about half
 *    the gallery page's collection, in the GALLERY PAGE's own treatment, which the operator called
 *    fantastic: square tiles with real spacing between them, four across on a desktop, three on a
 *    tablet, two on a phone. Every photo is lazy-loaded.
 * COPY (operator review 4): the brand, not the owner's name, and never a count of the photos,
 * because more are added over time ("don't say a number and don't say his name ... we will add
 * more pictures in the future").
 * The selection is deterministic (a fixed stride through the gallery order), so the page is the
 * same on every build and no photo appears twice.
 */
import { images, image } from '../data/site';
interface Props { heading?: string; lead?: string; photos?: string[]; full?: boolean }
const {
  heading = 'Our Work, Photographed on the Job',
  lead = 'Photographs taken on TrueLine Finishes jobs, inside and out. Tap one to see it larger; the gallery page has the full collection.',
  photos = ['navy-kitchen-0038', 'victorian-hallway-0066', 'navy-front-door-stone-0032', 'grey-living-room-0133', 'white-sash-window-stone-0030', 'stone-farmhouse-0093'],
  full = false,
} = Astro.props;

// `full`: about half of what the gallery page shows, in the gallery page's own group order
// (interiors, exteriors, wallpapering, commercial), evenly spread through each group so the
// selection stays representative rather than the first half of one room type.
const afterCat = (key: string) => (/gable|semi-detached/.test(key) ? 'exterior' : 'interior');
const shown = images.filter((i) => !/-before-/.test(i.key)).map((i) => (i.cat === 'before-after' ? { ...i, cat: afterCat(i.key) } : i));
const half = ['interior', 'exterior', 'wallpapering', 'commercial'].flatMap((cat) => {
  const list = shown.filter((i) => i.cat === cat);
  return list.filter((_, n) => n % 2 === 0);
});
const grid = full ? half : photos.map(image);
---
<section class:list={['wg', full && 'wg--full']} data-section="gallery" data-ai-skip>
  <div class="container dm-head dm-head--row wg__head" data-motion="reveal">
    <div>
      <h2 class="dm-h2">{heading}</h2>
      <p class="dm-lead">{lead}</p>
    </div>
    <a href="/gallery/" class="btn btn-primary btn--desc" data-cta="gallery-all"><span class="btn__t">See the Gallery</span></a>
  </div>
  {full ? (
    <div class="container">
      <ul class="wg__grid wg__grid--full" data-gallery>
        {grid.map((g) => (
          <li><button type="button" class="wg__shot wg__shot--sq" data-lightbox aria-label={`Open larger: ${g.alt}`}><img src={g.sm} data-full={g.src} alt={g.alt} width={g.width} height={g.height} loading="lazy" decoding="async" /></button></li>
        ))}
      </ul>
    </div>
  ) : (
    <ul class="wg__grid" data-gallery>
      {grid.map((g) => (
        <li><button type="button" class="wg__shot" data-lightbox aria-label={`Open larger: ${g.alt}`}><img src={g.sm} data-full={g.src} alt={g.alt} width={g.width} height={g.height} loading="lazy" decoding="async" /></button></li>
      ))}
    </ul>
  )}
</section>

<style>
  .wg { padding: var(--section-pad) 0 0; }
  .wg--full { padding-bottom: var(--section-pad); }
  .wg__head { margin-bottom: var(--space-10); }
  .wg__head .dm-h2 { margin-bottom: var(--space-4); }
  .wg__head .dm-lead { margin-top: 0; }
  .wg__grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .wg__shot { display: block; width: 100%; aspect-ratio: 4 / 3; padding: 0; border: 0; overflow: hidden; cursor: zoom-in; background: var(--bg-inverse); }
  .wg__shot img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease), opacity 0.3s var(--ease); }
  .wg__shot:hover img { transform: scale(1.04); opacity: 0.9; }
  /* The gallery page's treatment: square tiles with space between them (operator review 4). */
  .wg__grid--full { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-3); }
  .wg__shot--sq { aspect-ratio: 1; background: var(--bg-panel); }
  @media (max-width: 900px) { .wg__grid--full { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 760px) { .wg__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .wg__grid--full { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-2); } }
</style>
