---
interface Props { rating?: number; size?: number }
const { rating = 5, size = 16 } = Astro.props;
---
<span class="stars" role="img" aria-label={`${rating} out of 5 stars`}>
  {Array.from({ length: 5 }, (_, i) => (
    <svg viewBox="0 0 20 20" width={size} height={size} aria-hidden="true" class={i < Math.round(rating) ? 'on' : 'off'}><path d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.8l-5.2 2.8 1-5.8L1.5 7.7l5.9-.9z" fill="currentColor" /></svg>
  ))}
</span>
<style>
  .stars { display: inline-flex; gap: 2px; color: var(--star); }
  .stars .off { opacity: 0.3; }
</style>
