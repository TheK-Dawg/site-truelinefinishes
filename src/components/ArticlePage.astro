---
/**
 * SEO ARTICLE (plan, Layout): a header band; the reviews section; breadcrumbs (round 3: directly
 * above the article, never in the hero); a Quick Rundown box at the top of the body; the WHITE
 * reading column (#FFFFFF, ink text) and a sidebar with "On this page" and a "Need a quote?" card;
 * one real pool photo directly above every content H2 (FAQ excluded); NO YouTube embed (operator
 * round 2, fix 13: every hand-placed video came off; the rotation rule stays in articles.ts for
 * when video returns through the operator's widgets); the FAQ in the body; related articles
 * (the same hub in other towns, other hubs in the same town); the quote form.
 * The body is the engine's HTML, rendered as-is apart from the figures and H2 ids.
 * Article + FAQPage + BreadcrumbList schema. Articles not yet published are noindex.
 */
import Base from '../layouts/Base.astro';
import PageHero from './PageHero.astro';
import Reviews from './Reviews.astro';
import QuoteForm from './QuoteForm.astro';
import Icon from './Icon.astro';
import { articles, articleUrl, articlePhotoPool } from '../data/articles';
import { business, services, image } from '../data/site';
import { stripTags } from '../lib/links';
import { normaliseArticleBody } from '../lib/article-body.js';

interface Props { article: import('../data/articles').Article }
const { article } = Astro.props;
const svc = services.find((s) => s.slug === article.hub)!;
const hero = image(article.hero);
const url = articleUrl(article);
const pageUrl = `${business.url}${url}`;

// Photos for the H2s. The pool is the hub's SERVICE-MATCHED set and nothing else (articles.ts
// articlePhotoPool, operator review 6, 25 Nov 2026: "correct service-matched photo pool", "block
// off-topic fallbacks"). Shuffled deterministically from the slug, so the same article always gets
// the same photographs in the same order and two articles rarely open with the same one.
// NO REPEATS AND NO PADDING: each H2 takes the next unused photograph, and when the hub's pool runs
// out the remaining H2s simply carry no figure. A wallpapering article therefore ships with its hero
// photograph only, because TrueLine has exactly one wallpapering photograph and it is that hero -
// which is the honest answer, not a hundred and forty-seven interior shots pretending to be it.
let seed = [...article.slug].reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, 7);
const rand = () => ((seed = (seed * 1103515245 + 12345) >>> 0) / 2 ** 32);
const pool = articlePhotoPool(article.hub, article.hero).map((i) => ({ i, r: rand() })).sort((a, b) => a.r - b.r).map((x) => x.i);

const slugify = (s: string) => s.toLowerCase().replace(/<[^>]+>/g, '').replace(/&[a-z#0-9]+;/g, '').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const parts = article.bodyHtml.split(/(?=<h2[\s>])/);
const intro = parts[0].startsWith('<h2') ? '' : parts.shift()!;
const toc: { id: string; text: string }[] = [];
const sections = parts.map((p, n) => {
  const m = p.match(/^<h2[^>]*>([\s\S]*?)<\/h2>/);
  const text = m ? stripTags(m[1]) : '';
  let id = slugify(text) || `section-${n + 1}`;
  while (toc.some((t) => t.id === id)) id += '-2';
  toc.push({ id, text });
  const img = pool[n]; // one photograph each, in order; past the end of the pool there is none
  const fig = img ? `<figure class="art__fig"><img src="${img.src}" alt="${img.alt}" width="${img.width}" height="${img.height}" loading="lazy" decoding="async" /></figure>` : '';
  return `${fig}${p.replace(/^<h2[^>]*>/, `<h2 id="${id}">`)}`;
});
// The engine's HTML in this site's own markup: its hard-coded CTA block rebuilt as the site's pill
// buttons with Brandon's number, and every inline style dropped (which also removes the left-border
// accents the house law of 30 Sep 2026 bans). See src/lib/article-body.js for what and why.
const body = normaliseArticleBody(`${intro}${sections.join('\n')}`, business);

const sameHub = articles.filter((a) => a.hub === article.hub && a.slug !== article.slug).slice(0, 6);
const sameTown = articles.filter((a) => a.town === article.town && a.slug !== article.slug);
// Interlinking (operator, 5 Nov 2026): every article links across to 1 or 2 others. When no article shares its hub or
// town yet, the nearest other published articles stand in.
const others = sameHub.length || sameTown.length ? [] : articles.filter((a) => a.slug !== article.slug && a.status === 'published').slice(0, 2);
const schema = [
  { '@type': 'Article', '@id': `${pageUrl}#article`, headline: article.title, description: article.description, image: new URL(hero.src, business.url).href, author: { '@type': 'Person', name: business.owner }, publisher: { '@id': `${business.url}/#business` }, mainEntityOfPage: pageUrl, inLanguage: 'en-GB', about: { '@type': 'Service', name: svc.name, url: `${business.url}/${svc.slug}/` } },
  ...(article.faqs.length ? [{ '@type': 'FAQPage', '@id': `${pageUrl}#faq`, mainEntity: article.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: stripTags(f.a) } })) }] : []),
  { '@type': 'BreadcrumbList', '@id': `${pageUrl}#crumbs`, itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${business.url}/` },
    { '@type': 'ListItem', position: 2, name: svc.name, item: `${business.url}/${svc.slug}/` },
    { '@type': 'ListItem', position: 3, name: article.title, item: pageUrl },
  ] },
];
---
<Base title={article.metaTitle} description={article.description} page={`article-${article.slug}`} schema={schema} ogImage={hero.src} noindex={article.status !== 'published'}>
  <PageHero h1={article.title} lead={article.summary} image={hero} />
  <Reviews tight />
  <nav class="art__crumbs container" aria-label="Breadcrumb">
    <ol><li><a href="/">Home</a></li><li><a href={`/${svc.slug}/`}>{svc.name}</a></li><li><span aria-current="page">{article.title}</span></li></ol>
  </nav>
  <section class="art section section-article-body on-white" data-section="article-body">
    <div class="art__inner container">
      <article class="art__main prose">
        {article.rundown && article.rundown.length > 0 && (
          <div class="art__rd" data-rundown>
            <p class="art__rd-h">Quick Rundown</p>
            <ul>{article.rundown.map((r) => <li><Icon name="check" size={18} /><span set:html={r} /></li>)}</ul>
          </div>
        )}
        <Fragment set:html={body} />
        {article.faqs.length > 0 && (
          <section class="art__faq" aria-labelledby="faq">
            <h2 id="faq">{article.title}: Questions People Ask</h2>
            {article.faqs.map((f) => <details class="art__q" open><summary>{f.q}</summary><div set:html={f.a} /></details>)}
          </section>
        )}
      </article>
      <aside class="art__aside">
        {toc.length > 0 && (
          <details class="art__toc" open>
            <summary>On this page</summary>
            <ol>{toc.map((t) => <li><a href={`#${t.id}`}>{t.text}</a></li>)}{article.faqs.length > 0 && <li><a href="#faq">Questions people ask</a></li>}</ol>
          </details>
        )}
        <div class="art__cta on-dark">
          <p class="art__cta-h">Need a Quote?</p>
          <p>Get a free quotation: call <a href={business.phoneHref} data-cta="article-aside-call">{business.phone}</a> or use the quote form.</p>
          <a href="#contact" class="btn btn-primary" data-cta="article-aside-quote"><span class="btn__t">Quick Quote Online</span></a>
        </div>
      </aside>
    </div>
  </section>
  {(sameHub.length > 0 || sameTown.length > 0 || others.length > 0) && (
    <section class="art__rel section section--panel" data-section="related-articles">
      <div class="container art__rel-grid">
        {sameHub.length > 0 && <div><h2 class="art__rel-h">{svc.name} in Other Towns</h2><ul>{sameHub.map((a) => <li><a href={articleUrl(a)} data-link="related">{a.title}</a></li>)}</ul></div>}
        {sameTown.length > 0 && <div><h2 class="art__rel-h">More in {article.town}</h2><ul>{sameTown.map((a) => <li><a href={articleUrl(a)} data-link="related">{a.title}</a></li>)}</ul></div>}
        {others.length > 0 && <div><h2 class="art__rel-h">More from TrueLine Finishes</h2><ul>{others.map((a) => <li><a href={articleUrl(a)} data-link="related">{a.title}</a></li>)}</ul></div>}
      </div>
    </section>
  )}
  <QuoteForm heading={`${svc.name} in ${article.town}: Get a Free Quotation`} />
</Base>

<style>
  /* Round 3 (operator: big gaps around the breadcrumbs and before the article): the crumbs sit
     directly above the article, under the reviews section, with tight spacing either side. */
  .art__crumbs { padding-top: 0; padding-bottom: 0; }
  .art.section { padding-top: var(--space-6); }
  .art__crumbs ol { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-3); font-family: var(--font-heading); font-size: var(--fs-md); font-weight: var(--fw-medium); }
  .art__crumbs li + li::before { content: '/'; margin-right: var(--space-3); color: var(--text-muted); }
  .art__crumbs a { color: var(--brand-text); }
  .art__crumbs [aria-current] { color: var(--text-primary); }
  /* Round 3: the body runs the full column up to the sidebar (no 72ch cap leaving a gulf). */
  .art__inner { display: grid; grid-template-columns: minmax(0, 1fr) var(--aside-w); gap: var(--space-10); align-items: start; }
  .art__main { background: var(--bg-card); color: var(--text-primary); }
  .art__rd { margin-bottom: var(--space-8); padding: var(--space-6) var(--space-8); background: var(--bg-panel); }
  .art__rd-h { font-family: var(--font-heading); font-size: var(--fs-xl); font-weight: var(--fw-regular); color: var(--text-heading); margin-bottom: var(--space-3); }
  .art__rd ul { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-2); }
  .art__rd li { display: grid; grid-template-columns: auto 1fr; gap: var(--space-3); align-items: start; }
  .art__rd :global(.icon) { color: var(--brand-primary); margin-top: 3px; }
  .art__main :global(h2) { scroll-margin-top: calc(var(--header-h) + var(--space-4)); }
  .art__main :global(.art__fig) { margin: 2em 0 0; }
  .art__main :global(.art__fig + h2) { margin-top: 0.7em; }
  .art__main :global(.art__fig img) { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  /* The engine's in-article CTA, rebuilt in the site's own furniture (review 6): the same panel the
     Quick Rundown box uses, the site's two pill buttons, full width on a phone. */
  .art__main :global(.art__inline-cta) { margin: 2.4em 0; padding: var(--space-6) var(--space-8); background: var(--bg-panel); }
  .art__main :global(.art__inline-cta-p) { color: var(--text-primary); font-weight: var(--fw-semibold); margin-bottom: var(--space-5); }
  .art__main :global(.art__inline-cta-actions) { display: flex; flex-wrap: wrap; gap: var(--space-3); margin: 0; }
  /* `.prose a` colours every link in the reading column, and it outranks `.btn-primary`, so without
     this the in-article CTA's pills came out with body-link ink on their own fill (caught on the
     fixture run, 25 Nov 2026: royal pill, deep-blue label, 1.9:1). The pills keep their own colours. */
  .art__main :global(.art__inline-cta .btn-primary), .art__main :global(.art__inline-cta .btn-primary:hover) { color: var(--brand-fg); }
  .art__main :global(.art__inline-cta .btn-call--light), .art__main :global(.art__inline-cta .btn-call--light:hover) { color: var(--text-inverse); }
  .art__faq { margin-top: 2.4em; }
  .art__q { border-top: 1px solid var(--border-default); padding: var(--space-4) 0; }
  .art__q summary { cursor: pointer; font-weight: var(--fw-semibold); color: var(--text-heading); }
  .art__q div { margin-top: var(--space-2); }
  .art__aside { position: sticky; top: calc(var(--header-h) + var(--space-6)); display: flex; flex-direction: column; gap: var(--space-5); }
  .art__toc { background: var(--bg-panel); padding: var(--space-6); }
  .art__toc summary { cursor: pointer; list-style: none; font-size: var(--fs-sm); letter-spacing: var(--ls-eyebrow); text-transform: uppercase; font-weight: var(--fw-semibold); color: var(--text-heading); }
  .art__toc summary::-webkit-details-marker { display: none; }
  .art__toc ol { list-style: none; padding: 0; margin-top: var(--space-3); display: flex; flex-direction: column; gap: var(--space-2); font-size: var(--fs-md); }
  .art__toc a { color: var(--brand-text); }
  .art__toc a:hover { color: var(--brand-primary); }
  .art__cta { background: var(--bg-inverse); padding: var(--space-6); display: flex; flex-direction: column; gap: var(--space-3); color: var(--text-inverse-muted); }
  .art__cta-h { font-family: var(--font-heading); font-size: var(--fs-2xl); font-weight: var(--fw-regular); color: var(--text-inverse); }
  .art__cta a:not(.btn) { color: var(--text-inverse); font-weight: var(--fw-semibold); }
  .art__cta .btn { width: 100%; }
  .art__rel-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-10); }
  .art__rel-h { font-size: var(--fs-2xl); margin-bottom: var(--space-4); }
  .art__rel ul { list-style: none; padding: 0; display: grid; gap: var(--space-2); }
  .art__rel a { color: var(--brand-text); font-weight: var(--fw-semibold); }
  @media (max-width: 760px) { .art__main :global(.art__inline-cta) { padding: var(--space-6) var(--space-4); } .art__main :global(.art__inline-cta-actions) :global(.btn) { width: 100%; } }
  @media (max-width: 1023px) {
    .art__inner { grid-template-columns: 1fr; gap: var(--space-8); }
    .art__aside { position: static; order: -1; }
    .art__rel-grid { grid-template-columns: 1fr; }
  }
</style>
