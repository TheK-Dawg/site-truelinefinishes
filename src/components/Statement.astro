---
/**
 * STATEMENT SLAB (Electrix "We are passionate about..."). Inset dark panel,
 * large statement with bright highlighted phrases, a rule, three stats and
 * the owner's name where the template had a signature. Affirmed facts only.
 */
import { business } from '../data/site';
interface Props { html: string }
const { html } = Astro.props;
const stats = [
  { n: '40', suffix: '+', label: 'Years in the trade' },
  { n: '15', suffix: 'yrs', label: 'On natural stone work' },
  { n: '10', suffix: 'yr', label: 'New-build warranty' },
];
---
<section class="st section-statement" data-section="statement">
  <div class="container">
    <div class="st__panel on-dark" data-motion="reveal">
      <p class="st__text" set:html={html} />
      <div class="st__row">
        <ul class="st__stats">
          {stats.map((s) => <li><span class="st__n">{s.n}<em>{s.suffix}</em></span><span class="st__l">{s.label}</span></li>)}
        </ul>
        <p class="st__sig"><span>{business.owner}</span>Owner, {business.name}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .st { padding: var(--section-pad) 0 var(--space-12); }
  .st__panel { background: linear-gradient(135deg, var(--bg-inverse-2), var(--bg-inverse-deep)); padding: var(--space-20) var(--space-16); }
  .st__text { font-size: var(--fs-4xl); line-height: 1.3; color: var(--text-inverse-muted); letter-spacing: var(--ls-heading); }
  .st__text :global(b) { color: var(--text-inverse); font-weight: var(--fw-medium); }
  .st__row { display: flex; justify-content: space-between; align-items: flex-end; gap: var(--space-8); margin-top: var(--space-12); padding-top: var(--space-12); border-top: 1px solid var(--border-inverse); flex-wrap: wrap; }
  .st__stats { list-style: none; padding: 0; display: flex; gap: var(--space-16); flex-wrap: wrap; }
  .st__stats li { display: flex; flex-direction: column; gap: var(--space-1); }
  .st__n { font-size: var(--fs-5xl); color: var(--text-inverse); font-weight: var(--fw-medium); line-height: 1; }
  .st__n em { font-style: normal; font-size: var(--fs-2xl); color: var(--accent-on-dark); margin-left: var(--space-1); }
  .st__l { font-size: var(--fs-md); color: var(--text-inverse-muted); }
  .st__sig { text-align: right; font-size: var(--fs-sm); letter-spacing: 1px; text-transform: uppercase; color: var(--text-inverse-muted); }
  .st__sig span { display: block; font-style: italic; text-transform: none; letter-spacing: 0; font-size: var(--fs-3xl); font-weight: var(--fw-medium); color: var(--text-inverse); margin-bottom: var(--space-1); }
  @media (max-width: 900px) {
    .st__panel { padding: var(--space-12) var(--space-6); }
    .st__text { font-size: var(--fs-2xl); }
    .st__stats { gap: var(--space-8); }
    .st__n { font-size: var(--fs-4xl); }
    .st__sig { text-align: left; }
  }
</style>
