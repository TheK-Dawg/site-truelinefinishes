---
/**
 * CTA BAND (template "Get in touch" band, on black). Heading, the plan's CTA line and the two
 * actions. Never directly above a form (the form is the CTA).
 */
import CallButton from './CallButton.astro';
interface Props { heading: string; line: string }
const { heading, line } = Astro.props;
---
<section class="cb on-dark section-cta" data-section="cta">
  <div class="container cb__inner" data-motion="reveal">
    <div>
      <h2 class="cb__h2">{heading}</h2>
      <p class="cb__line">{line}</p>
    </div>
    <div class="btn-row cb__btns">
      <a href="#contact" class="btn btn-primary" data-cta="band-quote"><span class="btn__t">Quick Quote Online</span></a>
      <CallButton cta="band-call" />
    </div>
  </div>
</section>

<style>
  .cb { background: var(--bg-inverse); color: var(--text-inverse-muted); padding: var(--section-pad-sm) 0; }
  .cb__inner { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-8); align-items: center; }
  .cb__h2 { font-size: var(--fs-4xl); margin-bottom: var(--space-3); color: var(--text-inverse); }
  .cb__line { font-size: var(--fs-lg); max-width: 60ch; }
  @media (max-width: 900px) { .cb__inner { grid-template-columns: 1fr; } }
  @media (max-width: 760px) { .cb__h2 { font-size: var(--fs-3xl); } .cb :global(.btn) { width: 100%; } }
</style>
