---
/**
 * TRUSTINDEX SLIM WHITE — the ONE slimline review strip (REV3 item 6a). The
 * slim white-text widget for the dark bands: in every hero under the two CTA
 * buttons, in the quote form, and in the footer. Falls back to ReviewStrip
 * (no counts) while the slot is empty.
 *
 * MIRRORING (REV3 item 6a, measured 5 Oct): the TrustIndex loader renders its
 * widget ONCE per page, in the first slot it reaches, so the footer strip was
 * rendering empty on every page. The script below copies the rendered widget
 * into every other slim slot, so all of them carry the same widget and the
 * same six reviews, from one source, with no second count line anywhere.
 */
import ReviewStrip from './ReviewStrip.astro';
import { slots } from '../data/site';
interface Props { where: 'hero' | 'form' | 'footer' }
const { where } = Astro.props;
const src = slots.trustindexStrip;
---
<div class="tsl" data-trustindex-slot={`slim-${where}`} data-trustindex-src={src}>
  {!src && <ReviewStrip tone="dark" />}
</div>

<style>
  /* Reserve the widget's height (26-28px) so the hero does not jump when it renders on first input. */
  .tsl { min-height: var(--space-8); max-width: 100%; overflow: hidden; }
  /* TrustIndex centres its slim widget; align it with the copy column it sits in. */
  .tsl :global(.ti-widget) { text-align: left !important; max-width: 100%; }
</style>

<script>
  // One loader, one widget, every slim slot. See the mirroring note above.
  const slimSlots = [...document.querySelectorAll<HTMLElement>('[data-trustindex-slot^="slim-"]')];
  const slimSrc = slimSlots[0]?.dataset.trustindexSrc;
  if (slimSrc) {
    // The loader runs ONCE, in the first slot that is laid out. A second copy of the
    // same loader hides the widget it finds already rendered, which is what left the
    // footer strip blank, so the other slots are filled by copying, not by loading.
    // The hero slot is display:none below 1024px, and TrustIndex will not render
    // into a box that is not laid out, so the loader goes in the first slot that is.
    const host = slimSlots.find((s) => s.getClientRects().length) ?? slimSlots[0];
    const loader = document.createElement('script');
    loader.async = true;
    loader.src = slimSrc;
    host.appendChild(loader);
    const mirror = () => {
      // Only copy once TrustIndex has actually filled the widget, never the empty shell.
      const source = slimSlots.find((s) => (s.querySelector('.ti-widget')?.textContent ?? '').trim());
      if (!source) return false;
      const widget = source.querySelector('.ti-widget')!;
      for (const slot of slimSlots) {
        if (slot === source || slot.querySelector('.ti-widget')) continue;
        const copy = widget.cloneNode(true) as HTMLElement;
        // TrustIndex keeps housekeeping over anything it recognises as one of its
        // widgets and hides the duplicates, so the copy drops its markers and ids.
        copy.removeAttribute('data-trustindex-widget');
        copy.removeAttribute('id');
        copy.removeAttribute('style');
        copy.querySelectorAll('[id]').forEach((el) => el.removeAttribute('id'));
        slot.appendChild(copy);
      }
      return true;
    };
    if (slimSlots.length > 1 && !mirror()) {
      const observer = new MutationObserver(() => { if (mirror()) observer.disconnect(); });
      slimSlots.forEach((s) => observer.observe(s, { childList: true, subtree: true }));
      // TrustIndex renders on first user input; stop watching after a minute either way.
      setTimeout(() => observer.disconnect(), 60000);
    }
  }
</script>
