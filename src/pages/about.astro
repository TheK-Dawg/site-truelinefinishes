---
/**
 * ABOUT (seed: story / credentials / contact-cta). `story`: the business in the plan's own terms,
 * with the direct line to the owner explained once, not a self-work claim. `credentials`:
 * the usable claims only (over eight years' experience, fully insured, the charity). He has NO
 * accreditations, qualifications, memberships, guarantees or warranties, so none is shown.
 * The charity line is words only: no link, logo, charity number or cover image.
 * A photograph of TrueLine Finishes' own work sits beside the story. The kitchen Short that was here
 * came off with every other YouTube embed (operator round 2, fix 13); its caption stays in site.ts.
 * OPERATOR REVIEW 5 (19 Nov 2026, superseding review 4's one-mention compromise): the owner's name
 * is out of this page's copy altogether. The H1 is the service and the place ("About TrueLine
 * Finishes, Painting and Decorating in Baildon"), the story explains the direct line without naming
 * anyone ("A call to 07949 484274 is a direct line to the owner"), and no line claims the owner does
 * the work himself. The full name stays only in the structured data and on the legal-identification
 * pages (/privacy/, /terms/, /company-facts/). Gated in scripts/audit.mjs (round-5 block).
 */
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Reviews from '../components/Reviews.astro';
import WorkGrid from '../components/WorkGrid.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Icon from '../components/Icon.astro';
import { business, image, charityLine } from '../data/site';
const pageUrl = `${business.url}/about/`;
const schema = [
  { '@type': 'AboutPage', '@id': `${pageUrl}#about`, url: pageUrl, name: `About ${business.name}`, about: { '@id': `${business.url}/#business` } },
  { '@type': 'BreadcrumbList', '@id': `${pageUrl}#crumbs`, itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${business.url}/` }, { '@type': 'ListItem', position: 2, name: 'About', item: pageUrl }] },
];
const story = image('grey-living-room-0142');
const creds = [
  { icon: 'clock', title: "Over Eight Years' Experience", text: 'Painting and decorating for homes and businesses.' },
  { icon: 'shield', title: 'Fully Insured', text: 'Friendly and reliable, and fully insured.' },
  { icon: 'clipboard', title: 'Free Quotations', text: 'Every job is talked through with you before a free quotation is given.' },
  { icon: 'heart', title: "A Child's Wish", text: charityLine },
];
---
<Base title="Painter and Decorator in Baildon: About Us | TrueLine Finishes" description="TrueLine Finishes paints and decorates homes and business premises in Baildon, Shipley and nearby towns. Over eight years' experience, fully insured." page="about" schema={schema}>
  <PageHero h1="About TrueLine Finishes, Painting and Decorating in Baildon" lead="A painting and decorating business for homes and business premises in Baildon, Shipley and the towns around them, with over eight years' experience and preparation included in every job." image={image('lounge-dark-arched-alcove-0101')} />
  <Reviews />
  <section class="ab section section-story" data-section="story">
    <div class="container ab__inner">
      <div class="ab__copy prose" data-motion="reveal">
        <h2>The TrueLine Finishes Standard</h2>
        <p>TrueLine Finishes does interior and exterior painting, wallpapering and careful surface preparation, for homes and businesses, from individual rooms to full property redecorations.</p>
        <p>A call to 07949 484274 is a direct line to the owner, so the job is talked through with the person who will be on site, not passed down a chain.</p>
        <p>We take pride in attention to detail, lasting finishes and treating your property with care. Sanding, filling and caulking come with everything, because the preparation is what decides how good the paint looks and how long it lasts.</p>
        <p>Bedrooms and living rooms are favourite jobs at TrueLine Finishes, and the same care goes into kitchens, hallways, stairs, exteriors and business premises in Baildon, Shipley, Guiseley, Ilkley and the towns around them.</p>
      </div>
      <figure class="ab__img" data-motion="reveal"><img src={story.sm} alt={story.alt} width={story.width} height={story.height} loading="lazy" decoding="async" /></figure>
    </div>
  </section>
  <section class="cr section section--panel section-credentials" data-section="credentials">
    <div class="container">
      <div class="dm-head dm-head--c" data-motion="reveal"><h2 class="dm-h2">What You Can Count On</h2></div>
      <ul class="cr__grid">
        {creds.map((c, i) => (
          <li class="cr__item" data-motion="reveal" style={`--reveal-delay: ${i * 60}ms`}>
            <span class="cr__ic"><Icon name={c.icon} size={24} /></span>
            <h3>{c.title}</h3>
            <p>{c.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <WorkGrid />
  <QuoteForm heading="Talk to TrueLine Finishes About Your Project" />
</Base>
<style>
  .ab__inner { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--space-16); align-items: center; }
  .ab__copy h2 { margin-top: 0; }
  .ab__img { margin: 0; }
  .ab__img img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  .cr__grid { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-5); }
  .cr__item { background: var(--bg-card); padding: var(--card-pad); box-shadow: var(--shadow-raised); }
  .cr__item h3 { font-size: var(--fs-xl); margin: var(--space-4) 0 var(--space-2); }
  .cr__item p { color: var(--text-primary); font-size: var(--fs-md); }
  .cr__ic { display: grid; place-items: center; width: var(--space-12); height: var(--space-12); border-radius: var(--badge-radius); background: var(--bg-inverse); color: var(--accent-on-dark); }
  @media (max-width: 1023px) { .cr__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 900px) { .ab__inner { grid-template-columns: 1fr; gap: var(--space-8); } }
  @media (max-width: 520px) { .cr__grid { grid-template-columns: 1fr; } }
</style>
