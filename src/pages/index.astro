---
/**
 * HOME (operator overhaul, 5 Nov 2026): the Buildings for Life home page structure, section for
 * section, in TrueLine's words, photos and colours. BFL order: hero (+ info cards) -> reviews /
 * the TrustIndex slot -> statement slab -> trust badges -> about block -> services grid -> our
 * work -> the inside-and-out section (BFL's craft row; here the three tiles from Brandon's
 * reference) -> how a job runs -> areas -> resources preview -> FAQ -> quote form LAST.
 * OPERATOR OVERRIDES (DECISIONS O1-O6, R2-1..R2-16): no logo, video or form in the hero; no
 * before-and-after slider anywhere; no YouTube embed anywhere; links are never underlined; the
 * areas section ("Where to Find Us") is plain text over Brandon's Google listing map (CID).
 * Home blueprint headings (seed homePage.sections): "Professional painting and decorating for every
 * property" = the H1; "Residential and commercial decorating services" = the tiles row; "A
 * quality-led service from preparation to completion" = the about block; contact-cta = the form.
 */
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Reviews from '../components/Reviews.astro';
import Statement from '../components/Statement.astro';
import TrustBadges from '../components/TrustBadges.astro';
import AboutBlock from '../components/AboutBlock.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import OurWork from '../components/OurWork.astro';
import Steps from '../components/Steps.astro';
import Areas from '../components/Areas.astro';
import ArticlesPreview from '../components/ArticlesPreview.astro';
import Faq from '../components/Faq.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Icon from '../components/Icon.astro';
import { business, seo, image, mainPlaces } from '../data/site';
import { stripTags } from '../lib/links';
import { generalFaqs } from '../data/faq';

const faqs = generalFaqs;
const schema = [
  { '@type': 'FAQPage', '@id': `${business.url}/#faq`, mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: stripTags(f.a) } })) },
];
const tiles = [
  { icon: 'roll', h3: 'Specialist Wallcoverings', html: 'Feature walls and whole rooms in paper, hung on walls prepared properly first. See <a href="/wallpapering/" class="text-link" data-link="tile">Wallpapering</a>.' },
  { icon: 'layers', h3: 'Interior & Exterior Work', html: 'Walls, ceilings, stairs and woodwork inside with <a href="/interior-painting/" class="text-link" data-link="tile">Interior Painting</a>; masonry, windows and doors outside with <a href="/exterior-painting/" class="text-link" data-link="tile">Exterior Painting</a>.' },
  { icon: 'office', h3: 'Domestic & Commercial', html: 'Homes, offices, restaurants, schools, hotels, spas, leisure centres and local businesses. See <a href="/commercial-painting-and-decorating/" class="text-link" data-link="tile">Commercial Painting and Decorating</a>.' },
];
---
<Base title={seo.title} description={seo.description} page="home" schema={schema}>
  <Hero
    h1="Rooms Looking Tired? Painting and Decorating by Brandon, Start to Finish"
    lead="Or the outside of the house letting it down? TrueLine Finishes paints and decorates homes and businesses, from a single room to a full property redecoration, and every job starts with careful preparation."
    image={image('bay-window-living-room-0054')}
  />
  <Reviews />
  <Statement html="A painting and decorating business where <b>the person you call is the person who does the work</b>: Brandon prepares every surface properly, <b>sanding, filling and caulking come with everything</b>, and the finish is <b>made to last</b>." />
  <TrustBadges />
  <AboutBlock
    heading="Preparation First, and a Finish That Lasts"
    body={[
      'TrueLine Finishes is Brandon Dawson’s painting and decorating business: interior and exterior painting, wallpapering and careful surface preparation, for homes and businesses, from individual rooms to full property redecorations.',
      'Brandon, the owner, carries out the work and oversees every job. We take pride in attention to detail, lasting finishes and treating your property with care.',
    ]}
    image={image('hallway-white-staircase-0155')}
    rows={[
      { n: '01', title: "Over eight years' experience", text: 'Painting and decorating for homes and businesses.' },
      { n: '02', title: 'Preparation on every job', text: 'Sanding, filling and caulking come with everything; new plaster gets a mist coat.' },
      { n: '03', title: 'Floors and furniture protected', text: 'Dust sheets down and surfaces covered before the work starts.' },
      { n: '04', title: 'A free quotation', text: 'Brandon talks the job through with you first.' },
    ]}
    features={[
      { icon: 'user', title: 'Brandon on every job', text: 'A call to 07949 484274 is a direct line to the person doing the work.' },
      { icon: 'shield', title: 'Fully insured', text: 'Friendly and reliable, and fully insured.' },
    ]}
    button={{ href: '/about/', label: 'About Brandon' }}
  />
  <ServicesGrid heading="What Brandon Can Paint and Paper for You" lead="Rooms inside, the outside of the house, wallpaper and business premises: pick the job you have in mind." />
  <OurWork />
  <section class="cr section section--panel section-craft" data-section="craft">
    <div class="container">
      <div class="sec-head" data-motion="reveal">
        <h2 class="sec-head__h2">For Homes and Business Premises, Inside and Out</h2>
        <p class="sec-head__lead">Painting, wallpapering and decorating for homes and for business premises of every kind, inside and out.</p>
      </div>
      <ul class="cr__grid">
        {tiles.map((c, i) => (
          <li class="cr__item" data-motion="reveal" style={`--reveal-delay: ${i * 70}ms`}>
            <span class="cr__ic"><Icon name={c.icon} size={26} /></span>
            <h3>{c.h3}</h3>
            <p set:html={c.html} />
          </li>
        ))}
      </ul>
    </div>
  </section>
  <Steps
    heading="How a job runs"
    lead="Three steps, and you deal with Brandon from the first call to the last coat."
    photo="kitchen-diner-protected-0007"
    steps={[
      { icon: 'chat', title: 'Get in touch', text: 'Call Brandon directly, use the quote form or send a WhatsApp message.' },
      { icon: 'clipboard', title: 'A free quotation', text: 'Brandon talks the job through with you and gives you a free quotation.' },
      { icon: 'roller', title: 'The work, done properly', text: 'Preparation first, floors and surfaces protected, with Brandon carrying out the work and overseeing the job.' },
    ]}
  />
  <Areas
    heading="Where to Find Us"
    body={`Painting and decorating for homes and businesses in ${mainPlaces.slice(0, -1).join(', ')} and ${mainPlaces.at(-1)}, and the towns around them, including Saltaire, Yeadon, Rawdon, Burley in Wharfedale, Leeds and Skipton.`}
  />
  <ArticlesPreview always heading="Worth Reading Before the Dust Sheets Go Down" lead="Painting and decorating, explained town by town: preparation, finishes and what to expect." />
  <Faq items={faqs} heading="Questions people ask before they call" lead="Straight answers about the work, the quotation and who does the job." allLink />
  <QuoteForm />
</Base>

<style>
  .cr__grid { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6); }
  .cr__item { background: var(--bg-card); padding: var(--card-pad); border: 1px solid var(--border-default); box-shadow: var(--shadow-card); transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease); }
  .cr__item:hover { border-color: var(--brand-primary); box-shadow: var(--shadow-raised); }
  .cr__item h3 { font-size: var(--fs-xl); margin: var(--space-5) 0 var(--space-3); }
  .cr__item p { color: var(--text-muted); font-size: var(--fs-md); }
  .cr__ic { display: grid; place-items: center; width: var(--icon-circle); height: var(--icon-circle); border-radius: var(--badge-radius); background: var(--bg-inverse); color: var(--accent-on-dark); }
  @media (max-width: 900px) { .cr__grid { grid-template-columns: 1fr; } }
</style>
