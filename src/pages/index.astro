---
/**
 * HOME = HOME 3 (operator, 19 Nov 2026: "Vince selected Home 3 as the design/template"; the regular
 * homepage is rebuilt from the approved /home-3/ variant, which is retired and 301s here).
 * Home 3 is the section flow of https://dom.themerex.net/ (captured 5 Nov 2026), in TrueLine's own
 * copy, Brandon's photos and the logo's blues, as corrected in the operator's live review 3 (R3-9):
 *   hero (full-bleed photo slider, centred headline, slimline, Quick Quote Online + Call)
 *   -> the site's reviews section -> the five hubs as photo tiles (3 over 2, the page's ONLY
 *   services-links section) -> the photo CTA band (both buttons) -> preparation block (accordion +
 *   photo + ring badge + three USP boxes) -> the videos -> the gallery grid + See the Gallery ->
 *   Where to Find Us (KEPT from the regular home: operator round 2 fix 8 ordered Brandon's real
 *   listing map on the home page) -> resources row -> the quote form band.
 * OPERATOR REVIEW 4 (19 Nov 2026): the second services card set ("For homes and business premises,
 * inside and out") is GONE ("you have the services section twice on the homepage. That means there
 * are twice the links on the homepage, which is not good ... remove that section, keep maybe the
 * text, and move that text for the other section"): its wording is folded into the one remaining
 * services head, and that head now carries the View All Services button the removed block had.
 * The gallery grid shows about half the gallery page's collection ("I want half of this gallery on
 * the home page ... because this gallery is great").
 * No address, no written reviews, rating or count, no form in the hero, no before/after slider.
 */
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Reviews from '../components/Reviews.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import Videos from '../components/Videos.astro';
import WorkGrid from '../components/WorkGrid.astro';
import Areas from '../components/Areas.astro';
import ArticlesPreview from '../components/ArticlesPreview.astro';
import QuoteForm from '../components/QuoteForm.astro';
import CallButton from '../components/CallButton.astro';
import Icon from '../components/Icon.astro';
import { business, seo, image, mainPlaces } from '../data/site';
import { generalFaqs } from '../data/faq';
import { stripTags } from '../lib/links';

const faqs = generalFaqs.slice(0, 4);
const schema = [
  { '@type': 'FAQPage', '@id': `${business.url}/#faq`, mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: stripTags(f.a) } })) },
];
const slides = [image('lounge-navy-feature-wall-0037'), image('open-plan-kitchen-diner-0052'), image('mock-tudor-house-0075')];
const bandImg = image('lounge-navy-feature-wall-0036');
const aboutImg = image('white-kitchen-0108');
const usps = [
  { icon: 'clock', title: "Over Eight Years' Experience", text: 'Painting and decorating for homes and businesses.' },
  { icon: 'user', title: 'Brandon on Every Job', text: 'The owner carries out the work and oversees every job.' },
  { icon: 'shield', title: 'Fully Insured', text: 'Friendly and reliable, with a free quotation for every job.' },
];
const ring = 'TRUELINE FINISHES • PAINTING AND DECORATING • ';
---
<Base title={seo.title} description={seo.description} page="home" schema={schema}>
  <Hero
    h1="Tired Rooms? Painting and Decorating by TrueLine Finishes"
    lead="Or the outside of the house letting it down? TrueLine Finishes paints and decorates homes and businesses, from a single room to a full property redecoration, and every job starts with careful preparation."
    image={slides[0]}
    slides={slides}
  />

  <Reviews />

  <ServicesGrid
    heading="What TrueLine Finishes Can Paint and Paper for You"
    lead="Painting, wallpapering and decorating for homes and for business premises of every kind, inside and out. Rooms inside, the outside of the house, wallpaper and commercial premises: pick the job you have in mind."
    showCall={false}
    moreLine={false}
    allLink
  />

  <!-- CTA BAND (Dom's full-width band; round 3: one of Brandon's photos under the navy overlay, both buttons). -->
  <section class="hb on-dark" data-section="cta-band">
    <img class="hb__bg" src={bandImg.src} alt="" width={bandImg.width} height={bandImg.height} loading="lazy" decoding="async" />
    <div class="container hb__inner">
      <p class="hb__line">The person you call is the person who does the work.</p>
      <div class="hb__actions">
        <a href="#contact" class="btn btn-primary" data-cta="band-quote"><span class="btn__t">Quick Quote Online</span></a>
        <CallButton cta="band-call" />
      </div>
    </div>
  </section>

  <!-- PREPARATION (Dom "Choosing Flooring"): heading + accordion left; photo right with the circular text badge and the three USP boxes. -->
  <section class="hp section" id="faq" data-section="about">
    <div class="container hp__grid">
      <div class="hp__copy" data-motion="reveal">
        <h2 class="dm-h2">Preparation First, and a Finish That Lasts</h2>
        <p class="hp__p">Brandon, the owner of TrueLine Finishes, carries out the work and oversees every job. We take pride in attention to detail, lasting finishes and treating your property with care.</p>
        <div class="hp__acc">
          {faqs.map((f, i) => (
            <details class="hp__item" open={i === 0}>
              <summary><span class="hp__sign" aria-hidden="true"></span><span>{f.q}</span></summary>
              <div class="hp__a" set:html={f.a} />
            </details>
          ))}
        </div>
        <p class="hp__more"><a href="/faq/" class="dm-link" data-cta="faq-all">All questions and answers</a></p>
      </div>
      <div class="hp__media" data-motion="reveal">
        <svg class="hp__ring" viewBox="0 0 120 120" aria-hidden="true">
          <defs><path id="hp-ring" d="M60,60 m-46,0 a46,46 0 1,1 92,0 a46,46 0 1,1 -92,0" /></defs>
          <text font-size="8.6"><textPath href="#hp-ring" textLength="287" lengthAdjust="spacing">{ring}</textPath></text>
        </svg>
        <div class="hp__img"><img src={aboutImg.src} alt={aboutImg.alt} width={aboutImg.width} height={aboutImg.height} loading="lazy" decoding="async" /></div>
        <ul class="hp__boxes on-dark">
          {usps.map((u) => (
            <li class="hp__box"><span class="hp__ic"><Icon name={u.icon} size={18} /></span><h3>{u.title}</h3><p>{u.text}</p></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <Videos />

  <WorkGrid full />

  <Areas
    heading="Where to Find Us"
    body={`Painting and decorating for homes and businesses in ${mainPlaces.slice(0, -1).join(', ')} and ${mainPlaces.at(-1)}, and the towns around them, including Saltaire, Yeadon, Rawdon, Burley in Wharfedale, Leeds and Skipton.`}
  />

  <ArticlesPreview always heading="Worth Reading Before the Dust Sheets Go Down" lead="" />

  <QuoteForm />
</Base>

<style>
  /* Home 3: the resources row follows a padded section, so it takes no top padding of its own. */
  :global([data-section='areas'] + [data-section='articles']) { padding-top: 0; }

  /* CTA BAND */
  .hb { position: relative; isolation: isolate; overflow: hidden; background: var(--bg-inverse-2); padding: var(--space-24) 0; }
  .hb__bg { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; }
  .hb::before { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--overlay-band); }
  .hb__inner { display: flex; align-items: center; justify-content: space-between; gap: var(--space-8); flex-wrap: wrap; }
  .hb__line { font-family: var(--font-heading); font-size: var(--fs-5xl); line-height: 1.12; color: var(--text-inverse); max-width: 22ch; }
  .hb__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }

  /* PREPARATION + ACCORDION + USP BOXES */
  .hp__grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-16); align-items: center; }
  .hp__p { color: var(--text-secondary); margin-bottom: var(--space-8); max-width: 52ch; }
  .hp__acc { display: flex; flex-direction: column; }
  .hp__item { border-bottom: 1px solid var(--border-default); }
  .hp__item summary { list-style: none; display: flex; align-items: center; gap: var(--space-4); padding: var(--space-5) 0; cursor: pointer; font-size: var(--fs-base); color: var(--text-heading); font-weight: var(--fw-semibold); }
  .hp__item summary::-webkit-details-marker { display: none; }
  .hp__sign { position: relative; flex-shrink: 0; width: var(--space-3); height: var(--space-3); }
  .hp__sign::before, .hp__sign::after { content: ''; position: absolute; left: 0; top: 50%; width: 100%; height: 2px; background: var(--text-heading); transform: translateY(-50%); transition: transform 0.2s var(--ease); }
  .hp__sign::after { transform: translateY(-50%) rotate(90deg); }
  .hp__item[open] .hp__sign::after { transform: translateY(-50%) rotate(0deg); }
  .hp__a { padding: 0 0 var(--space-5) var(--space-8); color: var(--text-muted); font-size: var(--fs-md); }
  .hp__a :global(a) { color: var(--brand-text); font-weight: var(--fw-semibold); }
  .hp__more { margin-top: var(--space-6); }
  .hp__media { position: relative; padding: var(--space-12) 0 var(--space-16) var(--space-16); }
  .hp__img { aspect-ratio: 5 / 6; overflow: hidden; margin-left: auto; width: 82%; }
  .hp__img img { width: 100%; height: 100%; object-fit: cover; }
  .hp__ring { position: absolute; top: 0; left: var(--space-10); width: var(--space-30); height: var(--space-30); color: var(--text-heading); animation: hp-spin 24s linear infinite; }
  .hp__ring text { font-family: var(--font-heading); font-weight: var(--fw-medium); fill: currentColor; }
  @keyframes hp-spin { to { transform: rotate(360deg); } }
  .hp__boxes { position: absolute; left: 0; right: 0; bottom: 0; list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-3); }
  .hp__box { padding: var(--space-6) var(--space-5); background: var(--bg-inverse); color: var(--text-inverse-muted); }
  .hp__box h3 { font-size: var(--fs-lg); line-height: 1.2; margin: var(--space-4) 0 var(--space-2); color: var(--text-inverse); }
  .hp__box p { font-size: var(--fs-sm); line-height: var(--lh-normal); }
  .hp__ic { display: grid; place-items: center; width: var(--space-10); height: var(--space-10); border-radius: var(--radius-full); background: var(--accent-on-dark); color: var(--accent-on-dark-fg); }

  @media (max-width: 1023px) {
    .hp__grid { grid-template-columns: 1fr; }
    .hp__media { padding-left: 0; }
  }
  @media (max-width: 760px) {
    .hb { padding: var(--space-16) 0; }
    .hb__line { font-size: var(--fs-3xl); }
    .hb__actions { width: 100%; flex-direction: column; }
    .hb__actions :global(.btn) { width: 100%; }
    .hp__media { padding: var(--space-10) 0 0; }
    .hp__img { width: 100%; }
    .hp__ring { left: auto; right: var(--space-2); top: 0; width: var(--space-24); height: var(--space-24); }
    .hp__boxes { position: static; grid-template-columns: 1fr; margin-top: var(--space-3); }
  }
  @media (prefers-reduced-motion: reduce) { .hp__ring { animation: none; } }
</style>
