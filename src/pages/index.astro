---
/**
 * HOME (plan, Layout, in its order). Hero (black band: headline, CTA, phone, the kitchen Short and
 * the quote form) -> the three tiles from Brandon's reference -> the before-and-after slider
 * (bedroom, bathroom, gable wall) -> the five hubs as cards -> why choose us + how a job runs ->
 * Brandon's own photos -> the one coverage line -> reviews -> the charity line -> FAQ -> the CTA
 * band -> latest articles -> footer.
 * Home blueprint headings (seed homePage.sections): "Professional painting and decorating for every
 * property" = the H1; "Residential and commercial decorating services" = the tiles; the three
 * hub headings = the hub cards; "A quality-led service from preparation to completion" = why choose
 * us; "Talk to Brandon about your project" = the CTA band; contact-cta = the hero form.
 */
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import Steps from '../components/Steps.astro';
import OurWork from '../components/OurWork.astro';
import Reviews from '../components/Reviews.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import ArticlesPreview from '../components/ArticlesPreview.astro';
import Icon from '../components/Icon.astro';
import { business, seo, image, mainPlaces, charityLine, ctaLine } from '../data/site';
import { stripTags } from '../lib/links';

const faqs = [
  { q: 'What does TrueLine Finishes do?', a: 'All aspects of painting and decorating for homes and businesses: interior painting, exterior painting, wallpapering and commercial work, from individual rooms to full property redecorations.' },
  { q: 'Who will carry out the work?', a: 'Brandon Dawson, the owner. He carries out the work and oversees every job, and a call to 07949 484274 is a direct line to him.' },
  { q: 'Is the quotation free?', a: 'Yes. Brandon talks the job through with you and gives you a free quotation.' },
  { q: 'Which areas do you cover?', a: `Baildon, Guiseley, Menston, Ilkley, Shipley, Otley, Horsforth, Bingley and the towns around them, including Saltaire, Yeadon, Rawdon, Burley in Wharfedale, Leeds and Skipton.` },
  { q: 'Is preparation included?', a: 'Yes. Sanding, filling and caulking come with everything, and brand-new plaster gets a mist coat before the finish goes on.' },
  { q: 'Are you insured?', a: 'Yes. TrueLine Finishes is fully insured.' },
];
const schema = [
  { '@type': 'FAQPage', '@id': `${business.url}/#faq`, mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: stripTags(f.a) } })) },
  { '@type': 'VideoObject', name: 'Full kitchen renovation', embedUrl: 'https://www.youtube.com/embed/v3g1Kdja0gk', contentUrl: 'https://youtube.com/shorts/v3g1Kdja0gk', thumbnailUrl: 'https://i.ytimg.com/vi/v3g1Kdja0gk/hqdefault.jpg', uploadDate: '2026-11-03', description: 'Full kitchen renovation, from Brandon’s YouTube channel.' },
];
const tiles = [
  { icon: 'roll', title: 'Specialist Wallcoverings', text: 'Feature walls and whole rooms in paper, hung on walls prepared properly first.', links: [{ href: '/wallpapering/', label: 'Wallpapering' }], img: image('leaf-pattern-feature-wall-0026') },
  { icon: 'layers', title: 'Interior & Exterior Work', text: 'Walls, ceilings, stairs and woodwork inside; masonry, windows and doors outside.', links: [{ href: '/interior-painting/', label: 'Interior Painting' }, { href: '/exterior-painting/', label: 'Exterior Painting' }], img: image('white-staircase-spindles-0162') },
  { icon: 'office', title: 'Domestic & Commercial', text: 'Homes, offices, restaurants, schools, hotels, spas, leisure centres and local businesses.', links: [{ href: '/commercial-painting-and-decorating/', label: 'Commercial Painting and Decorating' }], img: image('office-navy-feature-wall-0178') },
];
const why = [
  { icon: 'user', title: 'Brandon on every job', text: 'Brandon Dawson, the owner, carries out the work and oversees every job.' },
  { icon: 'phone', title: 'A direct line to Brandon', text: 'Call 07949 484274 and you are talking to the person doing the work.' },
  { icon: 'clock', title: "Over eight years' experience", text: 'Painting and decorating for homes and businesses, from individual rooms to full redecorations.' },
  { icon: 'shield', title: 'Fully insured', text: 'Friendly and reliable, and fully insured.' },
  { icon: 'brush', title: 'Preparation on every job', text: 'Sanding, filling and caulking come with everything.' },
  { icon: 'check', title: 'Attention to detail', text: 'We take pride in lasting finishes and treating your property with care.' },
];
---
<Base title={seo.title} description={seo.description} page="home" schema={schema}>
  <Hero
    h1="Professional Painting and Decorating for Every Property"
    lead="Rooms looking tired, or the outside of the house letting it down? TrueLine Finishes offers painting and decorating for homes and businesses, from individual rooms to full property redecorations, with careful preparation on every job."
  />

  <section class="tl section section-tiles" data-section="tiles">
    <div class="container">
      <div class="sec-head" data-motion="reveal">
        <h2 class="sec-head__h2">Residential and commercial decorating services</h2>
        <p class="sec-head__lead">Painting, wallpapering and decorating for homes and for business premises of every kind.</p>
      </div>
      <ul class="tl__grid">
        {tiles.map((t, i) => (
          <li class="tl__tile on-dark" data-motion="reveal" style={`--reveal-delay: ${i * 70}ms`}>
            <img src={t.img.sm} alt={t.img.alt} width={t.img.width} height={t.img.height} loading="lazy" decoding="async" />
            <div class="tl__body">
              <span class="tl__ic"><Icon name={t.icon} size={24} /></span>
              <h3 class="tl__h3">{t.title}</h3>
              <p>{t.text}</p>
              <p class="tl__links">{t.links.map((l) => <a href={l.href} data-link="tile">{l.label}</a>)}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <BeforeAfter />

  <ServicesGrid heading="Interior painting, exterior painting and wallpapering" lead="Interior painting and preparation, exterior painting, wallpapering and specialist wallcoverings, and the same work for business premises." />

  <section class="wy section section-why" data-section="why">
    <div class="container">
      <div class="sec-head" data-motion="reveal">
        <h2 class="sec-head__h2">A quality-led service from preparation to completion</h2>
        <p class="sec-head__lead">Why people choose TrueLine Finishes.</p>
      </div>
      <ul class="wy__grid">
        {why.map((w, i) => (
          <li class="wy__item" data-motion="reveal" style={`--reveal-delay: ${(i % 3) * 60}ms`}>
            <span class="wy__ic"><Icon name={w.icon} size={24} /></span>
            <h3>{w.title}</h3>
            <p>{w.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Steps
    heading="How a job runs"
    lead="Three steps, and you deal with Brandon from the first call to the last coat."
    photo="kitchen-diner-protected-0007"
    steps={[
      { icon: 'chat', title: 'Get in touch', text: 'Call Brandon directly, use the quote form or send a WhatsApp message.' },
      { icon: 'clipboard', title: 'A free quotation', text: 'Brandon talks the job through with you and gives you a free quotation.' },
      { icon: 'roller', title: 'The work, done properly', text: 'Preparation first, floors and surfaces protected, with Brandon carrying out the work and overseeing the job.' },
    ]}
  />

  <OurWork />

  <section class="cov section section--panel section-coverage" data-section="coverage">
    <div class="container cov__inner" data-motion="reveal">
      <Icon name="house" size={28} />
      <p>Painting and decorating for homes and businesses in {mainPlaces.slice(0, -1).join(', ')} and {mainPlaces.at(-1)}, and the towns around them.</p>
    </div>
  </section>

  <Reviews />

  <section class="ch section section-charity" data-section="charity">
    <div class="container ch__inner" data-motion="reveal"><Icon name="heart" size={24} /><p>{charityLine}</p></div>
  </section>

  <Faq items={faqs} heading="Questions people ask before they call" lead="Straight answers about the work, the quotation and who does the job." />

  <CtaBand heading="Talk to Brandon about your project" line={ctaLine} />

  <ArticlesPreview />
</Base>

<style>
  .tl__grid { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6); }
  .tl__tile { position: relative; display: flex; flex-direction: column; background: var(--bg-inverse); color: var(--text-inverse-muted); border-top: 3px solid var(--accent-on-dark); }
  .tl__tile img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; }
  .tl__body { flex: 1; display: flex; flex-direction: column; gap: var(--space-3); padding: var(--space-6) var(--card-pad) var(--card-pad); }
  .tl__ic { display: grid; place-items: center; width: var(--space-12); height: var(--space-12); margin-top: calc(-1 * var(--space-12)); border-radius: var(--badge-radius); background: var(--accent-on-dark); color: var(--accent-on-dark-fg); border: 4px solid var(--bg-inverse); }
  .tl__h3 { font-size: var(--fs-2xl); color: var(--text-inverse); }
  .tl__links { margin-top: auto; display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); padding-top: var(--space-2); }
  .tl__links a { color: var(--text-inverse); font-weight: var(--fw-semibold); text-decoration: underline; text-decoration-color: var(--accent-on-dark); text-decoration-thickness: 2px; text-underline-offset: 4px; }
  .tl__links a:hover { color: var(--accent-on-dark); }
  .wy__grid { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6); }
  .wy__item { padding: var(--card-pad); background: var(--bg-panel); border-top: 2px solid var(--brand-primary); }
  .wy__item h3 { font-size: var(--fs-xl); margin: var(--space-4) 0 var(--space-2); }
  .wy__item p { color: var(--text-primary); font-size: var(--fs-md); }
  .wy__ic { display: grid; place-items: center; width: var(--space-12); height: var(--space-12); border-radius: var(--badge-radius); background: var(--brand-primary); color: var(--brand-fg); }
  .cov { padding: var(--space-10) 0; }
  .cov__inner { display: flex; gap: var(--space-4); align-items: center; font-size: var(--fs-lg); color: var(--text-primary); }
  .cov__inner :global(.icon) { color: var(--brand-primary); flex-shrink: 0; }
  .ch { padding: var(--space-10) 0; background: var(--bg-inverse); }
  .ch__inner { display: flex; gap: var(--space-3); align-items: center; justify-content: center; color: var(--text-inverse); font-size: var(--fs-lg); text-align: center; }
  .ch__inner :global(.icon) { color: var(--accent-on-dark); flex-shrink: 0; }
  @media (max-width: 900px) { .tl__grid, .wy__grid { grid-template-columns: 1fr; } }
</style>
