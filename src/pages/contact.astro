---
/**
 * CONTACT (seed: nap / enquiry-form / hours; plan, Contact): the name, the phone, the email, the
 * WhatsApp button, the opening hours exactly as the Google listing, the quote form, and the map
 * embed of the Google listing by CID. NO address anywhere (addressDisplay "no").
 */
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Reviews from '../components/Reviews.astro';
import MapEmbed from '../components/MapEmbed.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Icon from '../components/Icon.astro';
import { business, hours, image } from '../data/site';
const pageUrl = `${business.url}/contact/`;
const schema = [
  { '@type': 'ContactPage', '@id': `${pageUrl}#contact-page`, url: pageUrl, name: `Contact ${business.name}`, about: { '@id': `${business.url}/#business` } },
  { '@type': 'BreadcrumbList', '@id': `${pageUrl}#crumbs`, itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${business.url}/` }, { '@type': 'ListItem', position: 2, name: 'Contact', item: pageUrl }] },
];
---
<Base title="Contact Brandon About Painting and Decorating | TrueLine Finishes" description="Call Brandon on 07949 484274, email Brandon@truelinefinishes.com, WhatsApp, or use the quote form. Open Monday to Friday 7am to 7pm, Saturday and Sunday 8am to 6pm." page="contact" schema={schema}>
  <PageHero h1="Contact TrueLine Finishes" lead="Get a free quotation: call Brandon on 07949 484274 or use the quote form. A call is a direct line to Brandon." image={image('white-sash-window-stone-0029')} />
  <Reviews />
  <section class="ct section section-nap" data-section="nap">
    <div class="container">
      <h2 class="ct__h2">{business.name}</h2>
      <ul class="ct__cards">
        <li class="ct__card ct__card--on on-dark"><span class="ct__ic"><Icon name="phone" size={24} /></span><h3>Call Brandon</h3><p><a href={business.phoneHref} data-cta="contact-call">{business.phone}</a></p></li>
        <li class="ct__card"><span class="ct__ic"><Icon name="mail" size={24} /></span><h3>Email</h3><p><a href={`mailto:${business.email}`} data-cta="contact-email">{business.email}</a></p></li>
        <li class="ct__card"><span class="ct__ic"><Icon name="whatsapp" size={24} /></span><h3>WhatsApp</h3><p><a href={business.whatsappHref} target="_blank" rel="noopener" data-cta="contact-whatsapp">Message Brandon on WhatsApp</a></p></li>
        <li class="ct__card" id="hours"><span class="ct__ic"><Icon name="clock" size={24} /></span><h3>Opening hours</h3>{hours.map((h) => <p>{h.days}<br /><strong>{h.time}</strong></p>)}</li>
      </ul>
      <div class="ct__map" data-motion="reveal"><MapEmbed /></div>
    </div>
  </section>
  <QuoteForm heading="Send Brandon the details" />
</Base>
<style>
  .ct__h2 { font-size: var(--fs-3xl); margin-bottom: var(--space-6); }
  .ct__cards { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-5); }
  .ct__card { padding: var(--card-pad); background: var(--bg-panel); border-top: 2px solid var(--border-strong); overflow-wrap: anywhere; }
  .ct__card p + p { margin-top: var(--space-2); }
  .ct__card--on { background: var(--bg-inverse); border-top-color: var(--accent-on-dark); color: var(--text-inverse-muted); }
  .ct__card h3 { font-size: var(--fs-xl); margin: var(--space-4) 0 var(--space-2); }
  .ct__card a { font-weight: var(--fw-semibold); color: var(--brand-text); text-decoration: underline; text-underline-offset: 3px; }
  .ct__card--on h3, .ct__card.ct__card--on a { color: var(--text-inverse); }
  .ct__card.ct__card--on a { font-size: var(--fs-xl); text-decoration-color: var(--accent-on-dark); }
  .ct__ic { display: grid; place-items: center; width: var(--icon-circle); height: var(--icon-circle); border-radius: var(--badge-radius); background: var(--bg-card); color: var(--brand-text); }
  .ct__card--on .ct__ic { background: var(--accent-on-dark); color: var(--accent-on-dark-fg); }
  .ct__map { margin-top: var(--space-10); height: calc(var(--space-30) * 3.5); }
  @media (max-width: 1023px) { .ct__cards { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .ct__cards { grid-template-columns: 1fr; } }
</style>
