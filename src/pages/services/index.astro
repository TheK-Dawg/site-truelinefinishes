---
/**
 * SERVICES INDEX (Buildings for Life services page, operator overhaul 5 Nov 2026): all six hubs
 * as cards, how a job runs, Brandon's work, a short FAQ, the quote form last. The hubs stay at
 * their locked root URLs; this page only lists them.
 */
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Reviews from '../../components/Reviews.astro';
import ServicesGrid from '../../components/ServicesGrid.astro';
import Steps from '../../components/Steps.astro';
import WorkGrid from '../../components/WorkGrid.astro';
import Faq from '../../components/Faq.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import { business, services, image } from '../../data/site';
import { generalFaqs } from '../../data/faq';
import { stripTags } from '../../lib/links';

const faqs = generalFaqs.filter((f) => ['What does TrueLine Finishes do?', 'Who will carry out the work?', 'Is preparation included?'].includes(f.q));
const pageUrl = `${business.url}/services/`;
const schema = [
  { '@type': 'CollectionPage', '@id': `${pageUrl}#collection`, name: 'Painting and decorating services', url: pageUrl, hasPart: services.map((s) => ({ '@type': 'Service', name: s.name, url: `${business.url}/${s.slug}/` })) },
  { '@type': 'FAQPage', '@id': `${pageUrl}#faq`, mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: stripTags(f.a) } })) },
  { '@type': 'BreadcrumbList', '@id': `${pageUrl}#crumbs`, itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${business.url}/` }, { '@type': 'ListItem', position: 2, name: 'Services', item: pageUrl }] },
];
---
<Base title="Painting and Decorating Services in West Yorkshire | TrueLine Finishes" description="Painting and decorating, interior and exterior painting, wallpapering, commercial work and fencing for homes and business premises across West and North Yorkshire." page="services" schema={schema}>
  <PageHero h1="Painting and Decorating in West and North Yorkshire" lead="Six services, one standard of preparation and finish, for homes and business premises across Baildon, Shipley, Ilkley, Leeds, Bradford, Harrogate and the towns around them." image={image('white-staircase-spindles-0162')} />
  <Reviews />
  <ServicesGrid heading="Pick the Job You Have in Mind" lead="Interiors, exteriors, wallpaper, business premises and fencing, inside and out. Pick the job you have in mind and see how it is done." />
  <Steps heading="How a Job Runs" lead="The same three steps whether it is one room or the whole house." photo="living-room-sheeted-0138" steps={[
    { icon: 'chat', title: 'Get in Touch', text: 'Call 07949 484274, use the quote form or send a WhatsApp message.' },
    { icon: 'clipboard', title: 'A Free Quotation', text: 'The job is talked through with you, then quoted. Quotations are free.' },
    { icon: 'roller', title: 'The Work, Done Properly', text: 'Floors and surfaces protected, cracks filled, gaps caulked and surfaces sanded, then the paint.' },
  ]} />
  <WorkGrid />
  <Faq items={faqs} heading="Questions About the Work" allLink />
  <QuoteForm />
</Base>
