---
/** SERVICES HUB (directory, LAW R10): every plan hub as a card, then how a job runs, work, FAQ, form. */
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Reviews from '../../components/Reviews.astro';
import ServicesGrid from '../../components/ServicesGrid.astro';
import Steps from '../../components/Steps.astro';
import OurWork from '../../components/OurWork.astro';
import Faq from '../../components/Faq.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import { business, services, image } from '../../data/site';
import { stripTags } from '../../lib/links';

const faqs = [
  { q: 'Can one firm really handle a whole build?', a: 'Yes. We dig and pour the foundations, lay the drainage, build the brick and block walls, put the steels and roof on, fit the joinery and finish the inside. Keeping those trades in one family firm is how jobs stay on programme.' },
  { q: 'What does the 10-year warranty apply to?', a: 'New builds. The 10-year warranty applies to the new homes we build, and to new builds only.' },
  { q: 'Do you work from an architect’s drawings?', a: 'Yes, and most extensions, lofts and new builds start that way. If you do not have drawings yet, tell us on the Quick Quote form and we can talk through what the job needs before anything is drawn.' },
];
const pageUrl = `${business.url}/services/`;
const schema = [
  { '@type': 'CollectionPage', '@id': `${pageUrl}#collection`, name: 'Building services', url: pageUrl, hasPart: services.map((s) => ({ '@type': 'Service', name: s.name, url: `${business.url}/${s.slug}/` })) },
  { '@type': 'FAQPage', '@id': `${pageUrl}#faq`, mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: stripTags(f.a) } })) },
  { '@type': 'BreadcrumbList', '@id': `${pageUrl}#crumbs`, itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${business.url}/` }, { '@type': 'ListItem', position: 2, name: 'Services', item: pageUrl }] },
];
---
<Base title="Building Services in Hedge End & Southampton | Buildings For Life" description="New builds, extensions, loft and basement conversions, brickwork, stone, groundworks, patios, landscaping and carpentry from one family-run Hampshire builder." page="services" schema={schema}>
  <PageHero eyebrow="Our Services" h1="Building services, from the footings to the finish" lead="Ten kinds of work, one family firm. Pick the job below to see how we do it, or send the details and we will tell you what it involves." image={image('tudor-house-renovation')} crumbs={[{ label: 'Services' }]} />
  <Reviews />
  <ServicesGrid heading="Pick the job you have in mind" lead="Every card below is work our own team carries out. Most larger jobs use several of them: an extension is groundworks, brickwork, structure, roof and joinery." />
  <Steps heading="How a job runs with us" lead="The same three steps whether it is a garden wall or a new house." steps={[
    { icon: 'chat', title: 'Tell us the job', text: 'Quick Quote Online or a call, with what you want built, the postcode and any drawings.' },
    { icon: 'clipboard', title: 'Visit and written quote', text: 'We see the site, the access and the ground, then put the price and scope in writing.' },
    { icon: 'hammer', title: 'Build and sign-off', text: 'Our own team on site, inspections booked, and sign-off at handover.' },
  ]} photo="rear-extension-glazing" />
  <OurWork />
  <Faq items={faqs} heading="About the services we offer" />
  <QuoteForm />
</Base>
