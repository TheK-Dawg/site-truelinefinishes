---
/** RESOURCES (/resources/, never "blog" or "guides"): published articles as cards; the hubs below. Articles are written by the engine after handoff. */
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Reviews from '../../components/Reviews.astro';
import ArticlesPreview from '../../components/ArticlesPreview.astro';
import ServicesGrid from '../../components/ServicesGrid.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import { articles, articleUrl } from '../../data/articles';
import { business, image } from '../../data/site';
const pageUrl = `${business.url}/resources/`;
const schema = [
  { '@type': 'CollectionPage', '@id': `${pageUrl}#resources`, name: 'Painting and decorating resources', url: pageUrl, hasPart: articles.map((a) => ({ '@type': 'Article', headline: a.title, url: `${business.url}${articleUrl(a)}` })) },
  { '@type': 'BreadcrumbList', '@id': `${pageUrl}#crumbs`, itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${business.url}/` }, { '@type': 'ListItem', position: 2, name: 'Resources', item: pageUrl }] },
];
---
<Base title="Painting and Decorating Resources | TrueLine Finishes" description="Resources from TrueLine Finishes on painting and decorating, interior and exterior painting, wallpapering and commercial work, town by town." page="resources" schema={schema}>
  <PageHero h1="Painting and Decorating Resources" lead="Answers to the questions people ask before a room, a house or business premises is decorated." image={image('room-dust-sheets-0085')} />
  <Reviews />
  {articles.length > 0
    ? <ArticlesPreview heading="All resources" lead="Service by service and town by town." limit={999} />
    : <section class="section"><div class="container"><p class="rs__empty">The first resources are being written. In the meantime, the service pages below explain each kind of work and how a job runs.</p></div></section>}
  <ServicesGrid heading="The work these resources are about" showCall={false} />
  <QuoteForm />
</Base>
<style>.rs__empty { max-width: 70ch; font-size: var(--fs-lg); color: var(--text-primary); }</style>
