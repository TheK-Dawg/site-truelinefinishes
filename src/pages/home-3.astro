---
/**
 * HOME VARIANT 3 (TEMPORARY, operator experiment 5 Nov 2026: brief TRUELINE-VARIANTS-BRIEF.md).
 * Deleted once the operator picks a homepage. noindex, out of the sitemap, linked from nowhere.
 * LAYOUT: the section flow of https://dom.themerex.net/ (captured 5 Nov): full-bleed photo
 * slider with a centred headline, a pill CTA, round arrows and slider dots; the centred head +
 * four tall image tiles with their names on the photo (here the five hubs); the testimonials band
 * over a photo (moved UP under the second section, operator rule); the full-width accent band
 * with a pill; the accordion + photo block with the circular text badge and the dark stat boxes
 * (here the three USP cards); the full-bleed 3 x 2 photo grid; the product grid (here the home
 * page's three tiles); the recent-articles row; the subscribe band (here the Formlane form).
 * CONTENT: TrueLine's own copy from the live home page, Brandon's photos (R2 pool), no address,
 * no reviews written, no rating or count, no video, no form in the hero, no before/after slider.
 * COLOURS: the reference's orange is NOT used; layered blues from tokens.css (--v-*), the
 * accent band in the logo's royal. The page re-points the semantic tokens on its own
 * <body data-page="home-3">, so the shared header, footer and sticky bar take the blue grounds
 * here and nowhere else.
 */
import Base from '../layouts/Base.astro';
import TrustindexSlot from '../components/TrustindexSlot.astro';
import Icon from '../components/Icon.astro';
import { business, seo, image, services, hours } from '../data/site';
import { articles, articleUrl } from '../data/articles';
import { generalFaqs } from '../data/faq';
import { stripTags } from '../lib/links';

const faqs = generalFaqs.slice(0, 4);
const schema = [
  { '@type': 'FAQPage', '@id': `${business.url}/home-3/#faq`, mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: stripTags(f.a) } })) },
];
const slides = [image('lounge-navy-feature-wall-0037'), image('open-plan-kitchen-diner-0052'), image('mock-tudor-house-0075')];
const reviewsBg = image('grey-living-room-0134');
const aboutImg = image('white-kitchen-0108');
const grid = ['green-bedroom-0136', 'victorian-hallway-0067', 'sage-kitchen-0011', 'navy-front-door-stone-0027', 'lounge-dark-arched-alcove-0101', 'stone-terrace-sage-door-0191'].map(image);
const usps = [
  { icon: 'clock', title: "Over Eight Years' Experience", text: 'Painting and decorating for homes and businesses.' },
  { icon: 'user', title: 'Brandon on Every Job', text: 'The owner carries out the work and oversees every job.' },
  { icon: 'shield', title: 'Fully Insured', text: 'Friendly and reliable, with a free quotation for every job.' },
];
const tiles = [
  { img: image('leaf-pattern-feature-wall-0026'), h3: 'Specialist Wallcoverings', html: 'Feature walls and whole rooms in paper, hung on walls prepared properly first. See <a href="/wallpapering/" data-link="tile">Wallpapering</a>.' },
  { img: image('stone-farmhouse-0092'), h3: 'Interior & Exterior Work', html: 'Walls, ceilings, stairs and woodwork inside with <a href="/interior-painting/" data-link="tile">Interior Painting</a>; masonry, windows and doors outside with <a href="/exterior-painting/" data-link="tile">Exterior Painting</a>.' },
  { img: image('office-navy-feature-wall-0178'), h3: 'Domestic & Commercial', html: 'Homes, offices, restaurants, schools, hotels, spas, leisure centres and local businesses. See <a href="/commercial-painting-and-decorating/" data-link="tile">Commercial Painting and Decorating</a>.' },
];
const hubName = (slug: string) => services.find((s) => s.slug === slug)?.name ?? '';
const list = articles.slice(0, 4);
const FORMLANE_FORM = 'f_5ELbk5JcKfFh2EEaclT6';
const FORMLANE_TOKEN = 'npGnYEsjXAHrYRp13No3gA';
const ring = 'TRUELINE FINISHES • PAINTING AND DECORATING • ';
---
<Base title={seo.title} description={seo.description} page="home-3" schema={schema} noindex>
  <!-- HERO (Dom): full-bleed photo slider, centred headline + pill CTA, round arrows, dots. Photos only change; the headline stays. -->
  <section class="dm-hero on-dark" data-section="hero" data-hero-variant="dom" data-slider>
    <div class="dm-hero__slides" aria-hidden="true">
      {slides.map((s, i) => <img class:list={['dm-hero__bg', i === 0 && 'is-on']} src={s.src} alt="" width={s.width} height={s.height} fetchpriority={i === 0 ? 'high' : undefined} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />)}
    </div>
    <div class="dm-hero__copy container">
      <h1 class="dm-hero__h1">Tired Rooms? Painting and Decorating by Brandon</h1>
      <p class="dm-hero__lead">Or the outside of the house letting it down? TrueLine Finishes paints and decorates homes and businesses, from a single room to a full property redecoration, and every job starts with careful preparation.</p>
      <div class="dm-hero__actions">
        <a href="#contact" class="btn dm-pill dm-pill--chrome" data-cta="hero-quote"><span class="btn__t">Quick Quote Online</span></a>
        <a href={business.phoneHref} class="btn dm-pill dm-pill--glass" data-cta="hero-call"><Icon name="phone" size={16} /><span class="btn__t">Call {business.phone}</span></a>
      </div>
      <TrustindexSlot role="slimline" place="slim-hero" ground="dark" align="center" class="dm-hero__ti" />
    </div>
    <button type="button" class="dm-hero__arrow dm-hero__arrow--prev" data-slide-prev aria-label="Previous photo"><Icon name="chevronLeft" size={22} /></button>
    <button type="button" class="dm-hero__arrow dm-hero__arrow--next" data-slide-next aria-label="Next photo"><Icon name="chevronRight" size={22} /></button>
    <div class="dm-hero__dots" role="group" aria-label="Choose a photo">
      {slides.map((s, i) => <button type="button" class:list={['dm-hero__dot', i === 0 && 'is-on']} data-slide-to={i} aria-label={`Photo ${i + 1}: ${s.alt}`} aria-pressed={i === 0 ? 'true' : 'false'}></button>)}
    </div>
  </section>

  <!-- REVIEWS (Dom testimonials band over a photo), directly under the hero (operator, 6 Nov 2026: the MAIN Trustindex widget under the hero on every page). -->
  <section class="dm-rv on-dark" id="reviews" data-section="reviews" data-ai-skip>
    <img class="dm-rv__bg" src={reviewsBg.src} alt="" width={reviewsBg.width} height={reviewsBg.height} loading="lazy" decoding="async" />
    <div class="container dm-rv__inner">
      <div class="dm-rv__head" data-motion="reveal">
        <h2 class="rv__h2">What customers say about us</h2>
        <p class="dm-rv__lead">Reviews come straight from TrueLine Finishes' Google Business Profile, in the customers' own words.</p>
        <a href="/gallery/" class="btn dm-pill dm-pill--chrome" data-cta="reviews-gallery"><span class="btn__t">See Brandon's Work</span></a>
      </div>
      <TrustindexSlot role="main" place="reviews" class="dm-rv__widget" />
    </div>
  </section>

  <!-- SERVICES (Dom "We Provide All Types"): centred head + chevron, tall image tiles with the hub name on the photo. -->
  <section class="dm-sec dm-sv" id="services" data-section="services">
    <div class="container">
      <div class="dm-head dm-head--c" data-motion="reveal">
        <h2 class="dm-h2">What Brandon Can Paint and Paper for You</h2>
        <p class="dm-lead">Rooms inside, the outside of the house, wallpaper and business premises: pick the job you have in mind.</p>
        <span class="dm-head__chev" aria-hidden="true"><Icon name="chevronDown" size={18} /></span>
      </div>
      <ul class="dm-sv__grid">
        {services.map((s, i) => (
          <li class="dm-sv__tile" data-motion="reveal" style={`--reveal-delay: ${i * 60}ms`}>
            <img src={s.image.sm} alt={s.image.alt} width={s.image.width} height={s.image.height} loading="lazy" decoding="async" />
            <div class="dm-sv__cap on-dark">
              <h3 class="dm-sv__title"><a href={`/${s.slug}/`} data-link="card">{s.name}</a></h3>
              <p class="dm-sv__body">{s.short}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ACCENT BAND (Dom's full-width colour band): royal blue, line left, pill right. -->
  <section class="dm-band on-dark" data-section="cta-band">
    <div class="container dm-band__inner">
      <p class="dm-band__line">The person you call is the person who does the work.</p>
      <a href="#contact" class="btn dm-pill dm-pill--ink" data-cta="band-quote"><span class="btn__t">Quick Quote Online</span></a>
    </div>
  </section>

  <!-- ABOUT (Dom "Choosing Flooring"): heading + accordion left; photo right with the circular text badge and the dark boxes (here the three USP cards). -->
  <section class="dm-sec dm-ab" id="faq" data-section="about">
    <div class="container dm-ab__grid">
      <div class="dm-ab__copy" data-motion="reveal">
        <h2 class="dm-h2">Preparation First, and a Finish That Lasts</h2>
        <p class="dm-ab__p">Brandon Dawson, the owner, carries out the work and oversees every job. We take pride in attention to detail, lasting finishes and treating your property with care.</p>
        <div class="dm-acc">
          {faqs.map((f, i) => (
            <details class="dm-acc__item" open={i === 0}>
              <summary><span class="dm-acc__sign" aria-hidden="true"></span><span>{f.q}</span></summary>
              <div class="dm-acc__a" set:html={f.a} />
            </details>
          ))}
        </div>
        <p class="dm-ab__more"><a href="/faq/" class="dm-link" data-cta="faq-all">All questions and answers</a></p>
      </div>
      <div class="dm-ab__media" data-motion="reveal">
        <svg class="dm-ab__ring" viewBox="0 0 120 120" aria-hidden="true">
          <defs><path id="dm-ring" d="M60,60 m-46,0 a46,46 0 1,1 92,0 a46,46 0 1,1 -92,0" /></defs>
          <text font-size="8.6"><textPath href="#dm-ring" textLength="287" lengthAdjust="spacing">{ring}</textPath></text>
        </svg>
        <div class="dm-ab__img"><img src={aboutImg.src} alt={aboutImg.alt} width={aboutImg.width} height={aboutImg.height} loading="lazy" decoding="async" /></div>
        <ul class="dm-ab__boxes on-dark">
          {usps.map((u) => (
            <li class="dm-ab__box"><span class="dm-ab__ic"><Icon name={u.icon} size={18} /></span><h3>{u.title}</h3><p>{u.text}</p></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- PHOTO GRID (Dom's full-bleed 3 x 2 grid): Brandon's own photos, each opens in the root lightbox. -->
  <section class="dm-gl" data-section="gallery" data-ai-skip>
    <h2 class="visually-hidden">Brandon's work, photographed on the job</h2>
    <ul class="dm-gl__grid" data-gallery>
      {grid.map((g) => (
        <li><button type="button" class="dm-gl__shot" data-lightbox aria-label={`Open larger: ${g.alt}`}><img src={g.sm} data-full={g.src} alt={g.alt} width={g.width} height={g.height} loading="lazy" decoding="async" /></button></li>
      ))}
    </ul>
  </section>

  <!-- THREE TILES (Dom's product grid): centred head, square photos with the title and text under, one pill. -->
  <section class="dm-sec dm-tl" data-section="craft">
    <div class="container">
      <div class="dm-head dm-head--c" data-motion="reveal">
        <h2 class="dm-h2">For Homes and Business Premises, Inside and Out</h2>
        <p class="dm-lead">Painting, wallpapering and decorating for homes and for business premises of every kind, inside and out.</p>
      </div>
      <ul class="dm-tl__grid">
        {tiles.map((t, i) => (
          <li class="dm-tl__card" data-motion="reveal" style={`--reveal-delay: ${i * 70}ms`}>
            <div class="dm-tl__img"><img src={t.img.sm} alt={t.img.alt} width={t.img.width} height={t.img.height} loading="lazy" decoding="async" /></div>
            <h3 class="dm-tl__h3">{t.h3}</h3>
            <p class="dm-tl__p" set:html={t.html} />
          </li>
        ))}
      </ul>
      <div class="dm-center"><a href="/services/" class="btn dm-pill dm-pill--royal" data-cta="services-all"><span class="btn__t">View All Services</span></a></div>
    </div>
  </section>

  <!-- RESOURCES (Dom "Recent Articles"): left head, a row of image cards with the category label. -->
  <section class="dm-sec dm-ap" id="resources" data-section="articles">
    <div class="container">
      <div class="dm-head dm-head--row" data-motion="reveal">
        <h2 class="dm-h2">Worth Reading Before the Dust Sheets Go Down</h2>
        <a href="/resources/" class="dm-link" data-cta="articles-all">All resources</a>
      </div>
      <ul class="dm-ap__grid">
        {list.map((a, i) => {
          const img = image(a.hero);
          return (
            <li class="dm-ap__card" data-motion="reveal" style={`--reveal-delay: ${i * 70}ms`}>
              <div class="dm-ap__img"><img src={img.sm} alt={img.alt} width={img.width} height={img.height} loading="lazy" decoding="async" /></div>
              <span class="dm-ap__cat">{hubName(a.hub)}</span>
              <h3 class="dm-ap__title"><a href={articleUrl(a)} data-link="card">{a.title}</a></h3>
              <p class="dm-ap__sum">{a.summary}</p>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <!-- QUOTE FORM (Dom's subscribe band): pale band, big heading left, the Formlane form right in pill fields. -->
  <section class="dm-sec dm-qf section-quote-form" id="quote-section" data-section="quote-form" data-ai-skip>
    <div class="container dm-qf__grid">
      <div class="dm-qf__copy" data-motion="reveal">
        <h2 class="dm-h2">Tell Brandon About the Job</h2>
        <p class="dm-qf__lead">Leave your name, email, phone number and postcode, with a line or two about the job. Brandon will talk it through with you and give you a free quotation.</p>
        <ul class="dm-qf__list">
          <li><Icon name="check" size={16} /> Free quotations</li>
          <li><Icon name="check" size={16} /> A call is a direct line to Brandon</li>
          <li><Icon name="check" size={16} /> Fully insured, over eight years' experience</li>
        </ul>
        <div class="dm-qf__call">
          <a href={business.phoneHref} class="btn dm-pill dm-pill--ink" data-cta="form-call"><Icon name="phone" size={16} /><span class="btn__t">Call {business.phone}</span></a>
          <a href={business.whatsappHref} class="btn dm-pill dm-pill--line dm-pill--desc" target="_blank" rel="noopener" data-cta="form-whatsapp"><Icon name="whatsapp" size={16} /><span class="btn__t">WhatsApp Brandon</span></a>
        </div>
        <p class="dm-qf__hours"><Icon name="clock" size={16} /> Open {hours.map((h) => `${h.days} ${h.time}`).join(', ')}</p>
      </div>
      <div class="dm-qf__card">
        <h3 class="dm-qf__form-h">Quick Quote Online</h3>
        <TrustindexSlot role="slimline" place="slim-form" class="dm-qf__ti" />
        <div class="dm-qf__form" id="contact" data-quote-card data-lead-form={FORMLANE_FORM} data-lf-token={FORMLANE_TOKEN}>
          <noscript><p>The quote form needs JavaScript. Call Brandon on <a href={business.phoneHref}>{business.phone}</a> instead.</p></noscript>
        </div>
        <p class="dm-qf__secure"><Icon name="lock" size={15} /> Any submission through this form is secure. We do not sell your details to third parties.</p>
      </div>
      <script is:inline src="https://api.formlane.uk/edge/form.js" defer></script>
    </div>
  </section>
</Base>

<script>
  // Dom hero slider: cross-fades Brandon's photos behind the fixed headline. Auto-advance pauses
  // on hover/focus, off-screen and under reduced motion; arrows and dots always work.
  const root = document.querySelector<HTMLElement>('[data-slider]');
  if (root) {
    const imgs = [...root.querySelectorAll<HTMLImageElement>('.dm-hero__bg')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-slide-to]')];
    let at = 0; let timer = 0; let visible = true;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const go = (n: number) => {
      at = (n + imgs.length) % imgs.length;
      imgs.forEach((im, i) => { im.classList.toggle('is-on', i === at); if (i === at) im.loading = 'eager'; });
      dots.forEach((d, i) => { d.classList.toggle('is-on', i === at); d.setAttribute('aria-pressed', String(i === at)); });
    };
    const stop = () => { window.clearInterval(timer); timer = 0; };
    const start = () => { if (reduce || timer || !visible) return; timer = window.setInterval(() => go(at + 1), 6000); };
    root.querySelector('[data-slide-prev]')?.addEventListener('click', () => { go(at - 1); stop(); start(); });
    root.querySelector('[data-slide-next]')?.addEventListener('click', () => { go(at + 1); stop(); start(); });
    dots.forEach((d) => d.addEventListener('click', () => { go(Number(d.dataset.slideTo)); stop(); start(); }));
    root.addEventListener('mouseenter', stop); root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop); root.addEventListener('focusout', start);
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; visible ? start() : stop(); }).observe(root);
    start();
  }
</script>

<style is:global>
  /* Page-only token re-point (body[data-page="home-3"]): blue grounds (fonts re-pointed in tokens.css), pill buttons, title-case headings. */
  body[data-page='home-3'] {
    --bg-inverse: var(--v-ink-900);
    --bg-inverse-2: var(--v-ink-800);
    --bg-inverse-deep: var(--v-ink-900);
    --bg-panel: var(--v-mist-50);
    --bg-subtle: var(--v-mist-50);
    --text-primary: var(--v-ink-900);
    --text-secondary: var(--v-ink-700);
    --text-heading: var(--v-ink-900);
    --text-muted: var(--v-slate-600);
    --text-inverse-muted: var(--v-mist-300);
    --border-default: var(--v-mist-200);
    --border-inverse: var(--v-line-dark);
    --glass: var(--v-glass-light);
    --glass-card: var(--v-glass-dark);
    --brand-primary: var(--v-royal);
    --brand-hover: var(--v-royal-hover);
    --btn-radius: var(--radius-full);
    --input-radius: var(--radius-full);
  }
  body[data-page='home-3'] h1, body[data-page='home-3'] h2, body[data-page='home-3'] h3, body[data-page='home-3'] h4 { text-transform: none; letter-spacing: 0; font-variant-caps: normal; font-weight: var(--fw-regular); }
  body[data-page='home-3'] .btn { text-transform: none; letter-spacing: 0; font-family: var(--font-heading); font-weight: var(--fw-medium); }
  /* The logo carries its own black ground: lighten lets the navy header show through it. */
  body[data-page='home-3'] .hd__brand img, body[data-page='home-3'] .ft__brand img { mix-blend-mode: lighten; }
</style>

<style>
  .dm-sec { padding: var(--section-pad) 0; }
  .dm-h2 { font-size: var(--fs-5xl); line-height: 1.12; margin-bottom: var(--space-5); }
  .dm-lead { color: var(--text-muted); max-width: 62ch; }
  .dm-head { margin-bottom: var(--space-12); }
  .dm-head--c { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .dm-head--c .dm-h2 { max-width: 24ch; }
  .dm-head__chev { margin-top: var(--space-5); color: var(--v-slate-600); }
  .dm-head--row { display: flex; justify-content: space-between; align-items: flex-end; gap: var(--space-8); }
  .dm-head--row .dm-h2 { margin-bottom: 0; max-width: 24ch; }
  .dm-center { display: flex; justify-content: center; margin-top: var(--space-12); }
  .dm-link { font-family: var(--font-heading); font-weight: var(--fw-medium); color: var(--v-royal); transition: color 0.2s var(--ease); white-space: nowrap; }
  .dm-link:hover { color: var(--v-ink-900); }

  .dm-pill { min-height: var(--btn-h-md); padding: 0 var(--space-8); gap: var(--space-2); font-size: var(--fs-md); }
  .dm-pill--chrome { background: var(--v-chrome); color: var(--v-ink-900); }
  .dm-pill--chrome:hover { background: var(--v-chrome-hover); }
  .dm-pill--glass { background: var(--v-glass-light); color: var(--v-white); box-shadow: inset 0 0 0 1px var(--v-glass-line); backdrop-filter: blur(4px); }
  .dm-pill--glass :global(.icon) { color: var(--v-chrome); }
  .dm-pill--ink { background: var(--v-ink-900); color: var(--v-white); }
  .dm-pill--ink:hover { background: var(--v-ink-700); }
  .dm-pill--ink :global(.icon) { color: var(--v-chrome); }
  .dm-pill--royal { background: var(--v-royal); color: var(--v-white); }
  .dm-pill--royal:hover { background: var(--v-royal-hover); }
  .dm-pill--line { background: var(--v-white); color: var(--v-ink-900); box-shadow: inset 0 0 0 1px var(--v-mist-200); }
  /* Mixed-case labels with descenders: lift the cap box 1px so cap top and descender bottom balance (scripts/check.mjs). */
  .dm-pill--desc .btn__t { transform: translateY(-1px); }
  .dm-pill--line:hover { box-shadow: inset 0 0 0 1px var(--v-royal); }

  /* HERO SLIDER */
  .dm-hero { position: relative; isolation: isolate; overflow: hidden; display: flex; flex-direction: column; justify-content: center; min-height: min(calc(100vh - var(--space-8)), calc(var(--space-30) * 7)); padding: calc(var(--header-h) + var(--space-20)) 0 var(--space-24); background: var(--v-ink-900); text-align: center; }
  .dm-hero__slides { position: absolute; inset: 0; z-index: -2; }
  .dm-hero__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 1.1s var(--ease); }
  .dm-hero__bg.is-on { opacity: 1; }
  .dm-hero::before { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--v-overlay-slide); }
  .dm-hero__copy { display: flex; flex-direction: column; align-items: center; }
  .dm-hero__h1 { color: var(--v-white); font-size: var(--fs-7xl); line-height: 1.08; max-width: 18ch; margin-bottom: var(--space-6); }
  .dm-hero__lead { color: var(--v-mist-100); font-size: var(--fs-lg); max-width: 58ch; margin-bottom: var(--space-8); }
  .dm-hero__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-3); }
  .dm-hero__copy :global(.dm-hero__ti) { margin-top: var(--space-5); }
  .dm-hero__arrow { position: absolute; top: 50%; z-index: 1; display: grid; place-items: center; width: var(--space-16); height: var(--space-16); padding: 0; border: 0; border-radius: var(--radius-full); background: var(--v-glass-light); color: var(--v-white); backdrop-filter: blur(4px); cursor: pointer; transform: translateY(-50%); transition: background-color 0.2s var(--ease); }
  .dm-hero__arrow:hover { background: var(--v-chrome); color: var(--v-ink-900); }
  .dm-hero__arrow--prev { left: var(--space-16); }
  .dm-hero__arrow--next { right: var(--space-16); }
  .dm-hero__dots { position: absolute; left: 50%; bottom: var(--space-8); transform: translateX(-50%); display: flex; gap: var(--space-2); }
