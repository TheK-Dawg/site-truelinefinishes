---
/** THANK YOU (utility: noindex, no sticky bar, no form). The plan's words exactly: no response time, no "our team". Formlane redirects here after a send. */
import Base from '../layouts/Base.astro';
import { business } from '../data/site';
---
<Base title="Thank You | TrueLine Finishes" description="Thanks for your enquiry to TrueLine Finishes. Brandon will be in touch. Want to talk now? Call Brandon on 07949 484274." page="thank-you" utility>
  <section class="ty on-dark section-hero" data-section="hero">
    <div class="container ty__inner">
      <h1 class="ty__h1">Thanks: we've got your enquiry and Brandon will be in touch.</h1>
      <p class="ty__p">Want to talk now? Call Brandon on <a href={business.phoneHref} data-cta="thanks-call">{business.phone}</a>.</p>
      <div class="btn-row"><a href="/" class="btn btn-primary" data-cta="thanks-home"><span class="btn__t">Back to the home page</span></a></div>
    </div>
  </section>
</Base>
<style>
  .ty { background: var(--bg-inverse); color: var(--text-inverse-muted); padding: calc(var(--header-h) + var(--space-24)) 0 var(--space-24); min-height: 70vh; }
  .ty__inner { max-width: 60em; }
  .ty__h1 { color: var(--text-inverse); font-size: var(--fs-5xl); margin-bottom: var(--space-5); }
  .ty__p { font-size: var(--fs-xl); margin-bottom: var(--space-8); }
  .ty__p a { color: var(--text-inverse); font-weight: var(--fw-semibold); }
  @media (max-width: 640px) { .ty__h1 { font-size: var(--fs-3xl); } }
</style>
