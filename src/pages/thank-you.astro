---
/** THANK YOU (utility: noindex, no sticky bar, no form). The plan's words exactly: no response time, no "our team". Formlane redirects here after a send. The slimline sits under the paragraph, above the button (round 3), and the main Trustindex reviews section under the hero, as on every page (operator, 6 Nov 2026). */
import Base from '../layouts/Base.astro';
import Reviews from '../components/Reviews.astro';
import TrustindexSlot from '../components/TrustindexSlot.astro';
import { business } from '../data/site';
---
<Base title="Thank You | TrueLine Finishes" description="Thanks for your enquiry to TrueLine Finishes. We will be in touch about your painting and decorating. Want to talk now? Call 07949 484274." page="thank-you" utility>
  <section class="ty on-dark section-hero" data-section="hero">
    <div class="container ty__inner">
      <h1 class="ty__h1">Thanks. Your enquiry is in and TrueLine Finishes will be in touch.</h1>
      <p class="ty__p">Want to talk now? Call <a href={business.phoneHref} data-cta="thanks-call">{business.phone}</a>.</p>
      <TrustindexSlot role="slimline" place="slim-hero" ground="dark" align="center" class="ty__ti" />
      <div class="btn-row"><a href="/" class="btn btn-primary btn--desc" data-cta="thanks-home"><span class="btn__t">Back to the home page</span></a></div>
    </div>
  </section>
  <Reviews />
</Base>
<style>
  /* Home 3 hero treatment (centred on the navy ground), as every hero on the site. */
  .ty { background: var(--bg-inverse); color: var(--text-inverse-muted); padding: calc(var(--header-h) + var(--space-24)) 0 var(--space-24); min-height: 70vh; text-align: center; }
  .ty__inner { display: flex; flex-direction: column; align-items: center; }
  .ty__h1 { max-width: 22ch; }
  .ty :global(.ty__ti) { width: 100%; }
  .ty .btn-row { justify-content: center; }
  .ty__h1 { color: var(--text-inverse); font-size: var(--fs-5xl); margin-bottom: var(--space-5); }
  .ty__p { font-size: var(--fs-xl); margin-bottom: var(--space-4); }
  .ty :global(.ty__ti) { margin-bottom: var(--space-6); }
  .ty__p a { color: var(--text-inverse); font-weight: var(--fw-semibold); }
  @media (max-width: 640px) { .ty__h1 { font-size: var(--fs-3xl); } }
</style>
