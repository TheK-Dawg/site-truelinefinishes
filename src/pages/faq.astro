---
/**
 * FAQ PAGE (Buildings for Life faq page, operator overhaul 5 Nov 2026): grouped accordions from
 * src/data/faq.ts (the plan's Q&A only: the home questions, then each hub's), FAQPage schema,
 * the quote form last.
 */
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Reviews from '../components/Reviews.astro';
import Faq from '../components/Faq.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { business, image } from '../data/site';
import { siteFaqs } from '../data/faq';
import { stripTags } from '../lib/links';
const pageUrl = `${business.url}/faq/`;
const all = siteFaqs.flatMap((g) => g.items);
const schema = [
  { '@type': 'FAQPage', '@id': `${pageUrl}#faq`, mainEntity: all.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: stripTags(f.a) } })) },
  { '@type': 'BreadcrumbList', '@id': `${pageUrl}#crumbs`, itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${business.url}/` }, { '@type': 'ListItem', position: 2, name: 'FAQ', item: pageUrl }] },
];
---
<Base title="Painting and Decorating FAQ: Quotations and Preparation | TrueLine Finishes" description="Answers on painting and decorating from TrueLine Finishes: who does the work, the free quotation, preparation, interior and exterior painting and wallpapering." page="faq" schema={schema}>
  <PageHero h1="Painting and Decorating Questions, Answered" lead="Who does the work, the free quotation, the preparation, and each kind of job Brandon takes on." image={image('stairs-prepared-0061')} />
  <Reviews />
  {siteFaqs.map((g, i) => <Faq items={g.items} heading={g.group} id={`faq-${i + 1}`} call={i === 0} />)}
  <QuoteForm />
</Base>
